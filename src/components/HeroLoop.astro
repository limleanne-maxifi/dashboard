---
---

<div class="hl-root">

  <!-- ── TOP BLOCK: amber banner + tabs (row-1 of subgrid, matches .did-you-know height) ── -->
  <div class="hl-top">

  <!-- ── AMBER SUB-INDUSTRY BANNER ──────────────── -->
  <div class="subind-header">
    <span class="subind-header-prefix">Top AI searches in:</span>
    <span class="subind-header-name" id="subind-current-name">AVIATION &amp; AEROSPACE</span>
  </div>

  <!-- ── SUB-INDUSTRY TABS ───────────────────────── -->
  <div class="subind-tabs" role="tablist" aria-label="Select sub-industry">
    <button class="subind-tab active" data-sub="commercial" role="tab" aria-selected="true">
      <span class="subind-tab-label">Commercial Aviation</span>
    </button>
    <button class="subind-tab" data-sub="manufacturing" role="tab" aria-selected="false">
      <span class="subind-tab-label">Aerospace Manufacturing</span>
    </button>
    <button class="subind-tab" data-sub="space" role="tab" aria-selected="false">
      <span class="subind-tab-label">Space Exploration</span>
    </button>
    <button class="subind-tab" data-sub="mro" role="tab" aria-selected="false">
      <span class="subind-tab-label">MRO</span>
    </button>
  </div>

  </div><!-- /hl-top -->

  <!-- ── LOOP CONTAINER ─────────────────────────── -->
  <div class="loop-container" id="hl-container">

    <!-- ── PERMANENT INSIGHT HEADER ──────────────── -->
    <div class="loop-insight">
      Aviation &amp; aerospace buyers screen vendors in AI first. Find out if yours is being cited.
    </div>

    <!-- ── STATES WRAPPER ────────────────────────── -->
    <div class="loop-states">

    <!-- ── STATE 1: Engine search mock ── -->
    <div class="state active" data-state="1">
      <div class="state-header">
        <div>
          <span class="state-tag"><span class="alert-dot"></span>Live AI query · 5 engines</span>
        </div>
        <span class="state-num">01 / 03</span>
      </div>
      <div class="state-body">
        <!-- 5 engine pills -->
        <div class="ec-pills" role="tablist">
          <button class="ec-pill active" data-eidx="0">ChatGPT</button>
          <button class="ec-pill" data-eidx="1">Perplexity</button>
          <button class="ec-pill" data-eidx="2">Gemini</button>
          <button class="ec-pill" data-eidx="3">Copilot</button>
          <button class="ec-pill" data-eidx="4">Claude</button>
        </div>
        <!-- Engine window (JS updates content + CSS class) -->
        <div class="ec-window engine-chatgpt" id="ec-window-main">
          <div class="ec-chrome">
            <div class="ec-chrome-dots"><span></span><span></span><span></span></div>
            <span class="ec-chrome-url" id="ec-chrome-url">chatgpt.com</span>
            <span class="ec-chrome-live"><span class="alert-dot" style="width:5px;height:5px;margin-right:3px;"></span>LIVE</span>
          </div>
          <div class="ec-greeting" id="ec-greeting">What&apos;s on your mind today?</div>
          <div class="ec-input-row">
            <span class="ec-input-icon" id="ec-input-icon">+</span>
            <span class="ec-query-text" id="ec-query-text"></span><span class="typing-cursor" aria-hidden="true"></span>
            <span class="ec-input-btn" id="ec-input-btn" aria-hidden="true">●</span>
          </div>
          <div class="ec-thinking" id="ec-thinking" aria-live="polite">
            <span class="ec-think-label">Thinking</span>
            <span class="ec-think-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          </div>
          <div class="ec-answer-area" id="ec-answer-area">
            <span class="ec-answer-label" id="ec-answer-label">ChatGPT</span>
            <p class="ec-answer-text" id="ec-answer-text"></p>
          </div>
        </div>
        <!-- Conversion trigger -->
        <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="ec-conversion-trigger">
          <span class="ec-ct-question">Are AI engines citing you?</span>
          <span class="ec-ct-cta">Check now →</span>
        </a>
      </div>
    </div>

    </div><!-- /loop-states -->

  </div><!-- /loop-container -->

</div><!-- /hl-root -->

<script>
(function () {
  const ENGINES = [
    { id: 'chatgpt',    name: 'ChatGPT',    site: 'chatgpt.com',           greeting: "What's on your mind today?",  hasGreeting: true  },
    { id: 'perplexity', name: 'Perplexity', site: 'perplexity.ai',         greeting: '',                            hasGreeting: false },
    { id: 'gemini',     name: 'Gemini',     site: 'gemini.google.com',     greeting: 'Hello. How can I help you?',  hasGreeting: true  },
    { id: 'copilot',    name: 'Copilot',    site: 'copilot.microsoft.com', greeting: '',                            hasGreeting: false },
    { id: 'claude',     name: 'Claude',     site: 'claude.ai',             greeting: "Hi there. I'm Claude.",       hasGreeting: true  },
  ];

  const EC_QUERIES: Record<string, string> = {
    commercial:    'What are the best revenue management platforms for low-cost airlines?',
    manufacturing: 'Leading aerospace composites suppliers for Airbus and Boeing programmes?',
    space:         'Best commercial small satellite launch providers for LEO missions in 2024?',
    mro:           'Top aircraft heavy maintenance MRO facilities in Europe for narrowbody jets?',
  };

  const EC_RESPONSES: Record<string, string[]> = {
    commercial: [
      "Amadeus Revenue Management (ARM) and PROS Holdings lead for LCCs. Sabre SynXis and IBS Software are strong alternatives, especially for hybrid carriers like IndiGo and EasyJet.",
      "PROS Revenue Management and Amadeus dominate the LCC space. IBS Software's iFly RMS is gaining at regional carriers. Farelogix is preferred for NDC-native implementations.",
      "For low-cost carriers, PROS Holdings and Amadeus are the top choices. Sabre and Radixx are common at ultra-low-cost carriers like Spirit and Frontier.",
      "Amadeus Revenue Management and PROS are the most recommended for LCCs. IBS Software and Sabre SRM are used by Ryanair, EasyJet and Wizz Air for dynamic pricing.",
      "PROS Holdings and Amadeus ARM are the leading platforms for low-cost carriers. Sabre's Revenue Optimizer and IBS iFly are strong alternatives for mid-size LCCs.",
    ],
    manufacturing: [
      "Hexcel and Toray Advanced Composites dominate aerospace composites for A350 and 787 programmes. Solvay and Cytec supply carbon fibre prepregs for both OEMs.",
      "Toray Industries, Hexcel, and Solvay are the primary composites suppliers for Boeing 787 and Airbus A350. Spirit AeroSystems and Safran are key tier-1 aerostructures integrators.",
      "Hexcel, Toray, and Solvay lead aerospace composites supply for Airbus and Boeing. Teijin and Mitsubishi Chemical are growing their share in carbon fibre supply chains.",
      "Hexcel and Toray are the dominant composites suppliers. Solvay provides advanced materials for A350 fuselage panels. GKN Aerospace and Spirit AeroSystems are major structures integrators.",
      "Hexcel and Toray Advanced Composites supply the majority of carbon fibre for Airbus A350 and Boeing 787. Solvay, Cytec, and Teijin fill secondary supply roles across both programmes.",
    ],
    space: [
      "SpaceX Falcon 9 rideshare dominates LEO small satellite launches. Rocket Lab Electron is the top dedicated small launcher. Exolaunch and D-Orbit provide satellite deployment services.",
      "SpaceX leads with Falcon 9 rideshare at unmatched price points. Rocket Lab is the preferred dedicated small-sat launcher. ISRO's PSLV and Arianespace's Vega-C are competitive for European missions.",
      "SpaceX Transporter missions and Rocket Lab Electron lead small satellite LEO launches. Arianespace's Vega-C and Rocket Lab have the strongest European and Asia-Pacific presence.",
      "SpaceX Falcon 9 rideshare via Transporter missions is the most cost-effective for LEO smallsats. Rocket Lab, Exolaunch, and ISRO are top alternatives for dedicated and rideshare launches.",
      "SpaceX dominates small satellite LEO launches through its Transporter rideshare programme. Rocket Lab Electron is the leading dedicated small launcher. D-Orbit and Exolaunch offer in-orbit deployment services.",
    ],
    mro: [
      "Lufthansa Technik and Air France Industries KLM E&M (AFI KLM) are the largest European MRO providers. ST Engineering and Iberia Maintenance are strong for A320/737 heavy checks.",
      "Lufthansa Technik leads European narrowbody MRO, followed by AFI KLM E&M and SR Technics. TAP Air Portugal MRO is highly competitive on A320 family heavy maintenance costs.",
      "Lufthansa Technik and AFI KLM E&M dominate European heavy maintenance. Iberia Maintenance, SR Technics, and HAECO are major competitors for A320 and 737 C and D checks.",
      "Lufthansa Technik is Europe's largest MRO. AFI KLM E&M, SR Technics, and Iberia Maintenance are the top competitors for narrowbody heavy checks. Turkish Technic is growing rapidly.",
      "Lufthansa Technik and AFI KLM Engineering & Maintenance lead European heavy MRO. SR Technics and Iberia Maintenance are top choices for A320 family C-checks at competitive price points.",
    ],
  };

  // ── State ──────────────────────────────────────
  let currentSub = 'commercial';
  let currentEngine = 0;
  let engineTimer: ReturnType<typeof setInterval> | null = null;
  let engineTypingTimer: ReturnType<typeof setInterval> | null = null;
  let thinkingTimeout: ReturnType<typeof setTimeout> | null = null;
  let answerTimeout: ReturnType<typeof setTimeout> | null = null;

  const container = document.getElementById('hl-container');

  // ── Engine functions ────────────────────────────

  function setEngine(eidx: number, skipAnimation: boolean) {
    currentEngine = eidx;
    const eng = ENGINES[eidx];

    // Pills
    document.querySelectorAll('.ec-pill').forEach(function(p, i) {
      p.classList.toggle('active', i === eidx);
    });

    // Window class
    const win = document.getElementById('ec-window-main');
    if (win) {
      win.className = 'ec-window engine-' + eng.id;
    }

    // Chrome URL
    const urlEl = document.getElementById('ec-chrome-url');
    if (urlEl) urlEl.textContent = eng.site;

    // Answer label
    const labelEl = document.getElementById('ec-answer-label');
    if (labelEl) labelEl.textContent = eng.name;

    // Greeting visibility
    const greetingEl = document.getElementById('ec-greeting') as HTMLElement | null;
    if (greetingEl) {
      greetingEl.textContent = eng.greeting;
      greetingEl.style.display = eng.hasGreeting ? 'block' : 'none';
    }

    // Reset animation state
    const queryEl    = document.getElementById('ec-query-text');
    const thinkingEl = document.getElementById('ec-thinking');
    const answerArea = document.getElementById('ec-answer-area');
    const answerText = document.getElementById('ec-answer-text');

    if (!queryEl || !thinkingEl || !answerArea || !answerText) return;

    if (engineTypingTimer) { clearInterval(engineTypingTimer); engineTypingTimer = null; }
    if (thinkingTimeout)   { clearTimeout(thinkingTimeout);   thinkingTimeout = null; }
    if (answerTimeout)     { clearTimeout(answerTimeout);     answerTimeout = null; }

    queryEl.textContent = '';
    thinkingEl.classList.remove('is-thinking');
    answerArea.classList.remove('is-visible');
    answerText.textContent = '';

    if (skipAnimation) {
      queryEl.textContent = EC_QUERIES[currentSub];
      answerText.textContent = EC_RESPONSES[currentSub][eidx];
      answerArea.classList.add('is-visible');
      return;
    }

    // Type query char by char
    const query = EC_QUERIES[currentSub];
    let charIdx = 0;
    engineTypingTimer = setInterval(function() {
      if (charIdx < query.length) {
        queryEl.textContent = query.slice(0, ++charIdx);
      } else {
        if (engineTypingTimer) { clearInterval(engineTypingTimer); engineTypingTimer = null; }
        thinkingTimeout = setTimeout(function() {
          thinkingTimeout = null;
          thinkingEl.classList.add('is-thinking');
          answerTimeout = setTimeout(function() {
            answerTimeout = null;
            thinkingEl.classList.remove('is-thinking');
            answerText.textContent = EC_RESPONSES[currentSub][eidx];
            answerArea.classList.add('is-visible');
          }, 900);
        }, 200);
      }
    }, 45);
  }

  function startEngineLoop() {
    if (engineTimer) clearInterval(engineTimer);
    engineTimer = setInterval(function() {
      currentEngine = (currentEngine + 1) % ENGINES.length;
      setEngine(currentEngine, false);
    }, 5500);
  }

  function stopEngineLoop() {
    if (engineTimer)      { clearInterval(engineTimer);      engineTimer = null; }
    if (engineTypingTimer){ clearInterval(engineTypingTimer); engineTypingTimer = null; }
    if (thinkingTimeout)  { clearTimeout(thinkingTimeout);   thinkingTimeout = null; }
    if (answerTimeout)    { clearTimeout(answerTimeout);     answerTimeout = null; }
  }

  // ── Sub-industry tab clicks ────────────────────
  document.querySelectorAll<HTMLButtonElement>('.subind-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      const sub = tab.dataset.sub || 'commercial';
      currentSub = sub;

      // Update active tab
      document.querySelectorAll<HTMLButtonElement>('.subind-tab').forEach(function(t) {
        const isActive = t.dataset.sub === sub;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', String(isActive));
      });

      // Restart engine carousel with new query
      stopEngineLoop();
      setEngine(0, false);
      startEngineLoop();
    });
  });

  // ── Engine pill clicks ────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.ec-pill').forEach(function(pill) {
    pill.addEventListener('click', function() {
      stopEngineLoop();
      setEngine(parseInt(pill.dataset.eidx || '0'), false);
      startEngineLoop();
    });
  });

  // ── Hover pause ───────────────────────────────
  if (container) {
    container.addEventListener('mouseenter', function() {
      stopEngineLoop();
    });
    container.addEventListener('mouseleave', function() {
      setEngine(currentEngine, false);
      startEngineLoop();
    });
  }

  // ── Boot ──────────────────────────────────────
  setEngine(0, false);
  startEngineLoop();
})();
</script>

<style>
  /* Subgrid: .hl-top (row 1) and .loop-container (row 2) participate in
     the parent .hero-row grid tracks, ensuring .did-you-know always
     matches .hl-top height without any JS or magic numbers. */
  .hl-root {
    display: grid;
    grid-row: 1 / 3;
    grid-template-rows: subgrid;
    align-content: start;
  }

  /* ── Sub-industry amber banner ──────────────── */
  .subind-header {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 8px 8px 0 0;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .subind-header-prefix { opacity: 0.8; }
  .subind-header-name { font-weight: 600; }

  /* ── Sub-industry tabs ──────────────────────── */
  .subind-tabs {
    display: flex;
    background: var(--cream);
    border: 0.5px solid var(--line);
    border-top: none;
    padding: 4px;
    gap: 2px;
  }

  .subind-tab {
    flex: 1;
    background: transparent;
    border: none;
    padding: 9px 8px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
    font-family: var(--font-sans);
    text-align: center;
  }

  .subind-tab:hover { color: var(--navy); background: rgba(4,44,83,0.04); }

  .subind-tab.active {
    background: var(--navy);
    color: var(--amber-light);
  }

  .subind-tab-label { font-size: 10px; }

  /* ── Loop container ─────────────────────────── */
  .loop-container {
    display: flex;
    flex-direction: column;
    min-height: 490px;
    align-self: stretch;
    box-sizing: border-box;
  }

  .loop-insight {
    flex-shrink: 0;
    padding: 10px 16px 11px;
    font-size: 13px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.4;
    font-family: var(--font-sans);
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
  }

  /* States wrapper — fills remaining height, anchors absolute .state cards */
  .loop-states {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* ── State card ─────────────────────────────── */
  .state {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(239, 159, 39, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.97);
    transition: opacity 0.6s ease, transform 0.6s ease;
    display: flex;
    flex-direction: column;
  }

  .state.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* State 1: navy engine-test card */
  .state[data-state="1"] { background: var(--navy-deep); }
  .state[data-state="1"] .state-header {
    background: var(--navy-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .state[data-state="1"] .state-num    { color: var(--blue-mid); }
  .state[data-state="1"] .s1-cta { border-top-color: rgba(255, 255, 255, 0.08); }
  .state[data-state="1"] .s1-cta-text { color: var(--blue-mid); }

  /* ── State header ───────────────────────────── */
  .state-header {
    padding: 13px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(4, 44, 83, 0.08);
    background: linear-gradient(180deg, #FCFAF6 0%, #F8F4ED 100%);
  }

  .state-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--amber);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .live-dot,
  .alert-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    animation: hl-pulse 1.8s infinite;
  }

  .live-dot  { background: #1D9E75; }
  .alert-dot { background: #DC2626; }

  @keyframes hl-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.2); }
  }

  .state-num {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  /* ── State body shared ──────────────────────── */
  .state-body {
    padding: 22px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ── Engine pills ───────────────────────────── */
  .ec-pills {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .ec-pill {
    padding: 4px 9px;
    font-size: 12px;
    font-weight: 500;
    font-family: var(--font-sans);
    border-radius: 3px;
    border: 0.5px solid rgba(255,255,255,0.15);
    background: transparent;
    color: var(--blue-mid);
    cursor: pointer;
    transition: all 0.15s ease;
    letter-spacing: 0.03em;
  }

  .ec-pill:hover { border-color: rgba(255,255,255,0.3); color: #fff; }
  .ec-pill.active { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.25); }

  /* ── Engine window base ─────────────────────── */
  .ec-window {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
    border: 0.5px solid rgba(255,255,255,0.08);
    transition: background 0.3s ease;
  }

  .ec-chrome {
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
  }

  .ec-chrome-dots { display: flex; gap: 4px; }

  .ec-chrome-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: block;
  }

  .ec-chrome-dots span:nth-child(1) { background: #FF5F57; }
  .ec-chrome-dots span:nth-child(2) { background: #FFBD2E; }
  .ec-chrome-dots span:nth-child(3) { background: #28C840; }

  .ec-chrome-url {
    flex: 1;
    text-align: center;
    font-size: 11px;
    color: rgba(255,255,255,0.85);
    font-family: var(--font-mono);
  }

  .ec-chrome-live {
    font-size: 9px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
  }

  .ec-greeting {
    padding: 14px 14px 6px;
    font-size: 15px;
    font-weight: 400;
    text-align: center;
    color: rgba(255,255,255,0.75);
    font-family: var(--font-sans);
    line-height: 1.3;
  }

  .ec-input-row {
    padding: 8px 12px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .ec-input-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.5);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 1;
  }

  .ec-query-text {
    flex: 1;
    font-size: 12px;
    color: rgba(255,255,255,0.85);
    font-family: var(--font-sans);
    min-height: 18px;
  }

  .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 14px;
    background: rgba(255,255,255,0.7);
    animation: hl-blink 0.7s infinite;
    flex-shrink: 0;
    vertical-align: middle;
  }

  @keyframes hl-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .ec-thinking {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    font-family: var(--font-sans);
    font-style: italic;
    opacity: 0;
    transition: opacity 0.25s ease;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .ec-thinking.is-thinking { opacity: 1; }

  .ec-think-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .ec-think-dots span {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    animation: think-pulse 1.2s ease-in-out infinite;
  }

  .ec-think-dots span:nth-child(2) { animation-delay: 0.2s; }
  .ec-think-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes think-pulse {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.7); }
    40%           { opacity: 1;   transform: scale(1);   }
  }

  .ec-input-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: rgba(255,255,255,0.4);
    flex-shrink: 0;
  }

  .ec-answer-area {
    padding: 12px 14px 14px;
    border-top: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.05);
    border-radius: 0 0 8px 8px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ec-answer-area.is-visible { opacity: 1; }

  .ec-answer-label {
    font-size: 9px;
