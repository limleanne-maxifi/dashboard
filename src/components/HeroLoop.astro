---
---

<div class="hl-root">
  <div class="hl-duo">

    <!-- LEFT: empty intake form (industry-specific placeholders) -->
    <div class="hl-form-card">
      <div class="hl-card-header hl-form-header">
        <span class="hl-header-tag">AI Visibility Snapshot</span>
        <span class="hl-header-sub" id="hl-form-industry">Commercial Aviation</span>
      </div>
      <div class="hl-card-body">
        <div class="hl-field">
          <label class="hl-label">Your website</label>
          <div class="hl-input" id="hl-field-website" aria-hidden="true"></div>
        </div>
        <div class="hl-field">
          <label class="hl-label" id="hl-spec-label">Your specialism</label>
          <div class="hl-input" id="hl-field-spec" aria-hidden="true"></div>
        </div>
        <div class="hl-field">
          <label class="hl-label">A buyer question you should win</label>
          <div class="hl-input hl-input--query" id="hl-field-query" aria-hidden="true"></div>
        </div>
        <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="hl-submit">
          Get my AI Visibility Snapshot →
        </a>
      </div>
    </div>

    <!-- RIGHT: matching sample report (clickable) -->
    <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="hl-report-card" aria-label="See a sample AI Visibility Snapshot report">
      <div class="hl-card-header hl-report-header">
        <div class="hl-report-header-left">
          <span class="hl-live-dot"></span>
          <span class="hl-header-tag">Sample Report</span>
        </div>
        <span class="hl-header-sub" id="hl-report-industry">Commercial Aviation</span>
      </div>
      <div class="hl-card-body">
        <p class="hl-client" id="hl-client">EUROPEAN LCC GROUP · Q2 2026</p>
        <p class="hl-report-title" id="hl-report-title"></p>
        <div class="hl-stats" id="hl-stats"></div>
        <div class="hl-fixes-hdr">
          <span class="hl-fixes-label">Priority Fixes</span>
          <span class="hl-fixes-badge">RANKED BY IMPACT</span>
        </div>
        <div id="hl-fixes"></div>
        <div class="hl-report-cta">View full report →</div>
      </div>
    </a>

  </div>
</div>

<script is:inline>
(function () {
  const INDUSTRIES = [
    {
      id: 'commercial',
      name: 'Commercial Aviation',
      specLabel: 'Your aviation specialism',
      fieldWebsite: 'youraviationbrand.com',
      fieldSpec: 'e.g. aircraft leasing, revenue mgmt',
      fieldQuery: 'Best LCC revenue management platform?',
      client: 'EUROPEAN LCC GROUP · Q2 2026',
      title: 'Citation share at <span class="num">17%</span>. 3 fixes to reach 42% by Q4.',
      stats: [
        { num: '14', up: '↑45%', label: 'AI Citations' },
        { num: '1/5', up: '', label: 'Engines' },
        { num: '3/10', up: '', label: 'Topics' },
      ],
      fixes: [
        { title: 'LCC revenue management capability page', impact: '+21%', time: '2 wks' },
        { title: 'IATA & ARM entity schema + pricing FAQ', impact: '+14%', time: '1 wk' },
        { title: 'EasyJet/Ryanair benchmark comparison', impact: '+7%', time: '3 days' },
      ],
    },
    {
      id: 'manufacturing',
      name: 'Aerospace Manufacturing',
      specLabel: 'Your manufacturing specialism',
      fieldWebsite: 'youraerocompany.com',
      fieldSpec: 'e.g. composites, aerostructures, MRO',
      fieldQuery: 'Leading composites supplier for A350?',
      client: 'TIER-1 AEROSTRUCTURES · Q2 2026',
      title: 'Citation share at <span class="num">23%</span>. 3 fixes to reach 51% by Q4.',
      stats: [
        { num: '21', up: '↑33%', label: 'AI Citations' },
        { num: '2/5', up: '', label: 'Engines' },
        { num: '5/14', up: '', label: 'Topics' },
      ],
      fixes: [
        { title: 'A350/787 composites capability page', impact: '+18%', time: '2 wks' },
        { title: 'AS9100/Nadcap certification schema', impact: '+12%', time: '1 wk' },
        { title: 'Supplier comparison vs Hexcel/Toray', impact: '+8%', time: '4 days' },
      ],
    },
    {
      id: 'space',
      name: 'Space Exploration',
      specLabel: 'Your space specialism',
      fieldWebsite: 'yourspacecompany.com',
      fieldSpec: 'e.g. launch services, smallsats, propulsion',
      fieldQuery: 'Best LEO small satellite launch provider?',
      client: 'EU SMALLSAT INTEGRATOR · Q2 2026',
      title: 'Citation share at <span class="num">14%</span>. 3 fixes to reach 38% by Q4.',
      stats: [
        { num: '9', up: '↑62%', label: 'AI Citations' },
        { num: '1/5', up: '', label: 'Engines' },
        { num: '2/8', up: '', label: 'Topics' },
      ],
      fixes: [
        { title: 'LEO rideshare deployment service page', impact: '+17%', time: '2 wks' },
        { title: 'ESA & EU Space Programme entity build', impact: '+11%', time: '1 wk' },
        { title: 'SpaceX Transporter vs alternatives FAQ', impact: '+9%', time: '3 days' },
      ],
    },
    {
      id: 'mro',
      name: 'MRO',
      specLabel: 'Your MRO specialism',
      fieldWebsite: 'yourmrocompany.com',
      fieldSpec: 'e.g. heavy maintenance, line, engine MRO',
      fieldQuery: 'Top narrowbody MRO in Europe?',
      client: 'NARROWBODY MRO · Q2 2026',
      title: 'Citation share at <span class="num">19%</span>. 3 fixes to reach 46% by Q4.',
      stats: [
        { num: '16', up: '↑41%', label: 'AI Citations' },
        { num: '2/5', up: '', label: 'Engines' },
        { num: '4/11', up: '', label: 'Topics' },
      ],
      fixes: [
        { title: 'A320/737 C-check capability page', impact: '+20%', time: '2 wks' },
        { title: 'EASA Part 145 + facility schema', impact: '+13%', time: '1 wk' },
        { title: 'CFM56/LEAP engine MRO FAQ pages', impact: '+9%', time: '3 days' },
      ],
    },
  ];

  // Pick one industry at random on page load
  var ind = INDUSTRIES[Math.floor(Math.random() * INDUSTRIES.length)];

  function setText(id, html) {
    var el = document.getElementById(id);
    if (el) el.innerHTML = html;
  }

  // Populate form
  setText('hl-form-industry', ind.name);
  var specLabel = document.getElementById('hl-spec-label');
  if (specLabel) specLabel.textContent = ind.specLabel;
  setText('hl-field-website', ind.fieldWebsite);
  setText('hl-field-spec', ind.fieldSpec);
  setText('hl-field-query', ind.fieldQuery);

  // Populate report
  setText('hl-report-industry', ind.name);
  setText('hl-client', ind.client);
  setText('hl-report-title', ind.title);

  var statsHtml = ind.stats.map(function(s) {
    return '<div class="hl-stat"><div class="hl-stat-num">' + s.num + (s.up ? '<span class="hl-up">' + s.up + '</span>' : '') + '</div><div class="hl-stat-label">' + s.label + '</div></div>';
  }).join('');
  setText('hl-stats', statsHtml);

  var fixesHtml = ind.fixes.map(function(f, i) {
    return '<div class="hl-fix"><span class="hl-fix-num">' + (i+1) + '</span><div class="hl-fix-body"><div class="hl-fix-title">' + f.title + '</div><div class="hl-fix-impact"><span class="hl-lift">' + f.impact + '</span> · ' + f.time + '</div></div></div>';
  }).join('');
  setText('hl-fixes', fixesHtml);
})();
</script>

<style>
  .hl-root { width: 100%; }

  .hl-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }

  /* ── Shared card shell ──────────────────────── */
  .hl-form-card,
  .hl-report-card {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 40px -16px rgba(0,0,0,0.45), 0 0 0 0.5px rgba(239,159,39,0.15);
  }

  .hl-report-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hl-report-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 28px 48px -16px rgba(0,0,0,0.55), 0 0 0 1px rgba(239,159,39,0.3);
  }

  /* ── Card headers ───────────────────────────── */
  .hl-card-header {
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .hl-form-header {
    background: var(--amber);
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .hl-report-header {
    background: linear-gradient(180deg, #FCFAF6 0%, #F8F4ED 100%);
    border-bottom: 0.5px solid var(--line);
  }

  .hl-report-header-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hl-header-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .hl-form-header .hl-header-tag { color: var(--amber-light); opacity: 0.85; }
  .hl-form-header .hl-header-sub { color: #fff; font-size: 11px; font-weight: 500; font-family: var(--font-sans); }

  .hl-report-header .hl-header-tag { color: var(--amber); }
  .hl-report-header .hl-header-sub {
    font-size: 9px; font-weight: 500; font-family: var(--font-mono);
    color: var(--amber); background: var(--amber-light);
    padding: 2px 6px; border-radius: 3px; letter-spacing: 0.05em;
    text-transform: uppercase; white-space: nowrap;
  }

  .hl-live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--signal); display: inline-block; flex-shrink: 0;
    animation: hl-pulse 1.8s infinite;
  }

  @keyframes hl-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.2); }
  }

  /* ── Card bodies ────────────────────────────── */
  .hl-card-body {
    padding: 14px;
    background: #fff;
  }

  /* ── Form card internals ────────────────────── */
  .hl-form-card .hl-card-body { background: var(--navy-deep); }

  .hl-field { margin-bottom: 10px; }

  .hl-label {
    display: block;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-mid);
    margin-bottom: 4px;
    font-family: var(--font-mono);
  }

  .hl-input {
    width: 100%;
    background: rgba(255,255,255,0.05);
    border: 0.5px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 7px 10px;
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    font-family: var(--font-sans);
    min-height: 28px;
    box-sizing: border-box;
    font-style: italic;
  }

  .hl-input--query { min-height: 36px; }

  .hl-submit {
    display: block;
    width: 100%;
    background: var(--amber);
    color: var(--amber-light);
    text-align: center;
    padding: 9px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    margin-top: 12px;
    box-sizing: border-box;
    transition: background 0.2s ease;
    letter-spacing: 0.02em;
  }

  .hl-submit:hover { background: #854F0B; }

  /* ── Report card internals ──────────────────── */
  .hl-client {
    font-size: 9px;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 5px;
    font-family: var(--font-mono);
  }

  .hl-report-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 10px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .hl-report-title .num { color: var(--amber); font-family: var(--font-mono); }

  .hl-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
    margin-bottom: 10px;
  }

  .hl-stat {
    background: var(--cream);
    border-radius: 5px;
    padding: 7px 6px;
    text-align: center;
  }

  .hl-stat-num {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 3px;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .hl-up {
    font-size: 8px;
    color: var(--signal);
    font-weight: 500;
    margin-left: 1px;
    font-family: var(--font-mono);
  }

  .hl-stat-label {
    font-size: 8px;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  .hl-fixes-hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .hl-fixes-label {
    font-size: 9px;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  .hl-fixes-badge {
    font-size: 8px;
    background: var(--amber-light);
    color: var(--amber);
    padding: 2px 5px;
    border-radius: 3px;
    font-weight: 500;
    letter-spacing: 0.04em;
    font-family: var(--font-mono);
  }

  .hl-fix {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    padding: 5px 0;
    border-bottom: 0.5px solid var(--line);
  }

  .hl-fix:last-child { border: none; }

  .hl-fix-num {
    background: var(--navy);
    color: #fff;
    width: 16px; height: 16px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 8px; font-weight: 500;
    flex-shrink: 0; margin-top: 1px;
    font-family: var(--font-mono);
  }

  .hl-fix-title {
    font-size: 10px;
    color: var(--navy);
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 1px;
  }

  .hl-fix-impact {
    font-size: 9px;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .hl-lift {
    color: var(--signal);
    font-weight: 500;
  }

  .hl-report-cta {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 0.5px solid var(--line);
    font-size: 10px;
    color: var(--amber);
    font-weight: 500;
    text-align: right;
    letter-spacing: 0.02em;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 640px) {
    .hl-duo {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hl-live-dot { animation-duration: 0.01ms; }
    .hl-report-card { transition-duration: 0.01ms; }
    .hl-submit { transition-duration: 0.01ms; }
  }
</style>
