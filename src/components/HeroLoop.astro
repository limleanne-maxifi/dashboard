    tech: [
      'B2B SaaS procurement now starts in ChatGPT. Your category is no exception.',
      'This is the Snapshot every B2B tech and SaaS brand receives.',
      'Run yours — built specifically for B2B tech and SaaS positioning.',
    ],
    advisory: [
      'Expert buyers screen advisors in AI before pitch books arrive.',
      'This is the Snapshot every advisory firm and consultancy receives.',
      'Run yours — built specifically for M&A, legal, and expert advisory firms.',
    ],
  };

  // ── Engine carousel data ─────────────────────────
  const ENGINES = [
    { name: 'ChatGPT',    maker: 'OpenAI',        site: 'chatgpt.com',           accent: '#10A37F', bg: '#212121' },
    { name: 'Perplexity', maker: 'Perplexity AI',  site: 'perplexity.ai',         accent: '#20B2AA', bg: '#1C1C1C' },
    { name: 'Gemini',     maker: 'Google',         site: 'gemini.google.com',     accent: '#4285F4', bg: '#1E1F23' },
    { name: 'Copilot',    maker: 'Microsoft',      site: 'copilot.microsoft.com', accent: '#0EA5E9', bg: '#1A1A2E' },
    { name: 'Claude',     maker: 'Anthropic',      site: 'claude.ai',             accent: '#DA7756', bg: '#1F1B18' },
  ];

  const EC_QUERIES = {
    aviation:  'Best CNS/ATM technology provider for European airspace?',
    tech:      'Best B2B marketing automation for mid-market SaaS?',
    advisory:  'Best M&A advisor for healthcare deals in EMEA?',
  };

  const EC_RESPONSES = {
    aviation: [
      "Frequentis leads European CNS/ATM by market share. Indra Sistemas and Thales Group are strong alternatives for large-scale ANSP deployments.",
      "Indra Sistemas and Thales have the strongest European ATM track record. SITA and Saab Digital Air Traffic are preferred for remote tower.",
      "Thales Group and Frequentis are the most widely deployed CNS/ATM providers. Leonardo and Leidos are competitive for ANSP modernisation.",
      "For European ATM, Frequentis, Indra, and Thales are the leading vendors. SITA is notable for digital ATM; Saab for remote tower technology.",
      "Frequentis and Indra Sistemas are most cited for CNS/ATM in Europe. Thales and SITA feature prominently in ANSP procurement shortlists.",
    ],
    tech: [
      "HubSpot Marketing Hub is the top choice for mid-market SaaS. Marketo (Adobe) and Pardot (Salesforce) lead for enterprise-adjacent teams.",
      "HubSpot and Marketo dominate mid-market SaaS automation. ActiveCampaign is preferred for product-led growth; Customer.io for event-driven flows.",
      "Salesforce Pardot and HubSpot are the most recommended for B2B SaaS. Marketo is preferred when deep CRM integration is required.",
      "HubSpot, Marketo, and Pardot are the top three. Klaviyo is increasingly recommended for SaaS teams running lifecycle workflows.",
      "HubSpot Marketing Hub offers the best mid-market fit. For complex attribution, Marketo and Pardot are stronger within the Salesforce ecosystem.",
    ],
    advisory: [
      "Houlihan Lokey is the leading healthcare M&A advisor globally by deal volume. Lazard and Jefferies are strong for mid-market EMEA transactions.",
      "Houlihan Lokey leads by deal count in EMEA. Moelis & Co and Centerview Partners are preferred for large-cap pharma and MedTech transactions.",
      "Lazard and Jefferies rank highest for healthcare M&A in EMEA. Houlihan Lokey dominates mid-market; Centerview Partners for high-value strategic deals.",
      "Houlihan Lokey, Lazard, and Moelis & Co are the most-recommended advisors. Centerview Partners is favoured for high-value pharma mandates.",
      "Houlihan Lokey ranks first by deal count. Lazard and Jefferies are preferred for cross-border and strategic transactions involving EMEA buyers.",
    ],
  };

  let currentSector = 'aviation';
  let currentState = 1;
  let autoplayActive = true;
  let progressInterval = null;
  let progress = 0;
  let formEngaged = false;
  let resumeTimer = null;

  // Engine carousel state
  let currentEngine = 0;
  let engineTimer = null;
  let engineTypingTimer = null;

  const container = document.getElementById('hl-container');
  const statusEl  = document.getElementById('hl-status');
  const playIcon  = document.getElementById('hl-play-icon');
  const pauseIcon = document.getElementById('hl-pause-icon');
  const narrative = document.getElementById('hl-narrative');

  // ── Engine carousel functions ────────────────────

  function getActiveState1() {
    return document.querySelector('.state.active[data-state="1"]');
  }

  function setEngine(eidx, skipAnimation) {
    currentEngine = eidx;
    const el = getActiveState1();
    if (!el) return;

    const eng = ENGINES[eidx];
    const sector = currentSector;

    // Update pills
    el.querySelectorAll('.ec-pill').forEach(function(p, i) {
      p.classList.toggle('active', i === eidx);
    });

    // Update window background + CSS vars
    const win = el.querySelector('.ec-window');
    if (win) {
      win.style.setProperty('--ec-accent', eng.accent);
      win.style.setProperty('--ec-bg', eng.bg);
      win.style.background = eng.bg;
    }

    // Update chrome URL
    const urlEl = el.querySelector('.ec-chrome-url');
    if (urlEl) urlEl.textContent = eng.site;

    // Update answer label
    const labelEl = el.querySelector('.ec-answer-label');
    if (labelEl) {
      labelEl.textContent = eng.name;
      labelEl.style.color = eng.accent;
    }

    // Reset states
    const queryEl   = el.querySelector('.ec-query-text');
    const thinkingEl = el.querySelector('.ec-thinking');
    const answerArea = el.querySelector('.ec-answer-area');
    const answerText = el.querySelector('.ec-answer-text');

    if (!queryEl || !thinkingEl || !answerArea || !answerText) return;

    queryEl.textContent = '';
    thinkingEl.classList.remove('is-thinking');
    answerArea.classList.remove('is-visible');
    answerText.textContent = '';

    if (skipAnimation) {
      queryEl.textContent = EC_QUERIES[sector];
      thinkingEl.classList.add('is-thinking');
      answerArea.classList.add('is-visible');
      answerText.textContent = EC_RESPONSES[sector][eidx];
      return;
    }

    // Type query char by char
    const query = EC_QUERIES[sector];
    let charIdx = 0;
    if (engineTypingTimer) clearInterval(engineTypingTimer);
    engineTypingTimer = setInterval(function() {
      if (charIdx < query.length) {
        queryEl.textContent = query.slice(0, ++charIdx);
      } else {
        clearInterval(engineTypingTimer);
        engineTypingTimer = null;
        // Show thinking indicator after short pause
        setTimeout(function() {
          thinkingEl.classList.add('is-thinking');
          // Reveal answer
          setTimeout(function() {
            answerText.textContent = EC_RESPONSES[sector][eidx];
            answerArea.classList.add('is-visible');
          }, 900);
        }, 200);
      }
    }, 45);
  }

  function startEngineLoop() {
    if (engineTimer) clearInterval(engineTimer);
    engineTimer = setInterval(function() {
      if (currentState !== 1) return;
      currentEngine = (currentEngine + 1) % ENGINES.length;
      setEngine(currentEngine, false);
    }, 5500);
  }

  function stopEngineLoop() {
    if (engineTimer) { clearInterval(engineTimer); engineTimer = null; }
    if (engineTypingTimer) { clearInterval(engineTypingTimer); engineTypingTimer = null; }
  }

  // ── Main render ──────────────────────────────────

  function render() {
    document.querySelectorAll('.state').forEach(function(el) {
      const active = el.dataset.sector === currentSector && parseInt(el.dataset.state || '0') === currentState;
      el.classList.toggle('active', active);
    });
    document.querySelectorAll('.tab').forEach(function(el) {
      const active = el.dataset.sector === currentSector;
      el.classList.toggle('active', active);
      el.setAttribute('aria-selected', String(active));
    });
    document.querySelectorAll('.dot').forEach(function(el) {
      const t = parseInt(el.dataset.target || '0');
      el.classList.toggle('active', t === currentState);
      const fill = el.querySelector('.dot-fill');
      if (fill) fill.style.width = t < currentState ? '100%' : '0%';
    });
    narrative.textContent = NARRATIVES[currentSector][currentState - 1];
    progress = 0;

    // Engine carousel integration
    if (currentState === 1) {
      currentEngine = 0;
      setEngine(0, false);
      startEngineLoop();
    } else {
      stopEngineLoop();
    }
  }

  function advance() {
    if (currentState < 3) {
      currentState += 1;
    } else {
      const idx = SECTORS.indexOf(currentSector);
      currentSector = SECTORS[(idx + 1) % SECTORS.length];
      currentState = 1;
    }
    render();
  }

  function startAutoplay() {
    if (formEngaged) return;
    autoplayActive = true;
    statusEl.textContent = 'AUTO-ROTATING';
    playIcon.style.display  = 'inline-block';
    pauseIcon.style.display = 'none';
    if (progressInterval) clearInterval(progressInterval);

    progressInterval = setInterval(function() {
      if (!autoplayActive || formEngaged) return;
      progress += 100;
      const total = STATE_DURATIONS[currentState - 1];
      const pct = Math.min(100, (progress / total) * 100);
      const activeFill = document.querySelector('.dot.active .dot-fill');
      if (activeFill) activeFill.style.width = pct + '%';
      if (progress >= total) {
        progress = 0;
        advance();
      }
    }, 100);
  }

  function pauseAutoplay(reason) {
    autoplayActive = false;
    if (progressInterval) { clearInterval(progressInterval); progressInterval = null; }
    statusEl.textContent = reason;
    playIcon.style.display  = 'none';
    pauseIcon.style.display = 'inline-block';
  }

  function scheduleResume() {
    if (resumeTimer) clearTimeout(resumeTimer);
    resumeTimer = setTimeout(function() { if (!formEngaged) startAutoplay(); }, 8000);
  }

  // ── Tab clicks ────────────────────────────────
  document.querySelectorAll('.tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      currentSector = tab.dataset.sector || 'aviation';
      currentState = 1;
      render();
      pauseAutoplay('SECTOR SELECTED');
      scheduleResume();
    });
  });

  // ── Dot clicks ────────────────────────────────
  document.querySelectorAll('.dot').forEach(function(dot) {
    const activate = function() {
      currentState = parseInt(dot.dataset.target || '1');
      render();
      pauseAutoplay('YOU NAVIGATED');
      if (currentState !== 3) scheduleResume();
    };
    dot.addEventListener('click', activate);
    dot.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });

  // ── CTA buttons inside states 1 & 2 → jump to state 3 ──
  document.querySelectorAll('.s1-cta-btn, .s2-cta-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const parentState = btn.closest('[data-sector]');
      if (parentState) currentSector = parentState.dataset.sector || currentSector;
      currentState = 3;
      render();
      pauseAutoplay('YOU NAVIGATED');
    });
  });

  // ── Engine pill clicks ────────────────────────
  document.querySelectorAll('.ec-pill').forEach(function(pill) {
    pill.addEventListener('click', function() {
      stopEngineLoop();
      setEngine(parseInt(pill.dataset.eidx || '0'), false);
      startEngineLoop();
      pauseAutoplay('ENGINE SELECTED');
      scheduleResume();
    });
  });

  // ── Hover pause ───────────────────────────────
  container.addEventListener('mouseenter', function() {
    if (!formEngaged && autoplayActive) pauseAutoplay('HOVER PAUSE');
  });
  container.addEventListener('mouseleave', function() {
    if (!formEngaged) startAutoplay();
  });

  // ── Form engagement → permanent pause ─────────
  document.querySelectorAll('.snapshot-form').forEach(function(form) {
    form.addEventListener('focusin', function() {
      formEngaged = true;
      pauseAutoplay('FORM ACTIVE');
    });
    form.addEventListener('input', function() {
      formEngaged = true;
      pauseAutoplay('FORM ACTIVE');
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      formEngaged = true;
      pauseAutoplay('FORM ACTIVE');
      const sector = form.querySelector('input[name="sector"]')?.value || '';
      const wrapId = 'hl-form-wrap-' + sector;
      const wrap = document.getElementById(wrapId);
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(function([k, v]) { return [k, v.toString()]; }),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (wrap) wrap.innerHTML = '<p class="hl-thanks">Thanks — we\'ll analyse your AI visibility and send results within one business day.</p>';
      } catch {
        form.submit();
      }
    });
  });

  // ── Boot ──────────────────────────────────────
  render();
  startAutoplay();
})();
</script>

