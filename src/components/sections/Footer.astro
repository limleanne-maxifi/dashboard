---

<footer class="ft">
  <div class="ft-wrap">
    <div class="ft-cols">
      <div class="ft-brand">
        <div class="ft-brand__name">Maxifi Digital</div>
        <div class="ft-brand__tagline">The visibility layer for expert-led brands in the AI search era.</div>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Services</h5>
        <ul class="ft-col__list">
          <li><a href="/visibility-snapshot">Visibility Snapshot</a></li>
          <li><a href="/work">Build AI Authority</a></li>
          <li><a href="/conference-aeo">Conference AEO</a></li>
          <li><a href="/aeo-aviation-events">Aviation Event AEO</a></li>
          <li><a href="/aeo">AEO Strategy</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Resources</h5>
        <ul class="ft-col__list">
          <li><span class="ft-dim">Insights</span></li>
          <li><a href="/revenue-at-risk">Revenue at Risk</a></li>
          <li><a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">ASW Hub ↗</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Company</h5>
        <ul class="ft-col__list">
          <li><span class="ft-dim">Method</span></li>
          <li><a href="/about">About</a></li>
          <li><a href="mailto:hello@maxifidigital.com">Contact</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Legal</h5>
        <ul class="ft-col__list">
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="ft-bot">
      <span>© 2026 Maxifi Digital</span>
      <span>Singapore · Working globally</span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--navy-deep);
    color: var(--blue-text);
    padding: 56px 0 0;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .ft-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .ft-cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 0.5px solid rgba(255,255,255,0.07);
  }

  .ft-brand__name {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--blue-text);
    margin-bottom: 10px;
    letter-spacing: var(--track-tight);
  }

  .ft-brand__tagline {
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--blue-mid);
    max-width: var(--measure-tight);
  }

  .ft-col__h {
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--blue-mid);
    margin: 0 0 14px;
  }

  .ft-col__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .ft-col__list a {
    font-size: var(--text-body);
    color: var(--blue-soft);
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }

  .ft-col__list a:hover { color: var(--blue-text); }

  .ft-dim {
    font-size: var(--text-body);
    color: rgba(133,183,235,0.4);
    line-height: 1.4;
  }

  .ft-bot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--blue-mid);
    letter-spacing: var(--track-0);
  }

  @media (max-width: 900px) {
    .ft-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .ft-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .ft-cols { grid-template-columns: 1fr; }
    .ft-bot { flex-direction: column; gap: 6px; text-align: center; }
  }
</style>
