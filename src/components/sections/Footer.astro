---

<footer class="ft">
  <div class="ft-wrap">
    <div class="ft-cols">
      <div class="ft-brand">
        <div class="ft-brand__name">Maxifi Digital</div>
        <div class="ft-brand__tagline">The visibility layer for expert-led brands in the AI search era.</div>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Services</h5>
        <ul class="ft-col__list">
          <li><a href="/visibility-snapshot">Visibility Snapshot</a></li>
          <li><a href="/visibility-engine">Visibility Engine</a></li>
          <li><a href="/conference-aeo">Conference AEO</a></li>
          <li><a href="/aeo">AEO Strategy</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Resources</h5>
        <ul class="ft-col__list">
          <li><span class="ft-dim">Insights</span></li>
          <li><span class="ft-dim">The Cited Brief</span></li>
          <li><a href="/work">Work · Case studies</a></li>
          <li><a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">ASW Hub ↗</a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h5 class="ft-col__h">Company</h5>
        <ul class="ft-col__list">
          <li><span class="ft-dim">Method</span></li>
          <li><span class="ft-dim">About</span></li>
          <li><a href="/work">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="ft-bot">
      <span>© 2026 Maxifi Digital</span>
      <span>Singapore · London · Working globally</span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--navy-deep);
    color: var(--blue-text);
    padding: 56px 0 0;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .ft-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .ft-cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 0.5px solid rgba(255,255,255,0.07);
  }

  .ft-brand__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-text);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .ft-brand__tagline {
    font-size: 12px;
    line-height: 1.6;
    color: var(--blue-mid);
    max-width: 240px;
  }

  .ft-col__h {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-mid);
    margin: 0 0 14px;
  }

  .ft-col__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .ft-col__list a {
    font-size: 12px;
    color: var(--blue-soft);
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }

  .ft-col__list a:hover { color: var(--blue-text); }

  .ft-dim {
    font-size: 12px;
    color: rgba(133,183,235,0.4);
    line-height: 1.4;
  }

  .ft-bot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .ft-cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .ft-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .ft-cols { grid-template-columns: 1fr; }
    .ft-bot { flex-direction: column; gap: 6px; text-align: center; }
  }
</style>
