---
interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const links = [
  { label: 'AEO',      href: '/aeo' },
  { label: 'Engine',   href: '/visibility-engine' },
  { label: 'Work',     href: '/work' },
  { label: 'Insights', href: '/insights' },
];
---

<header class="site-nav">
  <a href="/" class="logo" aria-label="Maxifi Digital home">
    <img
      src="/logos/maxifi-logo-black.png"
      alt="Maxifi Digital"
      height="32"
      style="height:32px;width:auto;display:block;"
    />
  </a>

  <nav aria-label="Primary">
    <ul class="nav-links" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { 'nav-link--active': currentPage === link.href }]}
            aria-current={currentPage === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="nav-end">
    <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="nav-cta">Get my AI Visibility Snapshot</a>
    <button
      class="hamburger"
      id="nav-hamburger"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
  <nav aria-label="Mobile primary">
    <ul role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-mobile-link', { 'nav-link--active': currentPage === link.href }]}
            aria-current={currentPage === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="nav-cta" style="display:inline-block;margin-top:12px;">
      Get my AI Visibility Snapshot
    </a>
  </nav>
</div>

<script>
  const burger  = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const mobile  = document.getElementById('nav-mobile') as HTMLElement;

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
    mobile.setAttribute('aria-hidden', String(open));
    burger.classList.toggle('is-open', !open);
    mobile.classList.toggle('is-open', !open);
  });

  mobile?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open navigation');
      mobile.setAttribute('aria-hidden', 'true');
      burger.classList.remove('is-open');
      mobile.classList.remove('is-open');
    });
  });
</script>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 22px;
    background: var(--cream);
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .logo { text-decoration: none; display: flex; align-items: center; }

  .nav-links {
    display: flex;
    gap: 14px;
    list-style: none;
    font-size: 12px;
  }

  .nav-link {
    color: var(--navy);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover,
  .nav-link--active { opacity: 1; }

  .nav-link--active { font-weight: 500; }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-cta {
    background: var(--amber);
    color: var(--amber-light);
    padding: 7px 13px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .nav-cta:hover { background: #854F0B; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--navy);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hamburger.is-open span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  /* Mobile drawer */
  .nav-mobile {
    display: none;
    background: var(--cream);
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
    padding: 14px 22px 18px;
  }

  .nav-mobile.is-open { display: block; }

  .nav-mobile ul { list-style: none; }

  .nav-mobile-link {
    display: block;
    padding: 10px 0;
    font-size: 14px;
    color: var(--navy);
    text-decoration: none;
    opacity: 0.72;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
    transition: opacity 0.2s ease;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link.nav-link--active { opacity: 1; }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link, .nav-cta, .hamburger span, .nav-mobile-link {
      transition-duration: 0.01ms;
    }
  }
</style>
