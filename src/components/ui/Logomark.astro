---
interface Props {
  color?: string;
  size?: number;
}

const { color = 'currentColor', size = 32 } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  width={size}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M10 12 L10 38 L18 12 L24 28 L30 12 L36 38"
    stroke={color}
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
</svg>
