---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-dark';
  size?: 'sm' | 'md';
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
} = Astro.props;

const externalProps = external
  ? { target: '_blank', rel: 'noopener' }
  : {};

const base = 'inline-flex items-center gap-2 font-medium rounded-lg transition-all duration-200 ease-in-out no-underline';

const sizes = {
  sm: 'px-4 py-2.5 text-sm',
  md: 'px-6 py-3.5 text-sm',
};

const variants = {
  primary:    'btn-primary',
  ghost:      'btn-ghost',
  'ghost-dark': 'btn-ghost-dark',
};
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant]]}
  {...externalProps}
>
  <slot />
</a>

<style>
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    border: 1px solid transparent;
  }
  .btn-primary:hover {
    background: #854F0B;
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.65);
  }

  .btn-ghost-dark {
    background: transparent;
    color: var(--navy);
    border: 1px solid var(--navy);
  }
  .btn-ghost-dark:hover {
    background: var(--navy);
    color: #fff;
  }
</style>
