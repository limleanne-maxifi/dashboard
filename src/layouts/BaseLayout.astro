---
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  currentPage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  breadcrumbLabel?: string;
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  currentPage = '/',
  ogImage = 'https://maxifidigital.com/og-default.png',
  ogImageAlt,
  breadcrumbLabel,
  faqs,
} = Astro.props;
const finalOgImageAlt = ogImageAlt || `${title} | Maxifi Digital`;

const canonicalURL = Astro.url.href;
const pageTitle = title;

// Build a full breadcrumb trail from the route's path segments so each node's
// name matches its own cumulative URL (the previous single-segment version
// mislabelled deep pages, e.g. named an article "Insights" but linked its
// full URL). Pass `breadcrumbLabel` to give the leaf a clean human name.
// The entity graph (Organization + Person + WebSite + optional BreadcrumbList /
// FAQPage) is assembled and emitted by the SchemaOrg component below.
const titleCaseSegment = (seg: string) =>
  seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const segments = currentPage === '/' ? [] : currentPage.replace(/^\/+|\/+$/g, '').split('/');

const breadcrumbItems = [
  { name: 'Home', url: 'https://maxifidigital.com' },
  ...segments.map((seg, i) => ({
    name: i === segments.length - 1 && breadcrumbLabel ? breadcrumbLabel : titleCaseSegment(seg),
    url: `https://maxifidigital.com/${segments.slice(0, i + 1).join('/')}`,
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={finalOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={finalOgImageAlt} />

    <meta name="msvalidate.01" content="1F14880D43A6A0045A2FDA30B5BDA3B0" />

    <SchemaOrg canonicalURL={canonicalURL} breadcrumbItems={breadcrumbItems} faqs={faqs} />
    <slot name="head" />
  </head>
  <body>
    <Nav currentPage={currentPage} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
