---
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  currentPage?: string;
  ogImage?: string;
  ogImageAlt?: string;
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  currentPage = '/',
  ogImage = 'https://maxifidigital.com/og-default.png',
  ogImageAlt,
  breadcrumbLabel,
} = Astro.props;
const finalOgImageAlt = ogImageAlt || `${title} | Maxifi Digital`;

const canonicalURL = Astro.url.href;
const pageTitle = title;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://maxifidigital.com/#organization',
  name: 'Maxifi Digital',
  url: 'https://maxifidigital.com',
  logo: 'https://maxifidigital.com/logos/maxifi-logo-black.png',
  description: 'Maxifi Digital is a Singapore-based Answer Engine Optimisation (AEO) consultancy that helps expert-led brands become the source AI engines cite when buyers ask questions in their category.',
  disambiguatingDescription: 'Maxifi Digital (maxifidigital.com) is an independent Answer Engine Optimisation consultancy based in Singapore. It is not affiliated with MaxiFi Planner (maxifi.com), a personal financial planning software product, or with maxify.digital.',
  founder: {
    '@type': 'Person',
    '@id': 'https://maxifidigital.com/about#le-anne-lim',
    name: 'Lim Le-Anne',
    alternateName: 'Le-Anne Lim',
    sameAs: ['https://www.linkedin.com/in/limleanne/'],
  },
  foundingLocation: {
    '@type': 'Place',
    name: 'Singapore',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '60 Paya Lebar Road, #07-54, Paya Lebar Square',
    addressLocality: 'Singapore',
    postalCode: '409051',
    addressCountry: 'SG',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@maxifidigital.com',
    contactType: 'customer service',
  },
  sameAs: [
    'https://www.linkedin.com/company/maxifi-digital/',
    'https://share.google/YsPuoLlhu1lpQFbDw',
  ],
  knowsAbout: [
    'Answer Engine Optimisation',
    'AI Search Visibility',
    'Generative Engine Optimisation',
    'AEO Strategy',
    'Conference AEO',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Maxifi Digital',
  url: 'https://maxifidigital.com',
  publisher: { '@id': 'https://maxifidigital.com/#organization' },
};

// Build a full breadcrumb trail from the route's path segments so each node's
// name matches its own cumulative URL (the previous single-segment version
// mislabelled deep pages, e.g. named an article "Insights" but linked its
// full URL). Pass `breadcrumbLabel` to give the leaf a clean human name.
const titleCaseSegment = (seg: string) =>
  seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const segments = currentPage === '/' ? [] : currentPage.replace(/^\/+|\/+$/g, '').split('/');

const breadcrumbItems = [
  { name: 'Home', url: 'https://maxifidigital.com' },
  ...segments.map((seg, i) => ({
    name: i === segments.length - 1 && breadcrumbLabel ? breadcrumbLabel : titleCaseSegment(seg),
    url: `https://maxifidigital.com/${segments.slice(0, i + 1).join('/')}`,
  })),
];

const breadcrumbSchema = segments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={finalOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={finalOgImageAlt} />

    <meta name="msvalidate.01" content="1F14880D43A6A0045A2FDA30B5BDA3B0" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />}
    <slot name="head" />
  </head>
  <body>
    <Nav currentPage={currentPage} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
