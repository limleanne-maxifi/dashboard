---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Build AI Authority | The Visibility Engine | Maxifi Digital"
  description="The Visibility Engine — a quarterly AEO retainer that compounds your citation footprint across all five AI platforms. Snapshot, Sprint, Monitor, Repeat."
  currentPage="/work"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="work-heading">
    <p class="w-eyebrow">BUILD AI AUTHORITY</p>
    <h1 id="work-heading" class="page-h1">
      The Visibility Engine.<br>Built for expert-led brands.
    </h1>
    <p class="page-lede">
      AI engines change their retrieval models. New competitors publish. Buyer questions shift.
      The Visibility Engine keeps your brand cited as the landscape evolves — without you
      having to think about it.
    </p>
    <div class="hero-ctas">
      <a href="mailto:hello@maxifidigital.com?subject=Visibility%20Engine%20enquiry&body=I%27d%20like%20to%20learn%20more%20about%20the%20Visibility%20Engine%20retainer." class="btn-primary">
        Enquire about the Engine
      </a>
      <a href="/visibility-snapshot" class="btn-ghost">Start with a Snapshot</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       QUARTERLY CYCLE
  ══════════════════════════════════════════ -->
  <section class="section section--navy" aria-labelledby="cycle-heading">
    <div class="wrap-inner">
      <p class="s-eyebrow s-eyebrow--light">HOW IT WORKS</p>
      <h2 id="cycle-heading" class="section-h2 section-h2--light">The quarterly cycle</h2>
      <div class="cycle">
        <article class="cycle-step">
          <p class="step-num">Q1</p>
          <h3 class="step-title">Snapshot</h3>
          <p class="step-body">
            Full audit of your citation footprint across all five AI engines.
            Where you're named, where you're missing, and who AI cites instead.
          </p>
        </article>
        <div class="cycle-arrow" aria-hidden="true">→</div>
        <article class="cycle-step">
          <p class="step-num">Q2</p>
          <h3 class="step-title">Sprint</h3>
          <p class="step-body">
            Answer-ready assets shipped: Q&amp;A pairs, schema layers, updated
            positioning copy. All targeting the buyer questions your audit surfaced.
          </p>
        </article>
        <div class="cycle-arrow" aria-hidden="true">→</div>
        <article class="cycle-step">
          <p class="step-num">Q3</p>
          <h3 class="step-title">Monitor</h3>
          <p class="step-body">
            Weekly citation tracking across ChatGPT, Perplexity, Claude, Gemini
            and Google AI. Monthly performance digest sent to your team.
          </p>
        </article>
        <div class="cycle-arrow" aria-hidden="true">→</div>
        <article class="cycle-step">
          <p class="step-num">Q4</p>
          <h3 class="step-title">Repeat</h3>
          <p class="step-body">
            The next Snapshot reveals what moved. The next Sprint builds on
            compounding authority. Your competitive gap widens every quarter.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT'S INCLUDED
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="includes-heading">
    <div class="wrap-inner">
      <p class="s-eyebrow">WHAT'S INCLUDED</p>
      <h2 id="includes-heading" class="section-h2">Everything in the Engine</h2>
      <div class="includes">
        <div class="include-group">
          <p class="ig-label">Measurement</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly AI Visibility Snapshot (5 engines)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring report</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Competitor citation benchmarking</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Buyer query landscape tracking</li>
          </ul>
        </div>
        <div class="include-group">
          <p class="ig-label">Content production</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly answer-ready content Sprint</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Schema + JSON-LD layer maintained</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Q&amp;A pair library (grows each quarter)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Entity signal updates</li>
          </ul>
        </div>
        <div class="include-group">
          <p class="ig-label">Strategy & access</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Monthly strategy call (45 min)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Slack channel access</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>AEO playbook (evolves quarterly)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Cited Brief newsletter (weekly)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PROOF — CASE STUDIES
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="proof-heading">
    <div class="wrap-inner">
      <p class="s-eyebrow">THE ENGINE IN THE WILD</p>
      <h2 id="proof-heading" class="section-h2">Built for expert-led industries</h2>
      <div class="cases">

        <article class="case-card">
          <div class="case-meta">
            <p class="case-sector">Aviation &amp; ATM · Conference AEO Sprint</p>
            <h3 class="case-title">CANSO · Airspace World 2026</h3>
            <p class="case-body">
              From PDF graveyard to citation engine. How a 3-day aviation conference
              became a structured AI Knowledge Hub earning citations long after the event.
            </p>
            <div class="case-stats">
              <div class="cs">
                <span class="cs-v">3×</span>
                <span class="cs-l">citation growth</span>
              </div>
              <div class="cs">
                <span class="cs-v">47</span>
                <span class="cs-l">Q&amp;A pairs</span>
              </div>
              <div class="cs">
                <span class="cs-v">92%</span>
                <span class="cs-l">schema coverage</span>
              </div>
              <div class="cs">
                <span class="cs-v">#1</span>
                <span class="cs-l">cited source</span>
              </div>
            </div>
            <a href="/work/canso-airspace-world" class="case-link">Read the case study →</a>
          </div>
          <div class="case-visual" aria-hidden="true">
            <div class="cv-inner">
              <p class="cv-eyebrow">LIVE CASE</p>
              <p class="cv-domain">aswhub.<strong>maxifidigital.com</strong></p>
              <a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer" class="cv-visit">
                Visit the hub ↗
              </a>
            </div>
          </div>
        </article>

        <div class="case-card case-card--next">
          <p class="next-eyebrow">YOUR SECTOR NEXT?</p>
          <p class="next-body">
            The Engine runs across any expert-led industry — law, aviation, financial
            services, think tanks, professional bodies. If your buyers ask AI questions,
            we build the authority layer that answers them.
          </p>
          <a href="mailto:hello@maxifidigital.com?subject=Visibility%20Engine%20enquiry" class="btn-primary">
            Talk to us
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="work-cta-heading">
    <div class="wrap-inner">
      <div class="cta-box">
        <p class="s-eyebrow cta-eyebrow">START THE ENGINE</p>
        <h2 id="work-cta-heading" class="cta-title">
          Not sure where to start? Begin with a Snapshot.
        </h2>
        <p class="cta-body">
          The Snapshot is the entry point — it tells you exactly where you stand
          and what a Sprint or Engine would address. No obligation to continue.
        </p>
        <div class="cta-buttons">
          <a href="/visibility-snapshot" class="btn-primary">Get my free Snapshot</a>
          <a href="/conference-aeo" class="btn-outline">See the Conference Sprint</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Visibility Engine — AEO Retainer",
    "provider": {
      "@type": "Organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com"
    },
    "description": "A quarterly AEO retainer covering Snapshot audits, content Sprints, citation monitoring and strategy calls across five AI engines.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Engine Core",
        "price": "5000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "5000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Plus",
        "price": "8500",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "8500",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Enterprise",
        "price": "12000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "12000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      }
    ]
  }
  </script>

</BaseLayout>

<style>
  .wrap-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Hero ───────────────────────────────────── */
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 48px 40px 44px;
    text-align: center;
  }

  .w-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .page-h1 {
    font-size: 38px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 14px;
    line-height: 1.12;
    letter-spacing: -0.022em;
    max-width: 560px;
  }

  .page-lede {
    font-size: 14px;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 580px;
    margin: 0 auto 22px;
  }

  .hero-ctas {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Shared section ─────────────────────────── */
  .section {
    padding: 48px 0;
    background: var(--cream);
  }

  .section--navy   { background: var(--navy-deep); }
  .section--cream  { background: var(--cream-deep); }
  .section--pt0    { padding-top: 0; }

  .s-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .s-eyebrow--light { color: var(--amber-mid); }

  .section-h2 {
    font-size: 22px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .section-h2--light { color: var(--blue-text); }

  /* ── Quarterly cycle ────────────────────────── */
  .cycle {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 10px;
    align-items: start;
  }

  .cycle-arrow {
    padding-top: 30px;
    color: var(--amber);
    font-size: 16px;
  }

  .cycle-step {
    background: rgba(255,255,255,0.05);
    border: 0.5px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 16px;
  }

  .step-num {
    font-size: 10px;
    color: var(--amber-mid);
    font-weight: 500;
    letter-spacing: 0.08em;
    margin-bottom: 5px;
  }

  .step-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--blue-text);
    margin-bottom: 6px;
  }

  .step-body {
    font-size: 11px;
    line-height: 1.55;
    color: var(--blue-mid);
  }

  /* ── Includes ───────────────────────────────── */
  .includes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .include-group {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 18px;
  }

  .ig-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .ig-list { list-style: none; }

  .ig-item {
    font-size: 11px;
    color: var(--ink);
    padding: 3px 0;
    display: flex;
    gap: 6px;
    align-items: baseline;
    line-height: 1.4;
  }

  .check {
    color: var(--signal);
    font-weight: 500;
    flex-shrink: 0;
  }

  /* ── Pricing ────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }

  .price-card {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }

  .price-card--featured { border: 2px solid var(--amber); }

  .price-tag {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .price-tier {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 4px;
  }

  .price {
    font-size: 24px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .price-mo {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }

  .price-note {
    font-size: 10px;
    color: var(--mute-soft);
    margin-bottom: 14px;
    margin-top: 2px;
  }

  .price-items { list-style: none; flex: 1; margin-bottom: 14px; }

  .price-item {
    font-size: 11px;
    color: var(--ink);
    padding: 3px 0;
    display: flex;
    gap: 6px;
    line-height: 1.4;
  }

  .price-cta {
    display: block;
    text-align: center;
    padding: 9px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-cta--primary { background: var(--amber); color: var(--amber-light); }
  .price-cta--primary:hover { background: #854F0B; }

  .price-cta--outline {
    border: 0.5px solid rgba(4,44,83,0.22);
    color: var(--navy);
  }

  .price-cta--outline:hover { background: var(--navy); color: #fff; }

  .pricing-foot {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── Case studies ───────────────────────────── */
  .cases {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-card {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 24px 28px;
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 32px;
    align-items: center;
  }

  .case-card--next {
    grid-template-columns: 1fr;
    background: rgba(4,44,83,0.03);
    border-style: dashed;
  }

  .case-sector {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .case-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 10px;
    letter-spacing: -0.015em;
  }

  .case-body {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 16px;
  }

  .case-stats {
    display: flex;
    gap: 20px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .cs { display: flex; flex-direction: column; gap: 2px; }

  .cs-v {
    font-size: 20px;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cs-l {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.3;
  }

  .case-link {
    font-size: 12px;
    font-weight: 500;
    color: var(--amber);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .case-link:hover { color: var(--amber-mid); }

  .case-visual {
    background: var(--navy);
    border-radius: 6px;
    padding: 24px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }

  .cv-inner { text-align: center; }

  .cv-eyebrow {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber-mid);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .cv-domain {
    font-size: 12px;
    color: var(--blue-soft);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .cv-domain strong { color: var(--blue-text); font-weight: 500; }

  .cv-visit {
    font-size: 11px;
    font-weight: 500;
    color: var(--amber-mid);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cv-visit:hover { color: var(--amber-pale); }

  .next-eyebrow {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .next-body {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 600px;
    margin-bottom: 16px;
  }

  /* ── CTA ────────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 40px 32px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 22px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 10px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 480px;
  }

  .cta-body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 440px;
    margin: 0 auto 20px;
  }

  .cta-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Buttons ────────────────────────────────── */
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-ghost {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255,255,255,0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-ghost:hover { border-color: rgba(255,255,255,0.6); }

  .btn-outline {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255,255,255,0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: rgba(255,255,255,0.6); }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 900px) {
    .wrap-inner { padding: 0 24px; }
    .page-hero  { padding: 40px 24px 36px; }
    .page-h1    { font-size: 28px; }
    .section    { padding: 36px 0; }

    .cycle {
      grid-template-columns: 1fr;
    }

    .cycle-arrow { display: none; }

    .includes,
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .case-card {
      grid-template-columns: 1fr;
    }

    .case-visual { min-height: 90px; }
  }

  @media (max-width: 640px) {
    .page-h1 { font-size: 24px; }
    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-ghost, .btn-outline, .price-cta, .case-link, .cv-visit {
      transition-duration: 0.01ms;
    }
  }
</style>
