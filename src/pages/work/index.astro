---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Build AI Authority | The Visibility Engine | Maxifi Digital"
  description="The Visibility Engine — a quarterly AEO retainer that compounds your citation footprint across all five AI platforms. Snapshot, Sprint, Monitor, Repeat."
  currentPage="/work"
>

  <!-- ══════════════════════════════════════════
       SYSTEM — THE 3-STAGE VISIBILITY ENGINE
  ══════════════════════════════════════════ -->
  <section class="system-section section--navy" aria-labelledby="system-heading">
    <div class="wrap-inner">
      <div class="system-head">
        <h2 id="system-heading" class="system-title">The Visibility Engine — a 3-stage system that <em>compounds</em></h2>
        <p class="system-description">Not a content sprint. Not a one-off audit. A managed system that takes your expertise from invisible to indexed, then keeps citation share growing — quarter on quarter.</p>
      </div>

      <div class="system-grid">
        <div class="stages">
          <div class="stage">
            <div class="stage-label">Stage 01<br>Visibility Snapshot</div>
            <div class="stage-content">
              <h3 class="stage-title">See where AI cites you today</h3>
              <p class="stage-body">We map your citation share across all five engines and 25–50 buyer questions in your category. You get the three highest-leverage fixes within fourteen days.</p>
            </div>
          </div>
          <div class="stage">
            <div class="stage-label">Stage 02<br>Visibility Report</div>
            <div class="stage-content">
              <h3 class="stage-title">Ship answer-ready assets</h3>
              <p class="stage-body">We build the Q&amp;A layer, schema scaffolding and entity files AI engines need to cite you cleanly. Senior strategist embedded throughout.</p>
            </div>
          </div>
          <div class="stage">
            <div class="stage-label">Stage 03<br>Visibility Engine</div>
            <div class="stage-content">
              <h3 class="stage-title">Monitor, lift, defend</h3>
              <p class="stage-body">Weekly citation monitoring, quarterly Snapshot, monthly strategy review. Each cited answer trains the next — the curve accelerates.</p>
            </div>
          </div>
        </div>

        <div class="snap-card" aria-label="Sample Snapshot preview">
          <div class="snap-hdr">
            <h4 class="snap-title">Snapshot · Acme Consulting</h4>
            <span class="snap-score">78<em>/100</em></span>
          </div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · ChatGPT</span><span class="snap-value snap-value--cited">cited · #2</span></div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · Claude</span><span class="snap-value snap-value--cited">cited · #1</span></div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · Perplexity</span><span class="snap-value snap-value--not">not cited</span></div>
          <div class="snap-row"><span>Healthcare regulatory advisors · Gemini</span><span class="snap-value snap-value--cited">cited · #4</span></div>
          <div class="snap-row"><span>Top M&amp;A litigation specialists · Copilot</span><span class="snap-value snap-value--not">not cited</span></div>
          <div class="snap-row"><span>Cross-border health regulation · ChatGPT</span><span class="snap-value snap-value--cited">cited · #3</span></div>
          <div class="snap-legend">
            <span><i class="legend-dot legend-dot--cited"></i>Cited</span>
            <span><i class="legend-dot legend-dot--not"></i>Not cited</span>
            <span>· 6 of 25 queries shown</span>
          </div>
        </div>
      </div>

      <div class="system-bridge">
        <span class="bridge-label">Next ↘</span>
        <a href="#proof-heading" class="btn-ghost">See the Engine in full →</a>
        <a href="#case-studies" class="btn-ghost">Or jump to case studies</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT'S INCLUDED
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="includes-heading">
    <div class="wrap-inner">
      <p class="s-eyebrow">WHAT'S INCLUDED</p>
      <h2 id="includes-heading" class="section-h2">Everything in the Engine</h2>
      <div class="includes">
        <div class="include-group">
          <p class="ig-label">Measurement</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly AI Visibility Snapshot (5 engines)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring report</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Competitor citation benchmarking</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Buyer query landscape tracking</li>
          </ul>
        </div>
        <div class="include-group">
          <p class="ig-label">Content production</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly answer-ready content Sprint</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Schema + JSON-LD layer maintained</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Q&amp;A pair library (grows each quarter)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Entity signal updates</li>
          </ul>
        </div>
        <div class="include-group">
          <p class="ig-label">Strategy & access</p>
          <ul class="ig-list" role="list">
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Monthly strategy call (45 min)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Slack channel access</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>AEO playbook (evolves quarterly)</li>
            <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Cited Brief newsletter (weekly)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PROOF — CASE STUDIES
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="proof-heading">
    <div class="wrap-inner">
      <p class="s-eyebrow">THE ENGINE IN THE WILD</p>
      <h2 id="proof-heading" class="section-h2"><span id="case-studies"></span>Built for expert-led industries</h2>
      <div class="cases">

        <article class="case-card">
          <div class="case-meta">
            <p class="case-sector">Aviation &amp; ATM · Conference AEO Sprint</p>
            <h3 class="case-title">CANSO · Airspace World 2026</h3>
            <p class="case-body">
              From PDF graveyard to citation engine. How a 3-day aviation conference
              became a structured AI Knowledge Hub earning citations long after the event.
            </p>
            <div class="case-stats">
              <div class="cs">
                <span class="cs-v">3×</span>
                <span class="cs-l">citation growth</span>
              </div>
              <div class="cs">
                <span class="cs-v">47</span>
                <span class="cs-l">Q&amp;A pairs</span>
              </div>
              <div class="cs">
                <span class="cs-v">92%</span>
                <span class="cs-l">schema coverage</span>
              </div>
              <div class="cs">
                <span class="cs-v">#1</span>
                <span class="cs-l">cited source</span>
              </div>
            </div>
            <a href="/work/airspaceworld" class="case-link">Read the case study →</a>
          </div>
          <div class="case-visual" aria-hidden="true">
            <div class="cv-inner">
              <p class="cv-eyebrow">LIVE CASE</p>
              <p class="cv-domain">aswhub.<strong>maxifidigital.com</strong></p>
              <a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer" class="cv-visit">
                Visit the hub ↗
              </a>
            </div>
          </div>
        </article>

        <div class="case-card case-card--next">
          <p class="next-eyebrow">YOUR SECTOR NEXT?</p>
          <p class="next-body">
            The Engine runs across any expert-led industry — law, aviation, financial
            services, think tanks, professional bodies. If your buyers ask AI questions,
            we build the authority layer that answers them.
          </p>
          <a href="mailto:hello@maxifidigital.com?subject=Visibility%20Engine%20enquiry" class="btn-primary">
            Talk to us
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="work-cta-heading">
    <div class="wrap-inner">
      <div class="cta-box">
        <p class="s-eyebrow cta-eyebrow">START THE ENGINE</p>
        <h2 id="work-cta-heading" class="cta-title">
          Not sure where to start? Begin with a Snapshot.
        </h2>
        <p class="cta-body">
          The Snapshot is the entry point — it tells you exactly where you stand
          and what a Sprint or Engine would address. No obligation to continue.
        </p>
        <div class="cta-buttons">
          <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn-primary">Get my free Snapshot</a>
          <a href="/conference-aeo" class="btn-outline">See the Conference Sprint</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Visibility Engine — AEO Retainer",
    "provider": {
      "@type": "Organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com"
    },
    "description": "A quarterly AEO retainer covering Snapshot audits, content Sprints, citation monitoring and strategy calls across five AI engines.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Engine Core",
        "price": "5000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "5000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Plus",
        "price": "8500",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "8500",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Enterprise",
        "price": "12000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "12000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      }
    ]
  }
  </script>

</BaseLayout>

<style>
  .wrap-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Shared section ─────────────────────────── */
  .section {
    padding: 48px 0;
    background: var(--cream);
  }

  .section--navy   { background: var(--navy-deep); }
  .section--cream  { background: var(--cream-deep); }
  .section--pt0    { padding-top: 0; }

  .s-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .s-eyebrow--light { color: var(--amber-mid); }

  .section-h2 {
    font-size: 22px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .section-h2--light { color: var(--blue-text); }

  /* ── System Section ─────────────────────────── */
  .system-section {
    background: var(--navy);
    color: var(--blue-text);
    padding: 88px 0 104px;
  }

  .system-head {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .system-title {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 14px;
    line-height: 1.14;
    letter-spacing: -0.022em;
  }

  .system-title em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .system-description {
    font-size: 14px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.6;
    max-width: 600px;
  }

  .system-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: stretch;
  }

  .stages {
    display: grid;
    gap: 14px;
    height: 100%;
  }

  .stage {
    background: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px 24px;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 22px;
    align-items: start;
  }

  .stage-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--amber-mid);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    padding-top: 4px;
  }

  .stage-title {
    font-size: 17px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .stage-body {
    font-size: 12px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.55;
  }

  /* ── Snapshot Card ──────────────────────────── */
  .snap-card {
    background: var(--navy-deep);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .snap-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    margin-bottom: 14px;
  }

  .snap-title {
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    line-height: 1;
  }

  .snap-score {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--amber-pale);
    line-height: 1;
  }

  .snap-score em {
    font-style: normal;
    font-size: 11px;
    color: var(--blue-mid);
  }

  .snap-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.06);
    color: var(--blue-soft);
    line-height: 1.5;
  }

  .snap-row:last-child {
    border-bottom: none;
  }

  .snap-value {
    font-weight: 500;
  }

  .snap-value--cited {
    color: var(--amber-pale);
  }

  .snap-value--not {
    color: var(--danger);
  }

  .snap-legend {
    display: flex;
    gap: 14px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 0.5px solid rgba(255,255,255,0.08);
    font-size: 10px;
    font-weight: 400;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    vertical-align: middle;
  }

  .legend-dot--cited {
    background: var(--amber-pale);
  }

  .legend-dot--not {
    background: var(--danger);
  }

  /* ── System Bridge ──────────────────────────── */
  .system-bridge {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .bridge-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-mid);
  }

  /* ── Includes ───────────────────────────────── */
  .includes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .include-group {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 18px;
  }

  .ig-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .ig-list { list-style: none; }

  .ig-item {
    font-size: 11px;
    color: var(--ink);
    padding: 3px 0;
    display: flex;
    gap: 6px;
    align-items: baseline;
    line-height: 1.4;
  }

  .check {
    color: var(--signal);
    font-weight: 500;
    flex-shrink: 0;
  }

  /* ── Pricing ────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }

  .price-card {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }

  .price-card--featured { border: 2px solid var(--amber); }

  .price-tag {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .price-tier {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 4px;
  }

  .price {
    font-size: 24px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .price-mo {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }

  .price-note {
    font-size: 10px;
    color: var(--mute-soft);
    margin-bottom: 14px;
    margin-top: 2px;
  }

  .price-items { list-style: none; flex: 1; margin-bottom: 14px; }

  .price-item {
    font-size: 11px;
    color: var(--ink);
    padding: 3px 0;
    display: flex;
    gap: 6px;
    line-height: 1.4;
  }

  .price-cta {
    display: block;
    text-align: center;
    padding: 9px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-cta--primary { background: var(--amber); color: var(--amber-light); }
  .price-cta--primary:hover { background: #854F0B; }

  .price-cta--outline {
    border: 0.5px solid rgba(4,44,83,0.22);
    color: var(--navy);
  }

  .price-cta--outline:hover { background: var(--navy); color: #fff; }

  .pricing-foot {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── Case studies ───────────────────────────── */
  .cases {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-card {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 24px 28px;
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 32px;
    align-items: center;
  }

  .case-card--next {
    grid-template-columns: 1fr;
    background: rgba(4,44,83,0.03);
    border-style: dashed;
  }

  .case-sector {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .case-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 10px;
    letter-spacing: -0.015em;
  }

  .case-body {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 16px;
  }

  .case-stats {
    display: flex;
    gap: 20px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .cs { display: flex; flex-direction: column; gap: 2px; }

  .cs-v {
    font-size: 20px;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cs-l {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.3;
  }

  .case-link {
    font-size: 12px;
    font-weight: 500;
    color: var(--amber);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .case-link:hover { color: var(--amber-mid); }

  .case-visual {
    background: var(--navy);
    border-radius: 6px;
    padding: 24px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }

  .cv-inner { text-align: center; }

  .cv-eyebrow {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber-mid);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .cv-domain {
    font-size: 12px;
    color: var(--blue-soft);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .cv-domain strong { color: var(--blue-text); font-weight: 500; }

  .cv-visit {
    font-size: 11px;
    font-weight: 500;
    color: var(--amber-mid);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cv-visit:hover { color: var(--amber-pale); }

  .next-eyebrow {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .next-body {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 600px;
    margin-bottom: 16px;
  }

  /* ── CTA ────────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 40px 32px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 22px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 10px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 480px;
  }

  .cta-body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 440px;
    margin: 0 auto 20px;
  }

