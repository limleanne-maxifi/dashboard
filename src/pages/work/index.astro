---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Build AI Authority | The Visibility Engine | Maxifi Digital"
  description="The Visibility Engine — a quarterly AEO retainer that compounds your citation footprint across all five AI platforms. Snapshot, Sprint, Monitor, Repeat."
  currentPage="/work"
>

  <!-- ══════════════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════════════ -->
  <section class="page-header">
    <div class="wrap-inner">
      <p class="page-eyebrow">BUILD AI AUTHORITY</p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SYSTEM — THE 3-STAGE VISIBILITY ENGINE
  ══════════════════════════════════════════ -->
  <section class="system-section section--navy" aria-labelledby="system-heading">
    <div class="wrap-inner">
      <div class="system-head">
        <h2 id="system-heading" class="system-title">The Visibility Engine — a 3-stage system that <em>compounds</em></h2>
        <p class="system-description">Not a content sprint. Not a one-off audit. A managed system that takes your expertise from invisible to indexed, then keeps citation share growing — quarter on quarter.</p>
      </div>

      <div class="system-grid">
        <div class="stages">
          <div class="stage">
            <div class="stage-label">Stage 01<br>Visibility Snapshot</div>
            <div class="stage-content">
              <h3 class="stage-title">See where AI cites you today</h3>
              <p class="stage-body">We map your citation share across all five engines and 25–50 buyer questions in your category. You get the three highest-leverage fixes within fourteen days.</p>
            </div>
          </div>
          <div class="stage">
            <div class="stage-label">Stage 02<br>Visibility Report</div>
            <div class="stage-content">
              <h3 class="stage-title">Ship answer-ready assets</h3>
              <p class="stage-body">We build the Q&amp;A layer, schema scaffolding and entity files AI engines need to cite you cleanly. Senior strategist embedded throughout.</p>
            </div>
          </div>
          <div class="stage">
            <div class="stage-label">Stage 03<br>Visibility Engine</div>
            <div class="stage-content">
              <h3 class="stage-title">Monitor, lift, defend</h3>
              <p class="stage-body">Weekly citation monitoring, quarterly Snapshot, monthly strategy review. Each cited answer trains the next — the curve accelerates.</p>
            </div>
          </div>
        </div>

        <div class="snap-card" aria-label="Sample Snapshot preview">
          <div class="snap-hdr">
            <h4 class="snap-title">Snapshot · Acme Consulting</h4>
            <span class="snap-score">78<em>/100</em></span>
          </div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · ChatGPT</span><span class="snap-value snap-value--cited">cited · #2</span></div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · Claude</span><span class="snap-value snap-value--cited">cited · #1</span></div>
          <div class="snap-row"><span>Best firm for healthcare M&amp;A · Perplexity</span><span class="snap-value snap-value--not">not cited</span></div>
          <div class="snap-row"><span>Healthcare regulatory advisors · Gemini</span><span class="snap-value snap-value--cited">cited · #4</span></div>
          <div class="snap-row"><span>Top M&amp;A litigation specialists · Copilot</span><span class="snap-value snap-value--not">not cited</span></div>
          <div class="snap-row"><span>Cross-border health regulation · ChatGPT</span><span class="snap-value snap-value--cited">cited · #3</span></div>
          <div class="snap-legend">
            <span><i class="legend-dot legend-dot--cited"></i>Cited</span>
            <span><i class="legend-dot legend-dot--not"></i>Not cited</span>
            <span>· 6 of 25 queries shown</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="work-cta-heading">
    <div class="wrap-inner">
      <div class="cta-box">
        <p class="s-eyebrow cta-eyebrow">START THE ENGINE</p>
        <h2 id="work-cta-heading" class="cta-title">
          Not sure where to start? Begin with a Visibility Snapshot.
        </h2>
        <p class="cta-body">
          The snapshot is the entry point — it tells you exactly where you stand and what a Visibility Sprint or Engine would address. No obligation to continue.
        </p>
        <div class="cta-buttons">
          <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn-primary">Get my free Visibility Snapshot</a>
          <a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer" class="btn-outline">See how Conference AEO operates</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Visibility Engine — AEO Retainer",
    "provider": {
      "@type": "Organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com"
    },
    "description": "A quarterly AEO retainer covering Snapshot audits, content Sprints, citation monitoring and strategy calls across five AI engines.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Engine Core",
        "price": "5000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "5000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Plus",
        "price": "8500",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "8500",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Enterprise",
        "price": "12000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "12000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      }
    ]
  }
  </script>

</BaseLayout>

<style>
  .wrap-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Page Header ─────────────────────────────── */
  .page-header {
    background: var(--cream);
    padding: 32px 0 24px;
  }

  .page-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Shared section ─────────────────────────── */
  .section {
    padding: 48px 0;
    background: var(--cream);
  }

  .section--navy   { background: var(--navy-deep); }
  .section--cream  { background: var(--cream-deep); }
  .section--pt0    { padding-top: 0; }

  .s-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .s-eyebrow--light { color: var(--amber-mid); }

  .section-h2 {
    font-size: 22px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .section-h2--light { color: var(--blue-text); }

  /* ── System Section ─────────────────────────── */
  .system-section {
    background: var(--navy);
    color: var(--blue-text);
    padding: 88px 0 104px;
  }

  .system-head {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .system-title {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 14px;
    line-height: 1.14;
    letter-spacing: -0.022em;
  }

  .system-title em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .system-description {
    font-size: 14px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.6;
    max-width: 600px;
  }

  .system-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: stretch;
  }

  .stages {
    display: grid;
    gap: 14px;
    height: 100%;
  }

  .stage {
    background: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px 24px;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 22px;
    align-items: start;
  }

  .stage-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--amber-mid);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    padding-top: 4px;
  }

  .stage-title {
    font-size: 17px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .stage-body {
    font-size: 12px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.55;
  }

  /* ── Snapshot Card ──────────────────────────── */
  .snap-card {
    background: var(--navy-deep);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .snap-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    margin-bottom: 14px;
  }

  .snap-title {
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    line-height: 1;
  }

  .snap-score {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--amber-pale);
    line-height: 1;
  }

  .snap-score em {
    font-style: normal;
    font-size: 11px;
    color: var(--blue-mid);
  }

  .snap-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.06);
    color: var(--blue-soft);
    line-height: 1.5;
  }

  .snap-row:last-child {
    border-bottom: none;
  }

  .snap-value {
    font-weight: 500;
  }

  .snap-value--cited {
    color: var(--amber-pale);
  }

  .snap-value--not {
    color: var(--danger);
  }

  .snap-legend {
    display: flex;
    gap: 14px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 0.5px solid rgba(255,255,255,0.08);
    font-size: 10px;
    font-weight: 400;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    vertical-align: middle;
  }

  .legend-dot--cited {
    background: var(--amber-pale);
  }

  .legend-dot--not {
    background: var(--danger);
  }

  /* ── Pricing ────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 14px;
  }

  .price-card {
    background: #fff;
    border: 0.5px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }

  .price-card--featured { border: 2px solid var(--amber); }

  .price-tag {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .price-tier {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 4px;
  }

  .price {
    font-size: 24px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .price-mo {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }

  .price-note {
    font-size: 10px;
    color: var(--mute-soft);
    margin-bottom: 14px;
    margin-top: 2px;
  }

  .price-items { list-style: none; flex: 1; margin-bottom: 14px; }

  .price-item {
    font-size: 11px;
    color: var(--ink);
    padding: 3px 0;
    display: flex;
    gap: 6px;
    line-height: 1.4;
  }

  .price-cta {
    display: block;
    text-align: center;
    padding: 9px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-cta--primary { background: var(--amber); color: var(--amber-light); }
  .price-cta--primary:hover { background: #854F0B; }

  .price-cta--outline {
    border: 0.5px solid rgba(4,44,83,0.22);
    color: var(--navy);
  }

  .price-cta--outline:hover { background: var(--navy); color: #fff; }

  .pricing-foot {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── CTA ────────────────────────────────────── */
  .section:has(.cta-box) {
    padding: 48px 40px;
  }

  .cta-box {
    background: var(--navy);
    padding: 40px 32px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 22px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 10px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 480px;
  }

  .cta-body {
    font-size: 13px;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 440px;
    margin: 0 auto 20px;
  }

  .cta-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Buttons ────────────────────────────────── */
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-ghost {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255,255,255,0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-ghost:hover { border-color: rgba(255,255,255,0.6); }

  .btn-outline {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 18px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255,255,255,0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: rgba(255,255,255,0.6); }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 900px) {
    .wrap-inner { padding: 0 24px; }
    .page-hero  { padding: 40px 24px 36px; }
    .page-h1    { font-size: 28px; }
    .section    { padding: 36px 0; }
    .system-section { padding: 64px 0 80px; }

    .system-title { font-size: 26px; }

    .system-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .snap-card { height: auto; }
  }

  @media (max-width: 640px) {
    .page-h1 { font-size: 24px; }
    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-ghost, .btn-outline, .price-cta, .case-link, .cv-visit {
      transition-duration: 0.01ms;
    }
  }
</style>
