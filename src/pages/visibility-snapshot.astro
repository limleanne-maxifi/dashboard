---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisibilitySnapshotHero from '../components/sections/VisibilitySnapshotHero.astro';
import VisibilitySnapshotSample from '../components/sections/VisibilitySnapshotSample.astro';
---

<BaseLayout
  title="AI Visibility Snapshot · Maxifi Digital"
  description="When your market asks AI who to trust, does your company show up? Free 5-minute audit across ChatGPT, Claude, Copilot, Gemini and Perplexity. Inbox in 24h."
  currentPage="/visibility-snapshot"
>

<!-- ══ HERO ══ -->
<VisibilitySnapshotHero />

<!-- ══ SAMPLE REPORT ══ -->
<VisibilitySnapshotSample />

<!-- ══ OUTRO: NEXT STEPS + CTA (combined) ══ -->
<section class="vs-outro">
  <div class="vs-wrap">
    <div class="vs-outro__bottom">
      <span class="vs-eyebrow vs-outro__eyebrow">Don't guess — test</span>
      <h2>When your buyers ask AI who to trust — <em>be the answer.</em></h2>
      <div class="vs-outro__ctas">
        <a class="vs-btn vs-btn--primary vs-btn--lg" href="#snapshot">Run my Visibility Snapshot →</a>
        <a class="vs-btn vs-btn--ghost-dark vs-btn--lg" href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">See a live example →</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  /* ── Snapshot form: in-place success state ── */
  const snapForm = document.getElementById('vs-snapshot-form') as HTMLFormElement | null;
  const snapStep1 = document.getElementById('vs-form-step1');
  const snapResults = document.getElementById('vs-results');

  if (snapForm && snapStep1 && snapResults) {
    snapForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(snapForm)).map(([k, v]) => [k, String(v)])
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
      } catch {
        /* fall through — still show success */
      }
      snapStep1.style.display = 'none';
      snapResults.removeAttribute('hidden');
    });
  }

</script>

<style>
  /* ═══════════════════════════════════════════════════════
     VISIBILITY SNAPSHOT · page styles · vs- prefix
     All tokens from globals.css — no hardcoded hex values
     ═══════════════════════════════════════════════════════ */

  /* ── Shared primitives ── */
  .vs-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .vs-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brown-mid);
    margin-bottom: 16px;
  }

  .vs-sec-head {
    margin-bottom: 16px;
    max-width: 720px;
  }

  .vs-sec-head h2 {
    font-size: 44px;
    font-weight: 500;
    color: var(--amber);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    white-space: nowrap;
  }

  .vs-sec-head h2 em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  .vs-sec-head p {
    font: 400 16px/1.55 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }

  .vs-n {
    font: 500 12px/1.2 var(--font-mono);
    color: var(--amber);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    padding-top: 2px;
  }

  /* Shared button */
  .vs-btn {
    display: inline-block;
    font: 500 12px/1 var(--font-sans);
    text-decoration: none;
    border-radius: 5px;
    transition: background 0.2s ease, border-color 0.2s ease;
    padding: 10px 16px;
  }

  .vs-btn--primary {
    background: var(--amber);
    color: var(--amber-light);
    border: none;
  }

  .vs-btn--primary:hover { background: #854F0B; }

  .vs-btn--ghost-dark {
    background: transparent;
    color: var(--blue-text);
    border: 0.5px solid rgba(255, 255, 255, 0.3);
  }

  .vs-btn--ghost-dark:hover { border-color: rgba(255, 255, 255, 0.6); }

  .vs-btn--lg {
    font-size: 14px;
    padding: 14px 22px;
  }

  /* ── HERO ── */
  .vs-hero {
    padding: 18px 22px 40px;
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
  }

  .vs-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: stretch;
  }

  .vs-hero__left {
    display: flex;
    flex-direction: column;
  }

  .vs-hero__eyebrow {
    color: var(--amber-mid);
    margin-bottom: 18px;
  }

  .vs-hero h1 {
    font-size: 44px;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--blue-text);
    margin: 0;
  }

  .vs-hero h1 em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  .vs-hero__lede {
    font: 400 16px/1.55 var(--font-sans);
    color: var(--blue-soft);
    margin-top: 20px;
    margin-bottom: 0;
    max-width: 540px;
  }

  .vs-hero__lede em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  /* ── FORM CARD ── */
  .vs-form-card {
    background: #fff;
    border: 0.5px solid var(--line);
    border-radius: 8px;
    padding: 28px;
    box-shadow: 0 1px 0 rgba(4, 44, 83, 0.04), 0 12px 32px -16px rgba(4, 44, 83, 0.10);
  }

  .vs-form-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 10px/1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--signal);
    background: rgba(29, 158, 117, 0.08);
    padding: 6px 9px;
    border-radius: 3px;
    margin-bottom: 14px;
  }

  .vs-form-badge::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
  }

  .vs-form-card h3 {
    font-size: 23px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 16px;
    letter-spacing: -0.015em;
  }

  /* Score chip */
  .vs-scorechip {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px;
    background: var(--navy);
    color: var(--blue-text);
    border-radius: 6px;
    margin-bottom: 18px;
  }

  .vs-scorechip__num {
    font: 500 28px/1 var(--font-sans);
    color: var(--amber-pale);
    letter-spacing: -0.01em;
    text-align: center;
  }

  .vs-scorechip__num small {
    display: block;
    font: 500 9px/1 var(--font-sans);
    color: var(--blue-mid);
    margin-top: 4px;
    letter-spacing: 0.02em;
  }

  .vs-scorechip__lbl {
    font: 500 9px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber-mid);
    margin-bottom: 4px;
  }

  .vs-scorechip__meta h6 {
    font-size: 12.5px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 2px;
    letter-spacing: -0.01em;
  }

  .vs-scorechip__meta p {
    font: 400 11px/1.4 var(--font-sans);
    color: var(--blue-soft);
    margin: 0;
  }

  /* Form fields */
  .vs-field {
    margin-bottom: 12px;
  }

  .vs-field label {
    display: block;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute-soft);
    margin-bottom: 6px;
  }

  .vs-field input {
    width: 100%;
    padding: 10px 12px;
    font: 400 13px/1 var(--font-sans);
    border: 0.5px solid rgba(4, 44, 83, 0.18);
    background: var(--cream);
    border-radius: 4px;
    color: var(--ink);
    transition: border-color 0.2s ease, background 0.2s ease;
    box-sizing: border-box;
  }

  .vs-field input:focus {
    outline: none;
    border-color: var(--amber);
    background: #fff;
  }

  .vs-submit {
    width: 100%;
    font: 500 14px/1 var(--font-sans);
    background: var(--amber);
    color: var(--amber-light);
    padding: 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.2s ease;
    margin-top: 6px;
  }

  .vs-submit:hover { background: #854F0B; }

  /* Success state */
  .vs-results {
    padding: 4px 0;
  }

  .vs-results__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .vs-check {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(29, 158, 117, 0.12);
    color: var(--signal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 14px;
    flex-shrink: 0;
  }

  .vs-results__head h3 {
    font-size: 18px;
    font-weight: 500;
    color: var(--navy);
    margin: 0;
  }

  .vs-results p {
    font: 400 12.5px/1.6 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }

  /* ── SAMPLE REPORT ── */
  .vs-sample {
    padding: 48px 0 96px;
    background: var(--cream-deep);
  }

  .vs-sample__panel {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 36px;
    align-items: stretch;
  }

  .vs-sample__lbl {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brown-mid);
    display: inline-block;
    margin-bottom: 16px;
  }

  .vs-sample__copy h3 {
    font-size: 33.6px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .vs-sample__copy h3 em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  .vs-sample__copy p {
    font: 400 16px/1.55 var(--font-sans);
    color: var(--muted);
    margin: 0 0 14px;
  }

  .vs-sample__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 22px 0 0;
  }

  .vs-sample__cell {
    padding: 16px 18px;
    border: 0.5px solid var(--line);
    border-radius: 6px;
    background: var(--cream);
  }

  .vs-sample__cell .vs-n {
    display: block;
    margin-bottom: 8px;
    color: var(--amber);
  }

  .vs-sample__cell b {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .vs-sample__cell p {
    font: 400 13px/1.55 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }

  .vs-sample__cta-row {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .vs-sample__meta {
    font: 400 11px/1.4 var(--font-mono);
    color: var(--mute-soft);
  }

  /* Mock report card */
  .vs-report {
    background: #fff;
    border: 0.5px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 1px 0 rgba(4, 44, 83, 0.04), 0 24px 56px -28px rgba(4, 44, 83, 0.22);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .vs-report__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .vs-report__rows {
    margin-top: auto;
  }

  .vs-report__chrome {
    padding: 12px 18px;
    background: var(--navy);
    color: var(--blue-text);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vs-report__chrome-left {
    color: var(--amber-mid);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .vs-report__chrome-left::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .vs-report__chrome-right { color: var(--blue-mid); }

  .vs-report__body { padding: 28px 30px 30px; }

  .vs-report__meta {
    font: 400 11px/1.4 var(--font-sans);
    color: var(--mute-soft);
    margin-bottom: 22px;
  }

  .vs-report__h {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--navy);
    margin-bottom: 22px;
  }

  .vs-report__h em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  /* Score ring panel */
  .vs-report__score {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    align-items: center;
    padding: 22px;
    background: var(--cream-deep);
    border-radius: 6px;
    margin-bottom: 22px;
  }

  .vs-ring {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: conic-gradient(var(--amber) 0deg 169deg, rgba(4, 44, 83, 0.08) 169deg 360deg);
    display: grid;
    place-items: center;
    position: relative;
  }

  .vs-ring::after {
    content: "";
    position: absolute;
    inset: 9px;
    background: var(--cream-deep);
    border-radius: 50%;
  }

  .vs-ring__v {
    position: relative;
    z-index: 1;
    font: 500 38px/1 var(--font-mono);
    color: var(--navy);
    letter-spacing: -0.02em;
    text-align: center;
  }

  .vs-ring__v small {
    display: block;
    font: 500 10px/1 var(--font-mono);
    color: var(--mute-soft);
    margin-top: 4px;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .vs-report__info-lbl {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute-soft);
    margin-bottom: 8px;
  }

  .vs-report__info h4 {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .vs-report__info p {
    font: 400 12px/1.5 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }

  .vs-band {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown-deep);
    background: rgba(186, 117, 23, 0.10);
    padding: 6px 9px;
    border-radius: 3px;
    margin-top: 12px;
  }

  /* Engine rows */
  .vs-report__rows { display: grid; gap: 6px; }

  .vs-report__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 9px 12px;
    background: var(--cream);
    border: 0.5px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .vs-engine { color: var(--navy); }

  .vs-stat { color: var(--amber); font-weight: 500; }
  .vs-ok { color: var(--signal); }
  .vs-lo { color: var(--danger); }

  /* ── OUTRO (next steps + CTA combined) ── */
  .vs-outro {
    padding: 80px 0 96px;
    background: var(--navy-deep);
  }

  .vs-outro__eyebrow {
    color: var(--amber-mid);
    margin-bottom: 16px;
  }

  .vs-outro__bottom {
    text-align: center;
  }

  .vs-outro__bottom h2 {
    font-size: 30px;
    font-weight: 500;
    color: var(--blue-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }

  .vs-outro__bottom h2 em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }

  .vs-outro__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 960px) {
    .vs-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .vs-hero h1 { font-size: 34px; }

    .vs-sample__panel {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .vs-next__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .vs-wrap { padding: 0 24px; }

    .vs-hero { padding: 56px 0 48px; }

    .vs-hero h1 { font-size: 28px; }

    .vs-hero__lede { font-size: 14px; }

    .vs-outro__bottom h2 { font-size: 24px; }

    .vs-outro { padding: 64px 0; }
  }
</style>
