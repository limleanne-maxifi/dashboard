---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Visibility Snapshot | Maxifi Digital"
  description="Get your free AI Visibility Snapshot. See how ChatGPT, Perplexity, Claude, Gemini and Google AI are citing — or ignoring — your brand right now."
  currentPage="/visibility-snapshot"
>

  <!-- ══════════════════════════════════════════
       HERO — compact, conversion-focused
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="snapshot-heading">
    <p class="hero-eyebrow">FREE · 5 MINUTES</p>
    <h1 id="snapshot-heading" class="page-h1">
      Your AI Visibility Snapshot
    </h1>
    <p class="page-lede">
      Find out what ChatGPT, Perplexity, Claude, Gemini and Google AI say about
      your brand — and three things you can fix this week.
    </p>

    <!-- Step indicator -->
    <div class="steps" aria-label="How it works">
      <div class="step">
        <span class="step-num">01</span>
        <span class="step-label">Your details</span>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <span class="step-num">02</span>
        <span class="step-label">AI scans 5 engines</span>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <span class="step-num">03</span>
        <span class="step-label">Report delivered</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       REPORT PREVIEW — show output before input
  ══════════════════════════════════════════ -->
  <section class="preview-section" aria-labelledby="preview-heading">
    <div class="preview-wrap">
      <div class="preview-intro">
        <p class="s-eyebrow">SEE IT BEFORE YOU START</p>
        <h2 id="preview-heading" class="section-h2">
          This is what your Snapshot report looks like.
        </h2>
      </div>

      <div class="preview-grid">
        <!-- Left: sample report mockup -->
        <div class="report-shell" aria-label="Sample Snapshot report">
          <div class="report-badge">SAMPLE REPORT</div>
          <div class="report-card">
            <p class="rc-eyebrow">AI VISIBILITY SNAPSHOT · FREE REPORT</p>
            <p class="rc-meta">
              <span class="rc-meta-blur">Organisation · Sector · Role</span>
              · Generated today
            </p>
            <h3 class="rc-headline">
              You're showing up — but the wrong story is being told about you.
            </h3>
            <div class="rc-divider" aria-hidden="true"></div>
            <div class="rc-score-row">
              <div class="rc-circle" aria-label="AI Visibility Score: 47 out of 100">
                <svg viewBox="0 0 100 100" width="84" height="84" aria-hidden="true">
                  <circle cx="50" cy="50" r="38" fill="none" stroke="rgba(4,44,83,0.08)" stroke-width="7"/>
                  <circle
                    cx="50" cy="50" r="38" fill="none"
                    stroke="#BA7517" stroke-width="7"
                    stroke-dasharray="112.3 238.76"
                    stroke-linecap="round"
                    transform="rotate(-90 50 50)"
                  />
                </svg>
                <div class="rc-score-val">
                  <span class="rc-score-num">47</span>
                  <span class="rc-score-den">/100</span>
                </div>
              </div>
              <div class="rc-score-text">
                <p class="rc-score-label">YOUR AI VISIBILITY SCORE</p>
                <p class="rc-score-verdict">
                  Below industry median (62) — competitor displacement is the dominant failure pattern.
                </p>
                <span class="rc-band">⚠ CAUTION BAND · 40–59</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: what it tells you + CTA -->
        <div class="preview-copy">
          <ul class="report-items" role="list">
            <li class="ri">
              <span class="ri-num">01</span>
              <div>
                <strong class="ri-title">Your AI Visibility Score</strong>
                <p class="ri-body">A 0–100 score benchmarked against your sector median, with a clear band rating and the dominant failure pattern.</p>
              </div>
            </li>
            <li class="ri">
              <span class="ri-num">02</span>
              <div>
                <strong class="ri-title">Citation gap analysis</strong>
                <p class="ri-body">Exactly which buyer queries surface your competitors — not you — across ChatGPT, Perplexity, Claude, Gemini and Google AI.</p>
              </div>
            </li>
            <li class="ri">
              <span class="ri-num">03</span>
              <div>
                <strong class="ri-title">Structural gaps ranked by impact</strong>
                <p class="ri-body">The content, schema and entity signals preventing retrieval — prioritised so you know what to fix first.</p>
              </div>
            </li>
            <li class="ri">
              <span class="ri-num">04</span>
              <div>
                <strong class="ri-title">Three fixes to ship this week</strong>
                <p class="ri-body">Actionable changes your team can implement immediately to lift citation rate before the next buyer search.</p>
              </div>
            </li>
          </ul>
          <a href="#snapshot" class="btn-start">
            Start your Snapshot →
          </a>
          <p class="btn-sub">Free · 5 minutes · Immediate results</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       TRUST STRIP
  ══════════════════════════════════════════ -->
  <div class="trust-strip" role="complementary" aria-label="Sectors served">
    <span class="trust-label">Used by expert-led organisations in</span>
    <div class="trust-pills">
      <span class="pill">Aviation bodies</span>
      <span class="pill">Law firms</span>
      <span class="pill">Think tanks</span>
      <span class="pill">Pro services</span>
      <span class="pill">Associations</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       TOOL EMBED — the Snapshot tool itself
  ══════════════════════════════════════════ -->
  <section class="embed-section" id="snapshot" aria-labelledby="tool-heading">
    <div class="embed-header">
      <p class="embed-eyebrow">AI VISIBILITY SNAPSHOT · STEP 1 OF 5</p>
      <h2 id="tool-heading" class="embed-title">Start your free Snapshot below</h2>
      <p class="embed-sub">Takes 2 minutes. Your personalised report is delivered immediately — no sales call, no follow-up required unless you want one.</p>
    </div>
    <iframe
      src="https://visibilityview.netlify.app/"
      title="AI Visibility Snapshot tool — Step 1 of 5"
      class="snapshot-frame"
      loading="lazy"
      sandbox="allow-scripts allow-forms allow-same-origin allow-popups"
    ></iframe>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT YOUR SNAPSHOT COVERS
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="covers-heading">
    <p class="s-eyebrow">INSIDE YOUR REPORT</p>
    <h2 id="covers-heading" class="section-h2">What your Snapshot covers</h2>
    <div class="cards">
      <article class="card">
        <p class="card-num">01</p>
        <h3 class="card-title">Citation audit</h3>
        <p class="card-body">
          Which AI engines mention your brand today, which queries surface you,
          and where competitors are named instead.
        </p>
      </article>
      <article class="card">
        <p class="card-num">02</p>
        <h3 class="card-title">Structural gaps</h3>
        <p class="card-body">
          The specific content, schema and entity signals that are preventing
          retrieval — ranked by leverage.
        </p>
      </article>
      <article class="card">
        <p class="card-num">03</p>
        <h3 class="card-title">Three quick wins</h3>
        <p class="card-body">
          Actionable fixes your team can implement this week to lift citation
          rate before the next buyer search.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PREFER A HUMAN EYE — manual scorecard
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="form-heading">
    <div class="form-wrap">
      <div class="form-text">
        <p class="s-eyebrow">PREFER A HUMAN EYE?</p>
        <h2 id="form-heading" class="section-h2" style="max-width:360px;">
          Request a manual Scorecard review
        </h2>
        <p class="form-sub">
          Submit your site and we'll do the AI citation checks by hand and send
          you a written report within one business day.
        </p>
      </div>
      <div id="scorecard-form-wrap">
        <form
          name="visibility-scorecard"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="scorecard-form"
          class="request-form"
        >
          <input type="hidden" name="form-name" value="visibility-scorecard" />
          <input type="hidden" name="source-page" value="visibility-snapshot" />
          <p class="honeypot" aria-hidden="true">
            <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="f-label" for="sc-website">Your website</label>
          <input
            class="f-input"
            type="text"
            id="sc-website"
            name="website"
            placeholder="acmeconsulting.com"
            required
          />

          <label class="f-label" for="sc-category">Your category</label>
          <input
            class="f-input"
            type="text"
            id="sc-category"
            name="category"
            placeholder="e.g. Management consulting"
            required
          />

          <label class="f-label" for="sc-question">A question your buyer would ask AI</label>
          <input
            class="f-input"
            type="text"
            id="sc-question"
            name="buyer-question"
            placeholder="e.g. Best firm for healthcare M&amp;A"
            required
          />

          <label class="f-label" for="sc-email">Your work email</label>
          <input
            class="f-input"
            type="email"
            id="sc-email"
            name="email"
            placeholder="you@company.com"
            required
          />

          <button type="submit" class="f-btn">Send my Scorecard request →</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       NEXT STEP — SPRINT CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="next-heading">
    <div class="next-box">
      <p class="s-eyebrow next-eyebrow">WHAT COMES NEXT</p>
      <h2 id="next-heading" class="next-title">
        Ready to go further than a Snapshot?
      </h2>
      <p class="next-body">
        The Sprint turns your gaps into shipped assets — schema, Q&amp;A layers,
        and answer-ready content — within 30 days.
      </p>
      <div class="next-ctas">
        <a href="/conference-aeo" class="btn-primary">Scope my Sprint</a>
        <a href="/visibility-engine" class="btn-outline">See the Engine</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('scorecard-form') as HTMLFormElement | null;
  const wrap = document.getElementById('scorecard-form-wrap');
  if (form && wrap) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        wrap.innerHTML =
          '<p class="form-thanks">Thanks — we\'ll send your Scorecard within one business day.</p>';
      } catch {
        form.submit();
      }
    });
  }
</script>

<style>
  .honeypot { position: absolute; left: -9999px; }

  .form-thanks {
    font-size: 13px;
    color: var(--navy);
    line-height: 1.55;
    padding: 12px 0;
  }

  /* ── Hero ───────────────────────────────────── */
  .page-hero {
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 48px 22px 40px;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .page-h1 {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    font-family: var(--font-sans);
  }

  .page-lede {
    font-size: 14px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 540px;
    margin: 0 auto 28px;
  }

  /* Step indicator */
  .steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .step-num {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber-pale);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }

  .step-label {
    font-size: 11px;
    color: var(--blue-mid);
    font-weight: 400;
  }

  .step-arrow {
    color: var(--amber);
    font-size: 13px;
    opacity: 0.5;
  }

  /* ── Report preview section ─────────────────── */
  .preview-section {
    background: var(--cream-deep);
    padding: 40px 22px;
  }

  .preview-wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  .preview-intro {
    margin-bottom: 24px;
  }

  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 0;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-family: var(--font-sans);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 28px;
    align-items: start;
  }

  /* Report shell — mimics tool's dark bg */
  .report-shell {
    background: var(--navy-deep);
    border-radius: 8px;
    padding: 20px;
    position: relative;
  }

  .report-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-family: var(--font-mono);
    text-transform: uppercase;
    background: rgba(186,117,23,0.14);
    border: 0.5px solid rgba(186,117,23,0.3);
    border-radius: 3px;
    padding: 3px 7px;
    margin-bottom: 12px;
  }

  .report-card {
    background: #fff;
    border-radius: 8px;
    padding: 20px 22px;
  }

  .rc-eyebrow {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--amber);
    font-family: var(--font-mono);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .rc-meta {
    font-size: 10px;
    color: var(--mute-soft);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .rc-meta-blur {
    filter: blur(3px);
    user-select: none;
    display: inline-block;
  }

  .rc-headline {
    font-size: 17px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
    font-family: var(--font-sans);
  }

  .rc-divider {
    height: 0.5px;
    background: rgba(4,44,83,0.08);
    margin-bottom: 14px;
  }

  .rc-score-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .rc-circle {
    position: relative;
    flex-shrink: 0;
    width: 84px;
    height: 84px;
  }

  .rc-score-val {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .rc-score-num {
    font-size: 22px;
    font-weight: 500;
    color: var(--amber);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .rc-score-den {
    font-size: 9px;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 1px;
  }

  .rc-score-text {
    flex: 1;
  }

  .rc-score-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .rc-score-verdict {
    font-size: 12px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.4;
    margin-bottom: 8px;
    font-family: var(--font-sans);
  }

  .rc-band {
    display: inline-block;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--amber);
    font-family: var(--font-mono);
    background: var(--amber-light);
    border: 0.5px solid rgba(186,117,23,0.25);
    border-radius: 3px;
    padding: 3px 7px;
  }

  /* Report items (right col) */
  .preview-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .report-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 22px;
  }

  .ri {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .ri-num {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    padding-top: 1px;
  }

  .ri-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--navy);
    display: block;
    margin-bottom: 3px;
    font-family: var(--font-sans);
  }

  .ri-body {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.5;
  }

  .btn-start {
    display: inline-block;
    background: var(--amber);
    color: var(--amber-light);
    padding: 11px 20px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease;
    align-self: flex-start;
    font-family: var(--font-sans);
  }

  .btn-start:hover { background: #854F0B; }

  .btn-sub {
    font-size: 10px;
    color: var(--mute-soft);
    margin-top: 7px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  /* ── Trust strip ────────────────────────────── */
  .trust-strip {
    background: var(--cream);
    border-top: 0.5px solid var(--line);
    border-bottom: 0.5px solid var(--line);
    padding: 12px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .trust-label {
    font-size: 10px;
    color: var(--muted);
    white-space: nowrap;
  }

  .trust-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pill {
    font-size: 10px;
    font-weight: 500;
    color: var(--navy);
    background: #fff;
    border: 0.5px solid var(--line);
    border-radius: 3px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  /* ── Tool embed ─────────────────────────────── */
  .embed-section {
    background: var(--navy);
    padding: 32px 22px 36px;
    scroll-margin-top: 60px;
  }

  .embed-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .embed-eyebrow {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .embed-title {
    font-size: 19px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 8px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-family: var(--font-sans);
  }

  .embed-sub {
    font-size: 12px;
    color: var(--blue-soft);
    line-height: 1.5;
    max-width: 500px;
    margin: 0 auto;
  }

  .snapshot-frame {
    width: 100%;
    min-height: 820px;
    border: none;
    border-radius: 8px;
    display: block;
  }

  /* ── Shared section ─────────────────────────── */
  .section {
    padding: 32px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── "What it covers" cards ─────────────────── */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .card {
    background: #fff;
    border: 0.5px solid var(--line);
    border-radius: 8px;
    padding: 16px;
  }

  .card-num {
    font-size: 10px;
    color: var(--amber);
    font-weight: 500;
    margin-bottom: 6px;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .card-title {
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--navy);
    font-family: var(--font-sans);
  }

  .card-body {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Manual form ────────────────────────────── */
  .form-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .form-sub {
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    margin-top: 6px;
  }

  .request-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .f-label {
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 4px;
    display: block;
    font-family: var(--font-sans);
  }

  .f-input {
    width: 100%;
    border: 0.5px solid rgba(4,44,83,0.18);
    border-radius: 4px;
    padding: 8px 10px;
    font-size: 11px;
    margin-bottom: 10px;
    background: #fff;
    color: var(--navy);
    box-sizing: border-box;
    font-family: var(--font-sans);
    transition: border-color 0.2s ease;
  }

  .f-input:focus {
    outline: none;
    border-color: var(--amber);
  }

  .f-btn {
    width: 100%;
