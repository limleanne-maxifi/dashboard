---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Visibility Snapshot | Maxifi Digital"
  description="Get your free AI Visibility Snapshot. See how ChatGPT, Perplexity, Claude, Gemini and Google AI are citing — or ignoring — your brand right now."
  currentPage="/visibility-snapshot"
>

  <!-- ══════════════════════════════════════════
       SEE A REAL ONE — INDUSTRY PREVIEW
  ══════════════════════════════════════════ -->
  <section class="preview-section" aria-labelledby="preview-heading">
    <div class="preview-wrap">
      <p class="preview-eyebrow">SEE YOUR VISIBILITY LIVE</p>
      <h2 id="preview-heading" class="preview-title">
        This is what your AI Visibility Snapshot looks like.
      </h2>
      <p class="preview-sub">
        Real client. Real scores. Real fixes. Pick your industry to see both the form and the report.
      </p>

      <div class="preview-tabs" role="tablist" aria-label="Industry preview">
        <button class="preview-tab is-active" role="tab" aria-selected="true" data-tab="commercial">Commercial Aviation</button>
        <button class="preview-tab" role="tab" aria-selected="false" data-tab="manufacturing">Aerospace Manufacturing</button>
        <button class="preview-tab" role="tab" aria-selected="false" data-tab="space">Space Exploration</button>
        <button class="preview-tab" role="tab" aria-selected="false" data-tab="mro">MRO</button>
      </div>

      <div class="preview-card">
        <!-- LEFT: mock form -->
        <div class="preview-left">
          <div class="preview-left-head">
            <p class="preview-left-eyebrow">AI VISIBILITY SNAPSHOT</p>
            <p class="preview-left-industry" data-fill="industryName">Commercial Aviation</p>
          </div>
          <div class="preview-form">
            <div class="preview-form-fields">
              <p class="mock-label">YOUR WEBSITE</p>
              <p class="mock-input" data-fill="website">yourcompany.com</p>

              <p class="mock-label" data-fill="specialismLabel">YOUR AVIATION SPECIALISM</p>
              <p class="mock-input" data-fill="specialism">e.g. CNS/ATM, airport ops, MRO</p>

              <p class="mock-label">A BUYER QUESTION YOU SHOULD WIN</p>
              <p class="mock-input" data-fill="question">e.g. Who are the leading CNS/ATM providers in Europe?</p>
            </div>
            <a
              class="mock-btn"
              href="https://visibilityview.netlify.app/"
              target="_blank"
              rel="noopener noreferrer"
            >Get my AI Visibility Snapshot →</a>
          </div>
        </div>

        <!-- RIGHT: sample report -->
        <div class="preview-right">
          <div class="report-head">
            <span class="report-tag"><span class="report-dot"></span>SAMPLE REPORT</span>
            <span class="report-industry" data-fill="industryPill">COMMERCIAL AVIATION</span>
          </div>

          <p class="report-client" data-fill="clientName">EU REGIONAL CARRIER · Q2 2026</p>
          <p class="report-headline" data-fill="headline">Citation share at 11%. 3 fixes to reach 34% by Q4.</p>

          <div class="report-metrics">
            <div class="metric">
              <p class="metric-val" data-fill="m1v">19 → 38%</p>
              <p class="metric-lbl">AI Citations</p>
            </div>
            <div class="metric">
              <p class="metric-val" data-fill="m2v">2/5</p>
              <p class="metric-lbl">Engines Citing</p>
            </div>
            <div class="metric">
              <p class="metric-val" data-fill="m3v">4/12</p>
              <p class="metric-lbl">Topics Owned</p>
            </div>
          </div>

          <div class="report-fixes-head">
            <span class="fixes-label">TOP 3 PRIORITY FIXES</span>
            <span class="fixes-rank">RANKED BY IMPACT</span>
          </div>

          <ol class="report-fixes">
            <li>
              <span class="fix-num">1</span>
              <div class="fix-body">
                <p class="fix-text" data-fill="fix1t">CNS/ATM capability comparison page</p>
                <p class="fix-meta" data-fill="fix1m">Estimated citation lift: +19% · 2 weeks</p>
              </div>
            </li>
            <li>
              <span class="fix-num">2</span>
              <div class="fix-body">
                <p class="fix-text" data-fill="fix2t">EASA &amp; EUROCONTROL entity build-out</p>
                <p class="fix-meta" data-fill="fix2m">Estimated citation lift: +11% · 1 week</p>
              </div>
            </li>
            <li>
              <span class="fix-num">3</span>
              <div class="fix-body">
                <p class="fix-text" data-fill="fix3t">Regional vs network ATM model FAQ</p>
                <p class="fix-meta" data-fill="fix3m">Estimated citation lift: +8% · 3 days</p>
              </div>
            </li>
          </ol>

          <p class="report-view">View full report →</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT YOU GET
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="what-heading">
    <p class="s-eyebrow">WHAT'S INCLUDED</p>
    <h2 id="what-heading" class="section-h2">What your Snapshot covers</h2>
    <div class="cards">
      <article class="card">
        <p class="card-num">01</p>
        <h3 class="card-title">Citation audit</h3>
        <p class="card-body">
          Which AI engines mention your brand today, which queries surface you,
          and where competitors are named instead.
        </p>
      </article>
      <article class="card">
        <p class="card-num">02</p>
        <h3 class="card-title">Structural gaps</h3>
        <p class="card-body">
          The specific content, schema and entity signals that are preventing
          retrieval — ranked by leverage.
        </p>
      </article>
      <article class="card">
        <p class="card-num">03</p>
        <h3 class="card-title">Three quick wins</h3>
        <p class="card-body">
          Actionable fixes your team can implement this week to lift citation
          rate before the next buyer search.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WANT MORE? — MANUAL SCORECARD FORM
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="form-heading">
    <div class="form-wrap">
      <div class="form-text">
        <p class="s-eyebrow">PREFER A HUMAN EYE?</p>
        <h2 id="form-heading" class="section-h2" style="max-width:360px;">
          Request a manual Scorecard review
        </h2>
        <p class="form-sub">
          Submit your site and we'll do the AI citation checks by hand and send
          you a written report within one business day.
        </p>
      </div>
      <div id="scorecard-form-wrap">
        <form
          name="visibility-scorecard"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="scorecard-form"
          class="request-form"
        >
          <input type="hidden" name="form-name" value="visibility-scorecard" />
          <input type="hidden" name="source-page" value="visibility-snapshot" />
          <p class="honeypot" aria-hidden="true">
            <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="f-label" for="sc-website">Your website</label>
          <input
            class="f-input"
            type="text"
            id="sc-website"
            name="website"
            placeholder="acmeconsulting.com"
            required
          />

          <label class="f-label" for="sc-category">Your category</label>
          <input
            class="f-input"
            type="text"
            id="sc-category"
            name="category"
            placeholder="e.g. Management consulting"
            required
          />

          <label class="f-label" for="sc-question">A question your buyer would ask AI</label>
          <input
            class="f-input"
            type="text"
            id="sc-question"
            name="buyer-question"
            placeholder="e.g. Best firm for healthcare M&amp;A"
            required
          />

          <label class="f-label" for="sc-email">Your work email</label>
          <input
            class="f-input"
            type="email"
            id="sc-email"
            name="email"
            placeholder="you@company.com"
            required
          />

          <button type="submit" class="f-btn">Send my Scorecard request →</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       NEXT STEP — SPRINT CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="next-heading">
    <div class="next-box">
      <p class="s-eyebrow next-eyebrow">WHAT COMES NEXT</p>
      <h2 id="next-heading" class="next-title">
        Ready to go further than a Snapshot?
      </h2>
      <p class="next-body">
        The Sprint turns your gaps into shipped assets — schema, Q&amp;A layers,
        and answer-ready content — within 30 days.
      </p>
      <div class="next-ctas">
        <a href="/conference-aeo" class="btn-primary">Scope my Sprint</a>
        <a href="/visibility-engine" class="btn-outline">See the Engine</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ── Industry preview tab swap ─────────────────
  type Industry = {
    industryName: string;
    industryPill: string;
    website: string;
    specialism: string;
    question: string;
    specialismLabel: string;
    clientName: string;
    headline: string;
    m1v: string;
    m2v: string;
    m3v: string;
    fix1t: string; fix1m: string;
    fix2t: string; fix2m: string;
    fix3t: string; fix3m: string;
  };

  const industries: Record<string, Industry> = {
    commercial: {
      industryName: 'Commercial Aviation',
      industryPill: 'COMMERCIAL AVIATION',
      website: 'yourcompany.com',
      specialismLabel: 'YOUR AVIATION SPECIALISM',
      specialism: 'e.g. CNS/ATM, airport ops, MRO',
      question: 'e.g. Who are the leading CNS/ATM providers in Europe?',
      clientName: 'PAN-EUROPEAN ANSP · Q2 2026',
      headline: 'Citation share at 22%. 3 fixes to reach 48% by Q4.',
      m1v: '19 → 38%', m2v: '2/5', m3v: '4/12',
      fix1t: 'CNS/ATM capability comparison page', fix1m: 'Estimated citation lift: +19% · 2 weeks',
      fix2t: 'EASA & EUROCONTROL entity build-out', fix2m: 'Estimated citation lift: +11% · 1 week',
      fix3t: 'Regional vs network ATM model FAQ', fix3m: 'Estimated citation lift: +8% · 3 days',
    },
    manufacturing: {
      industryName: 'Aerospace Manufacturing',
      industryPill: 'AEROSPACE MANUFACTURING',
      website: 'yourcompany.com',
      specialismLabel: 'YOUR MANUFACTURING FOCUS',
      specialism: 'e.g. composites, additive parts, avionics',
      question: 'e.g. Best Tier-2 supplier for titanium structural parts?',
      clientName: 'UK TIER-2 SUPPLIER · Q2 2026',
      headline: 'Citation share at 14%. 3 fixes to reach 41% by Q4.',
      m1v: '12 → 33%', m2v: '1/5', m3v: '3/12',
      fix1t: 'Ti-6Al-4V capability landing page', fix1m: 'Estimated citation lift: +14% · 2 weeks',
      fix2t: 'AS9100 & NADCAP entity signals', fix2m: 'Estimated citation lift: +10% · 1 week',
      fix3t: 'Build-to-print vs build-to-spec FAQ', fix3m: 'Estimated citation lift: +7% · 4 days',
    },
    space: {
      industryName: 'Space Exploration',
      industryPill: 'SPACE EXPLORATION',
      website: 'yourcompany.com',
      specialismLabel: 'YOUR SPACE SPECIALISM',
      specialism: 'e.g. launch services, smallsats, propulsion',
      question: 'e.g. Best LEO small satellite launch provider?',
      clientName: 'EU SMALLSAT INTEGRATOR · Q2 2026',
      headline: 'Citation share at 14%. 3 fixes to reach 38% by Q4.',
      m1v: '9 → 28%', m2v: '1/5', m3v: '2/12',
      fix1t: 'LEO rideshare deployment service page', fix1m: 'Estimated citation lift: +17% · 2 weeks',
      fix2t: 'ESA & EU Space Programme entity build', fix2m: 'Estimated citation lift: +11% · 1 week',
      fix3t: 'SpaceX Transporter vs alternatives FAQ', fix3m: 'Estimated citation lift: +9% · 3 days',
    },
    mro: {
      industryName: 'MRO',
      industryPill: 'MRO',
      website: 'yourcompany.com',
      specialismLabel: 'YOUR MRO SPECIALISM',
      specialism: 'e.g. heavy maintenance, engine overhaul, AOG',
      question: 'e.g. Best MRO for A320neo heavy checks in Europe?',
      clientName: 'EU INDEPENDENT MRO · Q2 2026',
      headline: 'Citation share at 18%. 3 fixes to reach 43% by Q4.',
      m1v: '15 → 35%', m2v: '2/5', m3v: '3/12',
      fix1t: 'A320neo heavy-check capability hub', fix1m: 'Estimated citation lift: +13% · 2 weeks',
      fix2t: 'Part-145 & EASA entity build-out', fix2m: 'Estimated citation lift: +10% · 1 week',
      fix3t: 'AOG response time benchmarks FAQ', fix3m: 'Estimated citation lift: +7% · 3 days',
    },
  };

  const tabs = document.querySelectorAll<HTMLButtonElement>('.preview-tab');
  const fillNodes = document.querySelectorAll<HTMLElement>('[data-fill]');
  const orderedKeys = ['commercial', 'manufacturing', 'space', 'mro'];

  function applyIndustry(key: string) {
    const data = industries[key];
    if (!data) return;
    fillNodes.forEach((node) => {
      const k = node.dataset.fill as keyof Industry;
      if (k && data[k] !== undefined) node.textContent = data[k];
    });
  }

  function activateTab(key: string) {
    tabs.forEach((t) => {
      const isActive = t.dataset.tab === key;
      t.classList.toggle('is-active', isActive);
      t.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
    applyIndustry(key);
  }

  // Auto-rotate through industries; user click pauses the rotation.
  let rotateIdx = 0;
  let rotateTimer: ReturnType<typeof setInterval> | null = null;

  function startRotate() {
    if (rotateTimer) return;
    rotateTimer = setInterval(() => {
      rotateIdx = (rotateIdx + 1) % orderedKeys.length;
      activateTab(orderedKeys[rotateIdx]);
    }, 4500);
  }

  function stopRotate() {
    if (rotateTimer) {
      clearInterval(rotateTimer);
      rotateTimer = null;
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      stopRotate();
      const key = tab.dataset.tab;
      if (key) {
        rotateIdx = orderedKeys.indexOf(key);
        activateTab(key);
      }
    });
  });

  startRotate();

  // ── Scorecard form submit ─────────────────────
  const form = document.getElementById('scorecard-form') as HTMLFormElement | null;
  const wrap = document.getElementById('scorecard-form-wrap');
  if (form && wrap) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        wrap.innerHTML =
          '<p class="form-thanks">Thanks — we\'ll send your Scorecard within one business day.</p>';
      } catch {
        form.submit();
      }
    });
  }
</script>

<style>
  .honeypot { position: absolute; left: -9999px; }

  .form-thanks {
    font-size: 13px;
    color: var(--navy);
    line-height: 1.55;
    padding: 12px 0;
  }

  /* ── See your visibility live (industry preview) ── */
  .preview-section {
    background: var(--cream);
    padding: 64px 22px 56px;
  }

  .preview-wrap {
    max-width: 1080px;
    margin: 0 auto;
  }

  .preview-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
    font-weight: 500;
    text-align: center;
    margin-bottom: 12px;
  }

  .preview-title {
    font-size: 24px;
    font-weight: 500;
    color: var(--navy);
    text-align: center;
    line-height: 1.22;
    letter-spacing: -0.015em;
    margin: 0 auto 10px;
    max-width: 720px;
  }

  .preview-sub {
    font-size: 12px;
    color: var(--muted);
    text-align: center;
    line-height: 1.55;
    max-width: 560px;
    margin: 0 auto 28px;
  }

  .preview-tabs {
    display: flex;
    gap: 0;
    border-bottom: 0.5px solid var(--line);
    margin-bottom: 0;
    overflow-x: auto;
  }

  .preview-tab {
    background: transparent;
    border: none;
    padding: 12px 18px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .preview-tab:hover { color: var(--navy); }

  .preview-tab.is-active {
    color: var(--navy);
    border-bottom-color: var(--navy);
  }

  .preview-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: stretch;
    gap: 0;
    background: var(--navy-deep);
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
  }

  /* LEFT */
  .preview-left {
    display: flex;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
  }

  .preview-left-head {
    background: var(--amber);
    color: var(--amber-light);
    padding: 14px 22px 14px;
  }

  .preview-left-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    letter-spacing: 0.14em;
    font-weight: 500;
    color: var(--amber-light);
    margin-bottom: 4px;
    opacity: 0.9;
    text-transform: uppercase;
  }

  .preview-left-industry {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: var(--amber-light);
    letter-spacing: -0.01em;
  }

  .preview-form {
    padding: 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .preview-form-fields { flex: 1; }

  .mock-label {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 500;
    color: var(--amber-pale);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .mock-input {
    font-family: 'Inter', sans-serif;
    background: rgba(255,255,255,0.04);
    border: 0.5px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 9px 11px;
    font-size: 11px;
    color: var(--blue-soft);
    margin-bottom: 14px;
  }

  .mock-btn {
    display: block;
    text-align: center;
    background: var(--amber);
    color: var(--amber-light);
    padding: 11px 14px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    margin-top: 8px;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .mock-btn:hover { background: #854F0B; }

  /* RIGHT */
  .preview-right {
    background: #fff;
    padding: 22px 24px 18px;
    color: var(--navy);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .report-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .report-tag {
    font-size: 9px;
    letter-spacing: 0.14em;
    font-weight: 500;
    color: var(--navy);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .report-dot {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    display: inline-block;
  }

  .report-industry {
    font-size: 9px;
    letter-spacing: 0.12em;
    font-weight: 500;
    background: var(--amber-light);
    color: var(--brown-deep);
    padding: 4px 8px;
    border-radius: 3px;
  }

  .report-client {
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--amber);
    margin-bottom: 6px;
  }

  .report-headline {
    font-size: 13px;
    line-height: 1.4;
    color: var(--navy);
    font-weight: 500;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .report-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 10px 0 14px;
    border-bottom: 0.5px solid var(--line);
    margin-bottom: 14px;
  }

  .metric-val {
    font-size: 15px;
    font-weight: 500;
    color: var(--navy);
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  .metric-lbl {
    font-size: 10px;
    color: var(--muted);
  }

  .report-fixes-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .fixes-label {
    font-size: 9px;
    letter-spacing: 0.14em;
    font-weight: 500;
    color: var(--navy);
  }

  .fixes-rank {
    font-size: 8px;
    letter-spacing: 0.12em;
    font-weight: 500;
    background: var(--cream-deep);
    color: var(--muted);
    padding: 3px 7px;
    border-radius: 3px;
  }

  .report-fixes {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    flex: 1;
  }

  .report-fixes li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 8px;
    align-items: start;
    padding: 8px 0;
    border-bottom: 0.5px solid var(--line);
  }

  .report-fixes li:last-child { border-bottom: none; }

  .fix-num {
    font-size: 11px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.4;
  }

  .fix-body { min-width: 0; }

  .fix-text {
    font-size: 12px;
    color: var(--navy);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 2px;
    letter-spacing: -0.005em;
  }

  .fix-meta {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.4;
  }

  .report-view {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    text-align: right;
    margin-top: auto;
  }

  /* ── Shared section styles ──────────────────── */
  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── What's included cards ──────────────────── */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
