---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Visibility Engine | AEO Retainer | Maxifi Digital"
  description="A quarterly AEO retainer that turns your expertise into a self-compounding citation engine. Snapshot, Sprint, monitor, repeat — across all five AI platforms."
  currentPage="/visibility-engine"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="engine-heading">
    <p class="eyebrow">THE VISIBILITY ENGINE</p>
    <h1 id="engine-heading" class="page-h1">
      AEO isn't a project. It's a system you run every quarter.
    </h1>
    <p class="page-lede">
      AI engines change their retrieval models. New competitors publish. Buyer
      questions shift. The Visibility Engine keeps your brand cited as the
      landscape evolves — without you having to think about it.
    </p>
    <div class="hero-ctas">
      <a href="mailto:hello@maxifidigital.com?subject=Visibility%20Engine%20enquiry&body=I%27d%20like%20to%20learn%20more%20about%20the%20Visibility%20Engine%20retainer." class="btn-primary">
        Enquire about the Engine
      </a>
      <a href="/visibility-snapshot" class="btn-ghost">Start with a Snapshot</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       HOW IT WORKS — QUARTERLY CYCLE
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="cycle-heading">
    <p class="s-eyebrow">HOW IT WORKS</p>
    <h2 id="cycle-heading" class="section-h2">The quarterly cycle</h2>
    <div class="cycle">
      <article class="cycle-step">
        <p class="step-num">Q1</p>
        <h3 class="step-title">Snapshot</h3>
        <p class="step-body">
          Full audit of your citation footprint across all five AI engines.
          Where you're named, where you're missing, and who AI cites instead.
        </p>
      </article>
      <div class="cycle-arrow" aria-hidden="true">→</div>
      <article class="cycle-step">
        <p class="step-num">Q2</p>
        <h3 class="step-title">Sprint</h3>
        <p class="step-body">
          Answer-ready assets shipped: Q&amp;A pairs, schema layers, updated
          positioning copy. All targeting the buyer questions your audit surfaced.
        </p>
      </article>
      <div class="cycle-arrow" aria-hidden="true">→</div>
      <article class="cycle-step">
        <p class="step-num">Q3</p>
        <h3 class="step-title">Monitor</h3>
        <p class="step-body">
          Weekly citation tracking across ChatGPT, Perplexity, Claude, Gemini
          and Google AI. Monthly performance digest sent to your team.
        </p>
      </article>
      <div class="cycle-arrow" aria-hidden="true">→</div>
      <article class="cycle-step">
        <p class="step-num">Q4</p>
        <h3 class="step-title">Repeat</h3>
        <p class="step-body">
          The next Snapshot reveals what moved. The next Sprint builds on
          compounding authority. Your competitive gap widens every quarter.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT'S INCLUDED
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="includes-heading">
    <p class="s-eyebrow">WHAT'S INCLUDED</p>
    <h2 id="includes-heading" class="section-h2">Everything in the Engine</h2>
    <div class="includes">
      <div class="include-group">
        <p class="ig-label">Measurement</p>
        <ul class="ig-list" role="list">
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly AI Visibility Snapshot (5 engines)</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring report</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Competitor citation benchmarking</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Buyer query landscape tracking</li>
        </ul>
      </div>
      <div class="include-group">
        <p class="ig-label">Content production</p>
        <ul class="ig-list" role="list">
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Quarterly answer-ready content Sprint</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Schema + JSON-LD layer maintained</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Q&amp;A pair library (grows each quarter)</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Entity signal updates</li>
        </ul>
      </div>
      <div class="include-group">
        <p class="ig-label">Strategy & access</p>
        <ul class="ig-list" role="list">
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Monthly strategy call (45 min)</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Slack channel access</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>AEO playbook (evolves quarterly)</li>
          <li class="ig-item"><span class="check" aria-hidden="true">✓</span>Cited Brief newsletter (weekly)</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PRICING
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="pricing-heading">
    <p class="s-eyebrow">INVESTMENT</p>
    <h2 id="pricing-heading" class="section-h2">Pricing</h2>
    <div class="pricing-grid">
      <article class="price-card">
        <p class="price-tier">Engine Core</p>
        <p class="price">£5,000<span class="price-mo">/month</span></p>
        <p class="price-note">12-month minimum commitment</p>
        <ul class="price-items" role="list">
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Quarterly Snapshot + Sprint</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Weekly monitoring</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Monthly strategy call</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Slack access</li>
        </ul>
        <a href="mailto:hello@maxifidigital.com?subject=Engine%20Core%20enquiry" class="price-cta price-cta--outline">
          Enquire
        </a>
      </article>
      <article class="price-card price-card--featured">
        <p class="price-tag">MOST POPULAR</p>
        <p class="price-tier">Engine Plus</p>
        <p class="price">£8,500<span class="price-mo">/month</span></p>
        <p class="price-note">12-month minimum commitment</p>
        <ul class="price-items" role="list">
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Everything in Core</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>2× Sprint per quarter</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Executive TL content</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>PR + media placement support</li>
        </ul>
        <a href="mailto:hello@maxifidigital.com?subject=Engine%20Plus%20enquiry" class="price-cta price-cta--primary">
          Enquire
        </a>
      </article>
      <article class="price-card">
        <p class="price-tier">Engine Enterprise</p>
        <p class="price">£12,000<span class="price-mo">/month</span></p>
        <p class="price-note">Custom term</p>
        <ul class="price-items" role="list">
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Everything in Plus</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Dedicated AEO lead</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Multi-brand / multi-market</li>
          <li class="price-item"><span class="check" aria-hidden="true">✓</span>Bespoke reporting dashboard</li>
        </ul>
        <a href="mailto:hello@maxifidigital.com?subject=Engine%20Enterprise%20enquiry" class="price-cta price-cta--outline">
          Enquire
        </a>
      </article>
    </div>
    <p class="pricing-foot">
      All retainers require a one-off Visibility Snapshot (£2,500) before start — or credit
      it against month one if you complete a Sprint first.
    </p>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="engine-cta-heading">
    <div class="cta-box">
      <p class="s-eyebrow cta-eyebrow">START THE ENGINE</p>
      <h2 id="engine-cta-heading" class="cta-title">
        Not sure where to start? Begin with a Snapshot.
      </h2>
      <p class="cta-body">
        The Snapshot is the entry point — it tells you exactly where you stand
        and what a Sprint or Engine would address. No obligation to continue.
      </p>
      <div class="cta-buttons">
        <a href="/visibility-snapshot" class="btn-primary">Get my free Snapshot</a>
        <a href="/conference-aeo" class="btn-outline">See our Sprint offer</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Visibility Engine — AEO Retainer",
    "provider": {
      "@type": "Organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com"
    },
    "description": "A quarterly AEO retainer covering Snapshot audits, content Sprints, citation monitoring and strategy calls across five AI engines.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Engine Core",
        "price": "5000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "5000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Plus",
        "price": "8500",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "8500",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      },
      {
        "@type": "Offer",
        "name": "Engine Enterprise",
        "price": "12000",
        "priceCurrency": "GBP",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "12000",
          "priceCurrency": "GBP",
          "unitText": "month"
        }
      }
    ]
  }
  </script>

</BaseLayout>

<style>
  /* ── Page hero ──────────────────────────────── */
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #E6F1FB;
    padding: 40px 22px 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .page-h1 {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 12px;
    line-height: 1.18;
    font-family: 'Inter', sans-serif;
    max-width: 640px;
  }

  .page-lede {
    font-size: 13px;
    line-height: 1.55;
    color: #B5D4F4;
    max-width: 580px;
    margin: 0 auto 20px;
  }

  .hero-ctas {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Shared ─────────────────────────────────── */
  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── Quarterly cycle ────────────────────────── */
  .cycle {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 8px;
    align-items: start;
  }

  .cycle-arrow {
    padding-top: 32px;
    color: var(--amber);
    font-size: 16px;
    font-weight: 300;
  }

  .cycle-step {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 14px;
  }

  .step-num {
    font-size: 10px;
    color: var(--amber);
    font-weight: 500;
    letter-spacing: 0.08em;
    margin-bottom: 5px;
  }

  .step-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 6px;
    font-family: 'Inter', sans-serif;
  }

  .step-body {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Includes ───────────────────────────────── */
  .includes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .include-group {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 16px;
  }

  .ig-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .ig-list { list-style: none; }

  .ig-item {
    font-size: 11px;
    color: #444441;
    padding: 3px 0;
    display: flex;
    gap: 5px;
    align-items: baseline;
    line-height: 1.4;
  }

  .check {
    color: var(--signal);
    font-weight: 500;
    flex-shrink: 0;
  }

  /* ── Pricing ────────────────────────────────── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 14px;
  }

  .price-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .price-card--featured { border: 2px solid var(--amber); }

  .price-tag {
    font-size: 9px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .price-tier {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 4px;
    font-family: 'Inter', sans-serif;
  }

  .price {
    font-size: 22px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.1;
    font-family: 'Inter', sans-serif;
  }

  .price-mo {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .price-note {
    font-size: 10px;
    color: #888780;
    margin-bottom: 12px;
    margin-top: 2px;
  }

  .price-items { list-style: none; flex: 1; margin-bottom: 12px; }

  .price-item {
    font-size: 11px;
    color: #444441;
    padding: 3px 0;
    display: flex;
    gap: 5px;
    line-height: 1.4;
  }

  .price-cta {
    display: block;
    text-align: center;
    padding: 9px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-cta--primary { background: var(--amber); color: #FAEEDA; }
  .price-cta--primary:hover { background: #854F0B; }

  .price-cta--outline {
    border: 0.5px solid rgba(4, 44, 83, 0.22);
    color: #042C53;
  }

  .price-cta--outline:hover { background: var(--navy); color: #fff; }

  .pricing-foot {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.55;
  }

  /* ── CTA box ────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 34px 22px;
    text-align: center;
    color: #E6F1FB;
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 21px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .cta-body {
    font-size: 12px;
    line-height: 1.55;
    color: #B5D4F4;
    max-width: 460px;
    margin: 0 auto 18px;
  }

  .cta-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Shared buttons ─────────────────────────── */
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-ghost {
    background: transparent;
    color: #E6F1FB;
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-ghost:hover { border-color: rgba(255, 255, 255, 0.6); }

  .btn-outline {
    background: transparent;
    color: #E6F1FB;
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: rgba(255, 255, 255, 0.6); }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .page-h1 { font-size: 24px; }

    .cycle {
      grid-template-columns: 1fr;
    }

    .cycle-arrow { display: none; }

    .includes,
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-ghost, .btn-outline, .price-cta {
      transition-duration: 0.01ms;
    }
  }
</style>
