---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/sections/CompareTable.astro';
import BenefitGrid from '../components/sections/BenefitGrid.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const tocItems = [
  { label: 'What is AEO', href: '#what' },
  { label: 'SEO vs AEO', href: '#vs' },
  { label: 'Benefits', href: '#benefits' },
  { label: 'Case proof', href: '#proof' },
  { label: 'Your next step', href: '#next' },
];

const definitionCards = [
  {
    label: 'Retrieval',
    title: 'Engines cite, not crawl',
    description:
      "AI engines pull short citations into a generated answer. Ranked pages and meta tags are no longer the unit of distribution — answer-formatted blocks are.",
  },
  {
    label: 'Structure',
    title: 'Schema is the new keyword',
    description:
      'Entities, Q&A pairs, FAQ schema, organisation markup. These are what an LLM\'s retrieval layer reaches for first.',
  },
  {
    label: 'Authority',
    title: 'Citations compound',
    description:
      'Once an engine cites you on a buyer question, you become the default answer. Every uncited answer is a competitor\'s earned trust moment.',
  },
];
---

<BaseLayout
  title="Understand AEO · The evolution beyond SEO · Maxifi Digital"
  description="AEO — Answer Engine Optimisation — is how expert-led brands get cited by ChatGPT, Claude, Copilot, Gemini and Perplexity. The evolution beyond SEO."
  currentPage="/aeo"
>

  <!-- Hero Section -->
  <section class="aeo-hero">
    <div class="wrap aeo-hero__inner">
      <span class="eyebrow aeo-eyebrow--brown" style="margin-bottom: 18px;">The category · AEO</span>
      <h1 class="aeo-hero__h1">
        SEO got you ranked. <em>AEO gets you cited.</em>
      </h1>
      <p class="aeo-hero__lede">
        Answer Engine Optimisation is the discipline of becoming a source AI
        engines retrieve, understand, and quote by name. Different distribution
        layer, different unit of content, different optimisation playbook.
      </p>
      <div class="aeo-hero__meta">
        <span><span class="aeo-meta__dot"></span>8 minute read</span>
        <span><span class="aeo-meta__dot"></span>Maxifi · The Category Brief</span>
        <span><span class="aeo-meta__dot"></span>Updated May 2026</span>
      </div>
    </div>
  </section>

  <!-- Section 02: SEO vs AEO -->
  <section id="vs" class="aeo-section aeo-section--alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown" style="margin-bottom: 14px;">01 · The comparison</span>
        <h2>The shift, in two columns.</h2>
        <p>
          SEO and AEO are not competing strategies. AEO is what SEO became when
          retrieval replaced ranking as the distribution layer.
        </p>
      </div>
      <CompareTable />
    </div>
  </section>

  <!-- Section 01: What is AEO -->
  <section id="what" class="aeo-section">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown" style="margin-bottom: 14px;">02 · The definition</span>
        <h2>AEO is how AI amplifies <em>your authority.</em></h2>
        <p>
          Every retrieval-augmented engine — ChatGPT, Claude, Copilot, Gemini,
          Perplexity — answers buyer questions by citing sources. AEO is the
          discipline of becoming a source that's structured, schema-tagged, and
          answer-formatted so those engines find you, understand you, and quote
          you by name.
        </p>
      </div>
      <div class="grid-3">
        {definitionCards.map((card) => (
          <div class="card">
            <span class="card__label">{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Benefits -->
  <section id="benefits" class="aeo-section">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown" style="margin-bottom: 14px;">03 · The benefits</span>
        <h2>What AEO actually does <em>for your pipeline.</em></h2>
      </div>
      <BenefitGrid />
    </div>
  </section>

  <!-- Section 04: Next Step -->
  <section id="next" class="aeo-nextstep">
    <div class="wrap aeo-nextstep__inner">
      <div>
        <span class="eyebrow aeo-eyebrow--default" style="margin-bottom: 14px;">Your next step</span>
        <h2>See where AI cites you <em>today.</em></h2>
        <p>
          Start with a free, 5-minute visibility audit. We test your category
          questions across the five engines and email you the results.
        </p>
      </div>
      <div class="aeo-nextstep__ctas">
        <a href="/visibility-snapshot" class="btn btn--hero btn--primary">
          Get your Snapshot →
        </a>
        <a href="/work" class="btn btn--hero btn--ghost-light">
          Book a consultation
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA
    heading="When your buyers ask AI who to trust — <em>be the answer.</em>"
    primaryLabel="Check My AI Visibility →"
    primaryHref="/visibility-snapshot"
    secondaryLabel="See a Live Example →"
    secondaryHref="https://aswhub.maxifidigital.com/"
    secondaryExternal={true}
  />

</BaseLayout>

<style>
  .aeo-hero {
    padding: 88px 0 72px;
    background: var(--navy);
    color: white;
  }

  .aeo-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .aeo-hero__h1 {
    font-size: 44px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    font-weight: 500;
    color: white;
  }

  .aeo-hero__h1 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .aeo-hero__lede {
    font: 400 14px/1.55 var(--font-sans);
    color: var(--blue-soft);
    max-width: 680px;
    margin: 0;
  }

  .aeo-hero__meta {
    display: flex;
    gap: 18px;
    margin-top: 20px;
    font: 400 11px/1 var(--font-mono);
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    flex-wrap: wrap;
  }

  .aeo-hero__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .aeo-meta__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--blue-mid);
    display: inline-block;
  }

  .aeo-eyebrow--brown {
    color: var(--amber-mid);
  }

  .aeo-eyebrow--default {
    color: var(--amber-mid);
  }

  .aeo-section {
    padding: 80px 0;
    background: var(--navy-deep);
    color: var(--blue-soft);
  }

  .aeo-section h2 {
    color: white;
  }

  .aeo-section h3 {
    color: white;
  }

  .aeo-section--alt {
    background: var(--navy);
  }

  .aeo-section .sec-head {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .aeo-section .sec-head h2 {
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: white;
  }

  .aeo-section .sec-head h2 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .aeo-section .sec-head p {
    color: var(--blue-soft);
    margin-top: 12px;
    max-width: 600px;
  }

  .card__label {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
  }

  .aeo-nextstep {
    background: var(--navy-deep);
    padding: 80px 0;
    color: var(--blue-soft);
  }

  .aeo-nextstep__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1.4fr auto;
    gap: 40px;
    align-items: center;
  }

  .aeo-nextstep h2 {
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: white;
  }

  .aeo-nextstep h2 em {
    color: var(--amber-mid);
    font-style: italic;
    font-weight: 500;
  }

  .aeo-nextstep p {
    color: var(--blue-soft);
    margin-top: 10px;
    max-width: 540px;
    margin-bottom: 0;
  }

  .aeo-nextstep__ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .aeo-hero {
      padding: 64px 0 48px;
    }

    .aeo-hero__h1 {
      font-size: 32px;
    }

    .aeo-section {
      padding: 48px 0;
    }

    .aeo-nextstep {
      padding: 48px 0;
    }

    .aeo-nextstep__inner {
      grid-template-columns: 1fr;
    }

    .aeo-nextstep__ctas {
      justify-content: flex-start;
    }
  }
</style>
