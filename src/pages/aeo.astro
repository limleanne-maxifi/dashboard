---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/sections/CompareTable.astro';
import BenefitGrid from '../components/sections/BenefitGrid.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const definitionCards = [
  {
    label: 'Retrieval',
    title: 'Engines cite, not crawl',
    description:
      "AI engines pull short citations into a generated answer. Ranked pages and meta tags are no longer the unit of distribution — answer-formatted blocks are.",
  },
  {
    label: 'Structure',
    title: 'Schema is the new keyword',
    description:
      'Entities, Q&A pairs, FAQ schema, organisation markup. These are what an LLM\'s retrieval layer reaches for first.',
  },
  {
    label: 'Authority',
    title: 'Citations compound',
    description:
      'Once an engine cites you on a buyer question, you become the default answer. Every uncited answer is a competitor\'s earned trust moment.',
  },
];
---

<BaseLayout
  title="Get cited by AI engines | AEO vs SEO — Maxifi Digital"
  description="Answer Engine Optimisation (AEO) is how expert-led brands become cited sources in ChatGPT, Claude, Perplexity, Gemini and Copilot answers. Learn the evolution beyond SEO."
  currentPage="/aeo"
  ogImageAlt="Get cited by AI engines — Answer Engine Optimisation (AEO)"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Answer Engine Optimisation (AEO)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimisation (AEO) is the practice of structuring a brand's content, expertise, and digital presence so that AI engines — including ChatGPT, Perplexity, Google AI Overviews, Microsoft Copilot, and Anthropic Claude — surface that brand as a cited source when buyers ask category questions. Unlike traditional SEO, which targets ranked link positions, AEO targets citation and attribution in AI-generated answers. It is the emerging discipline for brands that want to remain visible as search behaviour shifts from keyword queries to conversational AI prompts."
      }
    },
    {
      "@type": "Question",
      "name": "How is AEO different from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO optimises for search engine result page rankings — getting a link clicked. AEO optimises for AI citation — getting your brand named as the answer. AI engines do not rank ten blue links; they synthesise a single response and attribute it to sources they judge authoritative, structured, and entity-clear. A brand can rank highly on Google and still be invisible in AI responses if its content is not structured for machine comprehension. AEO closes that gap."
      }
    },
    {
      "@type": "Question",
      "name": "What does AEO do for my pipeline?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AEO places your brand inside the answers buyers receive when they research vendors, solutions, and expertise in AI tools before a purchase decision. Buyers who encounter your brand as a cited AI source arrive with higher intent and pre-established trust than those who find you through a paid ad or an organic link. Over time, consistent citation compounds: the more AI engines associate your brand with a topic, the more frequently they surface it — without additional spend per impression."
      }
    },
    {
      "@type": "Question",
      "name": "How do citations compound?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI engines build associative models: the more a brand is cited in relation to a topic, the stronger that association becomes in the model's weighting. Each piece of structured, authoritative content that earns a citation reinforces the brand-topic relationship across future queries. This compounding effect means early AEO investment generates disproportionate long-term returns compared to paid channels that switch off when spend stops."
      }
    },
    {
      "@type": "Question",
      "name": "What engines does AEO target?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maxifi Digital's AEO work targets the five AI engines that account for the majority of B2B buyer research activity: ChatGPT (OpenAI), Perplexity AI, Google AI Overviews (Gemini), Microsoft Copilot (Bing), and Anthropic Claude. Each engine has distinct retrieval logic, content weighting, and citation behaviour. An effective AEO strategy structures content to satisfy the common requirements across all five rather than optimising for a single engine."
      }
    }
  ]
}</script>
    <script type="application/ld+json" is:inline>{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Answer Engine Optimisation (AEO): What It Is and Why It Matters for Expert-Led Brands",
  "description": "AEO — Answer Engine Optimisation — is how expert-led brands get cited by ChatGPT, Claude, Copilot, Gemini and Perplexity. The evolution beyond SEO.",
  "url": "https://maxifidigital.com/aeo",
  "datePublished": "2026-01-01",
  "dateModified": "2026-05-01",
  "author": {
    "@type": "Person",
    "name": "Lim Le-Anne",
    "alternateName": "Le-Anne Lim",
    "sameAs": ["https://www.linkedin.com/in/limleanne/"]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Maxifi Digital",
    "url": "https://maxifidigital.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://maxifidigital.com/logos/maxifi-logo-black.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://maxifidigital.com/aeo"
  }
}</script>
  </Fragment>

  <!-- Hero Section -->
  <section class="aeo-hero">
    <div class="wrap aeo-hero__inner">
      <span class="eyebrow aeo-eyebrow--brown aeo-hero__eyebrow">The category · AEO</span>
      <h1 class="aeo-hero__h1">
        SEO got you ranked. <em>AEO gets you cited.</em>
      </h1>
      <p class="aeo-hero__lede">
        Answer Engine Optimisation is the discipline of becoming a source AI
        engines retrieve, understand, and quote by name. Different distribution
        layer, different unit of content, different optimisation playbook.
      </p>
      <div class="aeo-hero__meta">
        <span><span class="aeo-meta__dot"></span>8 minute read</span>
        <span><span class="aeo-meta__dot"></span>Maxifi · The Category Brief</span>
        <span><span class="aeo-meta__dot"></span>Updated May 2026</span>
      </div>
    </div>
  </section>

  <!-- Section 01: SEO vs AEO -->
  <section id="vs" class="aeo-section aeo-section--alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown">01 · The comparison</span>
        <h2>The shift, in two columns</h2>
        <p>
          SEO and AEO are not competing strategies. AEO is what SEO became when
          retrieval replaced ranking as the distribution layer.
        </p>
      </div>
      <CompareTable />
    </div>
  </section>

  <!-- Section 02: What is AEO -->
  <section id="what" class="aeo-section">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown">02 · The definition</span>
        <h2>AEO is how AI amplifies <em>your authority</em></h2>
        <p>
          Every retrieval-augmented engine — ChatGPT, Claude, Copilot, Gemini,
          Perplexity — answers buyer questions by citing sources. AEO is the
          discipline of becoming a source that's structured, schema-tagged, and
          answer-formatted so those engines find you, understand you, and quote
          you by name.
        </p>
      </div>
      <div class="grid-3">
        {definitionCards.map((card) => (
          <div class="card card--dark">
            <span class="card__label">{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Benefits -->
  <section id="benefits" class="aeo-section">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow aeo-eyebrow--brown">03 · The benefits</span>
        <h2>What AEO actually does <em>for your pipeline</em></h2>
      </div>
      <BenefitGrid />
    </div>
  </section>

  <!-- Section 04: Next Step -->
  <section id="next" class="aeo-nextstep">
    <div class="wrap aeo-nextstep__inner">
      <div>
        <span class="eyebrow aeo-eyebrow--default">Your next step</span>
        <h2>See where AI cites you <em>today</em></h2>
        <p>
          Start with a free, 5-minute visibility audit. We test your category
          questions across the five engines and email you the results.
        </p>
      </div>
      <div class="aeo-nextstep__ctas">
        <a href="/visibility-snapshot" class="btn btn--hero btn--primary">
          Get your Snapshot →
        </a>
        <a href="/work" class="btn btn--hero btn--ghost-light">
          Book a consultation
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <FinalCTA
    heading="When your buyers ask AI who to trust — <em>be the answer</em>"
    primaryLabel="Check My AI Visibility →"
    primaryHref="/visibility-snapshot"
    secondaryLabel="See a Live Example →"
    secondaryHref="https://aswhub.maxifidigital.com/"
    secondaryExternal={true}
  />

</BaseLayout>

<style>
  .aeo-hero {
    padding: 64px 0 48px;
    background: var(--navy);
    color: white;
  }

  .aeo-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .aeo-hero__eyebrow {
    display: block;
    margin-bottom: 14px;
  }

  .aeo-hero__h1 {
    font-size: 42px;
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin-bottom: 14px;
    font-weight: 500;
    color: white;
  }

  .aeo-hero__h1 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .aeo-hero__lede {
    font: 400 14px/1.55 var(--font-sans);
    color: var(--blue-soft);
    max-width: 620px;
    margin: 0;
  }

  .aeo-hero__meta {
    display: flex;
    gap: 18px;
    margin-top: 14px;
    font: 400 11px/1 var(--font-sans);
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    flex-wrap: wrap;
  }

  .aeo-hero__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .aeo-meta__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--blue-mid);
    display: inline-block;
  }

  .aeo-eyebrow--brown {
    color: var(--amber-mid);
  }

  .aeo-eyebrow--default {
    color: var(--amber-mid);
  }

  .aeo-section {
    padding: 56px 0;
    background: var(--navy-deep);
    color: var(--blue-soft);
  }

  .aeo-section h2 {
    color: white;
  }

  .aeo-section h3 {
    color: white;
  }

  .aeo-section--alt {
    background: var(--navy);
  }

  .aeo-section .sec-head {
    margin-bottom: 24px;
  }

  .aeo-section .sec-head h2 {
    color: white;
    font-size: 36px;
    line-height: 1.14;
    letter-spacing: -0.025em;
  }

  .aeo-section .sec-head h2 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .aeo-section .sec-head p {
    font: 400 13px/1.55 var(--font-sans);
    color: var(--blue-soft);
    margin-top: 10px;
    max-width: 620px;
  }

  /* Stack columns vertically for the two "column" sections.
     CompareTable: 2 cols -> 2x1 stacked rows
     Definition cards (.grid-3): 3 cols -> 3x1 stacked rows
     :global() needed to pierce CompareTable's scoped styles. */
  .aeo-section :global(.compare__table),
  .aeo-section .grid-3 {
    grid-template-columns: 1fr;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .card__label {
    font: 500 10px/1 var(--font-sans);
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
  }

  .aeo-nextstep {
    background: var(--navy-deep);
    padding: 56px 0;
    color: var(--blue-soft);
  }

  .aeo-nextstep__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1.4fr auto;
    gap: 40px;
    align-items: center;
  }

  .aeo-nextstep h2 {
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: white;
    max-width: 620px;
  }

  .aeo-nextstep h2 em {
    color: var(--amber-mid);
    font-style: italic;
    font-weight: 500;
  }

  .aeo-nextstep p {
    font: 400 13px/1.55 var(--font-sans);
    color: var(--blue-soft);
    margin-top: 10px;
    max-width: 620px;
    margin-bottom: 0;
  }

  .aeo-nextstep .eyebrow {
    margin-bottom: 14px;
  }

  .aeo-nextstep__ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .aeo-hero {
      padding: 48px 0 40px;
    }

    .aeo-hero__h1 {
      font-size: 30px;
    }

    .aeo-section {
      padding: 40px 0;
    }

    .aeo-nextstep {
      padding: 40px 0;
    }

    .aeo-nextstep__inner {
      grid-template-columns: 1fr;
    }

    .aeo-nextstep__ctas {
      justify-content: flex-start;
    }
  }
</style>
