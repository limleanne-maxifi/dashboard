<script>
  /* Play button hides the overlay once the user starts the video */
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.querySelector('.c-video') as HTMLVideoElement | null;
    const overlay = document.querySelector('.c-video-overlay') as HTMLElement | null;
    const playBtn = document.querySelector('.c-play-btn') as HTMLButtonElement | null;

    if (!video || !overlay || !playBtn) return;

    playBtn.addEventListener('click', () => {
      video.play();
      overlay.style.display = 'none';
    });

    video.addEventListener('pause', () => {
      overlay.style.display = 'flex';
    });

    video.addEventListener('ended', () => {
      overlay.style.display = 'flex';
    });
  });
</script>
