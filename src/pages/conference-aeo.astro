---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Conference AEO Sprint | Airspace World | Maxifi Digital"
  description="Turn your conference content into an AI citation engine within 30 days. Our Conference AEO Sprint builds the answer-ready assets, schema layers and Q&A library that make AI engines cite your event all year."
  currentPage="/conference-aeo"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="sprint-heading">
    <p class="eyebrow">CONFERENCE AEO SPRINT</p>
    <h1 id="sprint-heading" class="page-h1">
      Your conference content has a shelf life. The Sprint extends it forever.
    </h1>
    <p class="page-lede">
      Sessions, speakers and keynote insights are among the richest expert content
      in any industry. Yet most of it lives in PDFs, decks and YouTube — invisible
      to AI engines. The Sprint changes that in 30 days.
    </p>
    <div class="hero-ctas">
      <a
        href="mailto:hello@maxifidigital.com?subject=Conference%20AEO%20Sprint%20enquiry&body=I%27d%20like%20to%20discuss%20the%20Conference%20AEO%20Sprint%20for%20my%20event."
        class="btn-primary"
      >
        Scope my Sprint
      </a>
      <a href="/visibility-snapshot" class="btn-ghost">Start with a Snapshot</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       VIDEO — ASW CASE STUDY
  ══════════════════════════════════════════ -->
  <section class="video-section" aria-label="Airspace World AEO case study video">
    <div class="video-wrap">
      <video
        class="case-video"
        controls
        preload="metadata"
        poster=""
        aria-label="Airspace World 2026 — AEO case study"
      >
        <source src="/asw-explainer.mp4" type="video/mp4" />
        <p>Your browser doesn't support HTML5 video.
           <a href="/asw-explainer.mp4">Download the video</a>.</p>
      </video>
      <div class="video-caption">
        <p class="vc-eyebrow">FEATURED CASE</p>
        <p class="vc-title">CANSO · Airspace World 2026</p>
        <p class="vc-body">
          How we turned a 3-day aviation conference into a structured AI Knowledge Hub —
          47 Q&amp;A pairs, 92% schema coverage, 3× citation growth.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHAT A SPRINT PRODUCES
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="outputs-heading">
    <p class="s-eyebrow">WHAT YOU GET</p>
    <h2 id="outputs-heading" class="section-h2">Sprint deliverables</h2>
    <div class="outputs">
      <article class="output-card">
        <p class="oc-num">01</p>
        <h3 class="oc-title">AI Visibility Snapshot</h3>
        <p class="oc-body">
          A pre-Sprint audit of your current citation footprint. Which engines name
          your event today, which queries surface competitors, and the structural gaps
          that explain the difference.
        </p>
      </article>
      <article class="output-card">
        <p class="oc-num">02</p>
        <h3 class="oc-title">Q&A pair library</h3>
        <p class="oc-body">
          30–60 buyer questions mapped to your sessions, speakers and themes —
          each answered in the structured format LLMs retrieve and cite.
        </p>
      </article>
      <article class="output-card">
        <p class="oc-num">03</p>
        <h3 class="oc-title">Schema + structured data layer</h3>
        <p class="oc-body">
          JSON-LD markup for every key asset: Event, Speaker, FAQPage, Article.
          The vocabulary that turns your content into machine-readable authority signals.
        </p>
      </article>
      <article class="output-card">
        <p class="oc-num">04</p>
        <h3 class="oc-title">Answer-ready landing pages</h3>
        <p class="oc-body">
          Session and theme pages rebuilt as AI-retrievable knowledge nodes — not
          event marketing pages, but authoritative answer sources your brand owns.
        </p>
      </article>
      <article class="output-card">
        <p class="oc-num">05</p>
        <h3 class="oc-title">Distribution playbook</h3>
        <p class="oc-body">
          Where and how to publish your assets to maximise ingestion into AI
          training and retrieval pipelines — with a 90-day content calendar.
        </p>
      </article>
      <article class="output-card">
        <p class="oc-num">06</p>
        <h3 class="oc-title">30-day citation report</h3>
        <p class="oc-body">
          A follow-up Snapshot 30 days after launch, showing citation movement
          across all five engines vs. the pre-Sprint baseline.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHO IT'S FOR
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="for-heading">
    <p class="s-eyebrow">WHO IT'S FOR</p>
    <h2 id="for-heading" class="section-h2">The Sprint is built for</h2>
    <div class="audience-grid">
      {[
        { title: 'Conference & event organisers', body: 'Annual conferences, summits, trade shows with recorded sessions and speaker content.' },
        { title: 'Professional associations', body: 'Industry bodies whose publications and events are the authoritative source for their sector.' },
        { title: 'Think tanks', body: 'Research-led organisations whose output should be the answer AI gives to policy questions.' },
        { title: 'Law & consulting firms', body: 'Expert practices that speak at events and publish thought leadership — but are invisible to AI.' },
      ].map((item) => (
        <article class="audience-card">
          <h3 class="ac-title">{item.title}</h3>
          <p class="ac-body">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PROCESS TIMELINE
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="process-heading">
    <p class="s-eyebrow">THE 30-DAY PROCESS</p>
    <h2 id="process-heading" class="section-h2">How the Sprint runs</h2>
    <div class="timeline">
      <article class="tl-step">
        <p class="tl-week">Week 1</p>
        <h3 class="tl-title">Snapshot + audit</h3>
        <p class="tl-body">Full citation audit, content inventory, buyer question research. We map your existing assets to the gaps AI engines expose.</p>
      </article>
      <article class="tl-step">
        <p class="tl-week">Week 2</p>
        <h3 class="tl-title">Q&A architecture</h3>
        <p class="tl-body">Q&A library drafted and approved. Schema architecture designed. Answer-ready page structure agreed with your team.</p>
      </article>
      <article class="tl-step">
        <p class="tl-week">Week 3</p>
        <h3 class="tl-title">Build + markup</h3>
        <p class="tl-body">Pages built, schema added, Q&A pairs published. All assets reviewed and signed off before going live.</p>
      </article>
      <article class="tl-step">
        <p class="tl-week">Week 4</p>
        <h3 class="tl-title">Launch + distribute</h3>
        <p class="tl-body">Assets live. Distribution playbook handed over. Monitoring baseline set for the 30-day citation report.</p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PRICING
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="sprint-pricing-heading">
    <p class="s-eyebrow">INVESTMENT</p>
    <h2 id="sprint-pricing-heading" class="section-h2">Sprint pricing</h2>
    <div class="sprint-pricing">
      <div class="sprint-price-col">
        <p class="sp-tier">Conference Sprint</p>
        <p class="sp-range">£4,500 – £8,000</p>
        <p class="sp-note">Fixed fee · 30 days · One event</p>
        <p class="sp-detail">
          Price depends on content volume (number of sessions, speakers,
          themes) and whether we are building new pages or extending existing
          site infrastructure.
        </p>
        <a
          href="mailto:hello@maxifidigital.com?subject=Conference%20Sprint%20enquiry&body=Event%3A%20%0AApprox%20number%20of%20sessions%3A%20%0AExisting%20website%3A%20"
          class="btn-primary"
        >
          Scope my Sprint →
        </a>
      </div>
      <div class="sprint-includes-col">
        <p class="si-label">Always included</p>
        <ul class="si-list" role="list">
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>Pre-Sprint Visibility Snapshot</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>30–60 Q&A pairs</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>Full schema + JSON-LD layer</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>Answer-ready page builds</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>90-day distribution playbook</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>30-day citation follow-up report</li>
          <li class="si-item"><span class="check" aria-hidden="true">✓</span>Two rounds of amends</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FINAL CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="sprint-cta-heading">
    <div class="cta-box">
      <p class="s-eyebrow cta-eyebrow">NEXT STEP</p>
      <h2 id="sprint-cta-heading" class="cta-title">
        Tell us about your event and we'll scope the Sprint.
      </h2>
      <p class="cta-body">
        A 30-minute scoping call is enough to confirm fit, agree deliverables and
        set a start date. No obligation.
      </p>
      <div class="cta-buttons">
        <a
          href="mailto:hello@maxifidigital.com?subject=Conference%20AEO%20Sprint%20scope&body=Event%20name%3A%20%0AEvent%20date%2Fpast%2Fupcoming%3A%20%0AApprox%20sessions%3A%20%0AWebsite%3A%20"
          class="btn-primary"
        >
          Email hello@maxifidigital.com
        </a>
        <a href="/visibility-snapshot" class="btn-outline">Not ready? Get a Snapshot first</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Conference AEO Sprint",
    "provider": {
      "@type": "Organization",
      "name": "Maxifi Digital",
      "url": "https://maxifidigital.com"
    },
    "description": "A 30-day AEO Sprint that turns conference session content into AI-retrievable knowledge assets: Q&A pairs, schema markup, answer-ready pages and a distribution playbook.",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "GBP",
      "priceRange": "£4500-£8000"
    }
  }
  </script>

</BaseLayout>

<style>
  /* ── Page hero ──────────────────────────────── */
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 40px 22px 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .page-h1 {
    font-size: 30px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 12px;
    line-height: 1.18;
    font-family: 'Inter', sans-serif;
    max-width: 660px;
  }

  .page-lede {
    font-size: 13px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 580px;
    margin: 0 auto 20px;
  }

  .hero-ctas {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Video section ──────────────────────────── */
  .video-section {
    background: var(--cream-deep);
    padding: 24px 22px;
  }

  .video-wrap {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    align-items: center;
  }

  .case-video {
    width: 100%;
    border-radius: 8px;
    display: block;
    background: #000;
  }

  .vc-eyebrow {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 6px;
  }

  .vc-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 8px;
    font-family: 'Inter', sans-serif;
  }

  .vc-body {
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ── Shared ─────────────────────────────────── */
  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── Sprint deliverables ────────────────────── */
  .outputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .output-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 14px;
  }

  .oc-num {
    font-size: 10px;
    color: var(--amber);
    font-weight: 500;
    margin-bottom: 5px;
    letter-spacing: 0.08em;
  }

  .oc-title {
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--navy);
    font-family: 'Inter', sans-serif;
  }

  .oc-body {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Audience ───────────────────────────────── */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .audience-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 14px;
  }

  .ac-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 5px;
    font-family: 'Inter', sans-serif;
  }

  .ac-body {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Timeline ───────────────────────────────── */
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .tl-step {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 14px;
    border-top: 2px solid #BA7517;
  }

  .tl-week {
    font-size: 10px;
    color: var(--amber);
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-bottom: 5px;
  }

  .tl-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 6px;
    font-family: 'Inter', sans-serif;
  }

  .tl-body {
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Sprint pricing ─────────────────────────── */
  .sprint-pricing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .sp-tier {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 4px;
    font-family: 'Inter', sans-serif;
  }

  .sp-range {
    font-size: 28px;
    font-weight: 500;
    color: var(--navy);
    font-family: 'Inter', sans-serif;
    margin-bottom: 3px;
  }

  .sp-note {
    font-size: 10px;
    color: var(--mute-soft);
    margin-bottom: 10px;
  }

  .sp-detail {
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .si-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--amber);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .si-list { list-style: none; }

  .si-item {
    font-size: 12px;
    color: #444441;
    padding: 4px 0;
    display: flex;
    gap: 6px;
    align-items: baseline;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
    line-height: 1.4;
  }

  .si-item:last-child { border-bottom: none; }

  .check {
    color: var(--signal);
    font-weight: 500;
    flex-shrink: 0;
  }

  /* ── CTA box ────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 34px 22px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 21px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .cta-body {
    font-size: 12px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 440px;
    margin: 0 auto 18px;
  }

  .cta-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Shared buttons ─────────────────────────── */
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-ghost {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-ghost:hover { border-color: rgba(255, 255, 255, 0.6); }

  .btn-outline {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: rgba(255, 255, 255, 0.6); }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .page-h1 { font-size: 24px; }
    .video-wrap { grid-template-columns: 1fr; }
    .outputs { grid-template-columns: 1fr; }
    .audience-grid { grid-template-columns: 1fr; }
    .timeline { grid-template-columns: 1fr; }
    .sprint-pricing { grid-template-columns: 1fr; }
    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-ghost, .btn-outline { transition-duration: 0.01ms; }
  }
</style>
