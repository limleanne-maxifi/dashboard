---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Conference AEO Sprint | Turn Events into Authority | Maxifi Digital"
  description="Your event spend shouldn't disappear with the booth. Turn conference content into an AI citation engine with the Conference AEO Sprint."
  currentPage="/conference-aeo"
>

  <!-- ══════════════════════════════════════════
       SECTION: Turn Events into Authority
       3-slide rotating carousel + section head
  ══════════════════════════════════════════ -->
  <section class="ca-section" data-screen-label="Conference AEO section">
    <div class="wrap">

      <!-- Section head -->
      <div class="ca-head">
        <div class="ca-eyebrow">TURN EVENTS INTO AUTHORITY</div>
        <h2 class="ca-h2">
          Your event spend shouldn't disappear <em>with the booth.</em>
        </h2>
        <p class="ca-lede">
          Speaking at a conference is the single highest-trust signal AI engines retrieve. Wrap it in an AEO layer and every keynote, panel and breakout becomes a citation asset that compounds long after the lanyards come off.
        </p>
      </div>

      <!-- 3-slide rotating carousel -->
      <div class="ca-carousel-wrap">
        <div class="ca-carousel" id="aswCarousel" aria-label="ASW Hub case study · stats, live site, explainer">
          <div class="ca-slides">

            <!-- Slide 1: Stats card -->
            <div class="ca-slide ca-slide--meta is-on" data-slide="0">
              <span class="ca-eyebrow">Featured · Live case</span>
              <div class="ca-body">
                <div>
                  <h3 class="ca-slide-h3">Airspace World 2026 · The AI Visibility Hub</h3>
                  <p class="ca-slide-p">
                    A live AEO Visibility hub for Airspace World 2026 — the global convergence point of air traffic management. Every speaker, every session, every member organisation presented as answer-ready content for the AI engines used by the industry.
                  </p>
                </div>
                <div class="ca-metrics">
                  <div class="ca-met">
                    <div class="ca-v">250+</div>
                    <div class="ca-l">exhibitors</div>
                  </div>
                  <div class="ca-met">
                    <div class="ca-v">145+</div>
                    <div class="ca-l">countries</div>
                  </div>
                  <div class="ca-met">
                    <div class="ca-v">80%</div>
                    <div class="ca-l">senior decision makers</div>
                  </div>
                </div>
              </div>
              <div class="ca-footer">
                <span class="ca-src">aswhub.<b>maxifidigital.com</b></span>
                <a class="ca-cta" href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">
                  View the live hub →
                </a>
              </div>
            </div>

            <!-- Slide 2: Screenshot -->
            <div class="ca-slide ca-slide--shot" data-slide="1">
              <span class="ca-eyebrow">Showcase · Live site</span>
              <div class="ca-body">
                <div class="ca-shot-wrap">
                  <a
                    href="https://aswhub.maxifidigital.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open the ASW Hub live site"
                  >
                    <img
                      src="/asw-hub-screenshot.png"
                      alt="Airspace World 2026 AI Visibility Hub homepage"
                      loading="lazy"
                      width="1815"
                      height="774"
                    />
                  </a>
                </div>
              </div>
              <div class="ca-footer">
                <span class="ca-src">aswhub.<b>maxifidigital.com</b></span>
                <a class="ca-cta" href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">
                  Open the hub ↗
                </a>
              </div>
            </div>

            <!-- Slide 3: Video -->
            <div class="ca-slide ca-slide--video" data-slide="2">
              <span class="ca-eyebrow">Watch · Event AEO walkthrough</span>
              <div class="ca-body">
                <a class="ca-video-card" href="#" aria-label="Play the Event AEO explainer video">
                  <span class="ca-video-title">Introduction to Event AEO in 90s</span>
                  <span class="ca-play" aria-hidden="true"></span>
                  <span class="ca-duration">01:27</span>
                </a>
              </div>
              <div class="ca-footer">
                <span class="ca-src">01:27 · hd 1080p</span>
                <a class="ca-cta" href="#">Play the 90-second explainer →</a>
              </div>
            </div>

          </div>

          <!-- Nav dots -->
          <div class="ca-nav">
            <button class="ca-dot is-on" data-go="0" aria-label="Show live case stats"></button>
            <button class="ca-dot" data-go="1" aria-label="Show ASW Hub screenshot"></button>
            <button class="ca-dot" data-go="2" aria-label="Show explainer video"></button>
          </div>
        </div>
      </div>

      <!-- Bridge CTA -->
      <div class="ca-bridge">
        <span class="ca-bridge-label">Next ↘</span>
        <a class="ca-btn ca-btn--ghost" href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener noreferrer">
          Visit the ASW Hub ↗
        </a>
      </div>

    </div>
  </section>

  <script>
    (function() {
      const car = document.getElementById('aswCarousel');
      if (!car) return;

      const slides = car.querySelectorAll('.ca-slide');
      const dots = car.querySelectorAll('.ca-dot');
      let i = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function show(n: number) {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, k) => s.classList.toggle('is-on', k === i));
        dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
      }

      function tick() {
        show(i + 1);
      }

      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(tick, 3500);
      }

      dots.forEach((d) => {
        d.addEventListener('click', () => {
          show(parseInt(d.getAttribute('data-go') || '0', 10));
          restart();
        });
      });

      car.addEventListener('mouseenter', () => {
        if (timer) clearInterval(timer);
      });

      car.addEventListener('mouseleave', restart);

      restart();
    })();
  </script>

</BaseLayout>

<style>
  /* ── Section container ──────────────────────────── */
  .ca-section {
    background: var(--navy);
    color: var(--blue-text);
    padding: 96px 0 110px;
  }

  /* ── Section head ──────────────────────────────── */
  .ca-head {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .ca-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-mid);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .ca-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    flex-shrink: 0;
  }

  .ca-h2 {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.022em;
    color: #fff;
    max-width: 640px;
    margin: 0 0 14px;
  }

  .ca-h2 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .ca-lede {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 600px;
    margin: 0;
  }

  /* ── Carousel ──────────────────────────────────── */
  .ca-carousel-wrap {
    margin-bottom: 48px;
  }

  .ca-carousel {
    position: relative;
    background: var(--navy);
    border: 0.5px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 32px 72px -32px rgba(0, 0, 0, 0.55),
                0 0 0 1px rgba(186, 117, 23, 0.06);
  }

  .ca-slides {
    position: relative;
    width: 100%;
    aspect-ratio: 7 / 3;
    min-height: 480px;
  }

  .ca-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease;
    padding: 28px 36px 64px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    color: var(--blue-text);
  }

  .ca-slide.is-on {
    opacity: 1;
    visibility: visible;
  }

  .ca-body {
    position: relative;
    min-height: 0;
  }

  /* Slide 1: Stats */
  .ca-slide--meta .ca-body {
    display: grid;
    grid-template-rows: auto auto;
    gap: 22px;
    align-content: start;
    padding: 8px 18px 0;
  }

  .ca-slide-h3 {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 760px;
    margin: 0 0 12px;
  }

  .ca-slide-p {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 720px;
    margin: 0;
  }

  .ca-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    max-width: 720px;
  }

  .ca-met {
    border-right: 0.5px solid rgba(255, 255, 255, 0.1);
    padding-right: 22px;
  }

  .ca-met:nth-child(2) {
    padding-left: 22px;
  }

  .ca-met:last-child {
    border-right: none;
    padding-left: 22px;
    padding-right: 0;
  }

  .ca-v {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 500;
    line-height: 1;
    color: var(--amber-pale);
  }

  .ca-l {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--blue-mid);
    margin-top: 8px;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  /* Slide 2: Screenshot */
  .ca-slide--shot .ca-body {
    padding: 0;
  }

  .ca-shot-wrap {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--navy-deep);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .ca-shot-wrap a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ca-shot-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Slide 3: Video */
  .ca-slide--video .ca-body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .ca-video-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 16 / 9;
    background: var(--navy-deep);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    display: block;
    text-decoration: none;
  }

  .ca-video-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(186, 117, 23, 0.08) 0%, rgba(4, 44, 83, 0) 60%);
    pointer-events: none;
  }

  .ca-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05),
                0 0 32px 6px rgba(186, 117, 23, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ca-play::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 14px solid var(--amber-light);
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    margin-left: 4px;
  }

  .ca-video-card:hover .ca-play {
    transform: translate(-50%, -50%) scale(1.05);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.05),
                0 0 40px 10px rgba(186, 117, 23, 0.55);
  }

  .ca-video-title {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 16px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: #fff;
    max-width: 200px;
  }

  .ca-duration {
    position: absolute;
    right: 16px;
    bottom: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    color: var(--blue-soft);
    letter-spacing: 0.04em;
    padding: 5px 7px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 3px;
  }

  /* ── Slide footer (shared) ──────────────────────── */
  .ca-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 0.5px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .ca-src b {
    color: var(--blue-text);
    font-weight: 500;
  }

  .ca-cta {
    color: var(--amber-mid);
    text-transform: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ca-cta:hover {
    color: var(--amber-pale);
  }

  /* ── Nav dots ──────────────────────────────────── */
  .ca-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 4;
    pointer-events: none;
  }

  .ca-dot {
    pointer-events: auto;
    width: 28px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s ease, width 0.25s ease;
  }

  .ca-dot:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  .ca-dot.is-on {
    background: var(--amber);
    width: 38px;
  }

  /* ── Bridge CTA ────────────────────────────────── */
  .ca-bridge {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ca-bridge-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-mid);
  }

  .ca-btn {
    display: inline-block;
    padding: 12px 18px;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ca-btn--ghost {
    color: #fff;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    background: transparent;
  }

  .ca-btn--ghost:hover {
    background: var(--navy-soft);
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 700px) {
    .ca-section { padding: 64px 0 80px; }
    .ca-h2 { font-size: 26px; }
    .ca-slide { padding: 22px 22px 56px; }
    .ca-slide--meta .ca-body { padding: 0; }
    .ca-slide-h3 { font-size: 22px; }
    .ca-metrics { grid-template-columns: 1fr; }
    .ca-met {
      border-right: none;
      border-bottom: 0.5px solid rgba(255, 255, 255, 0.1);
      padding: 14px 0;
    }
    .ca-met:nth-child(2),
    .ca-met:last-child { padding-left: 0; }
    .ca-slide--video .ca-video-card { max-width: 100%; }
    .ca-slides { aspect-ratio: auto; min-height: 640px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-slide,
    .ca-dot,
    .ca-play,
    .ca-btn { transition-duration: 0.01ms; }
  }
</style>
