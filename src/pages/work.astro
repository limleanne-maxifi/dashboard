---
import BaseLayout from '../layouts/BaseLayout.astro';

const cases = [
  {
    slug: 'canso-airspace-world',
    client: 'CANSO',
    eyebrow: 'CANSO · AIRSPACE WORLD 2026',
    title: 'From PDF graveyard to citation engine.',
    category: 'Conference AEO Sprint',
    industry: 'Aviation governance',
    metrics: [
      { num: '47', label: 'Q&A pairs built' },
      { num: '92%', label: 'Schema coverage' },
      { num: '3×', label: 'Citation growth' },
    ],
    summary:
      'We turned a 3-day aviation conference into a structured AI Knowledge Hub. Sessions, speakers and themes became answer-ready assets that keep earning citations long after the room empties.',
  },
];
---

<BaseLayout
  title="Our Work | AEO Case Studies | Maxifi Digital"
  description="Case studies from Maxifi Digital's AEO engagements — how expert-led organisations became the answer AI cites."
  currentPage="/work"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="work-heading">
    <p class="eyebrow">CLIENT WORK</p>
    <h1 id="work-heading" class="page-h1">
      Results, not claims.
    </h1>
    <p class="page-lede">
      Every engagement starts with a Visibility Snapshot and ends with measurable
      citation lift. Here's what that looks like in practice.
    </p>
  </section>

  <!-- ══════════════════════════════════════════
       CASE STUDY CARDS
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="cases-heading">
    <p class="s-eyebrow">CASE STUDIES</p>
    <h2 id="cases-heading" class="section-h2">Featured work</h2>

    <div class="cases-list">
      {cases.map((c) => (
        <article class="case-card" aria-labelledby={`case-${c.slug}`}>
          <div class="cc-meta">
            <p class="cc-eyebrow">{c.eyebrow}</p>
            <p class="cc-cat">{c.category} · {c.industry}</p>
          </div>
          <div class="cc-body">
            <h3 id={`case-${c.slug}`} class="cc-title">{c.title}</h3>
            <p class="cc-summary">{c.summary}</p>
            <dl class="cc-metrics">
              {c.metrics.map((m) => (
                <div class="cc-metric">
                  <dd class="cc-num">{m.num}</dd>
                  <dt class="cc-lbl">{m.label}</dt>
                </div>
              ))}
            </dl>
          </div>
          <div class="cc-footer">
            <a href={`/work/${c.slug}`} class="cc-link">Read case study →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       MORE TO COME
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="pipeline-heading">
    <p class="s-eyebrow">COMING SOON</p>
    <h2 id="pipeline-heading" class="section-h2">More case studies in progress</h2>
    <p class="pipe-body">
      We work with a small number of clients at any one time — which means we can
      go deep on each engagement. New case studies are published as results are verified.
    </p>
    <div class="pipe-cards">
      {[
        { industry: 'Legal & compliance', service: 'Visibility Engine retainer' },
        { industry: 'Professional association', service: 'Conference AEO Sprint' },
        { industry: 'Accounting practice', service: 'Executive TL System' },
      ].map((p) => (
        <div class="pipe-card">
          <p class="pc-industry">{p.industry}</p>
          <p class="pc-service">{p.service}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="work-cta-heading">
    <div class="cta-box">
      <p class="s-eyebrow cta-eyebrow">YOUR ORGANISATION NEXT?</p>
      <h2 id="work-cta-heading" class="cta-title">
        Start with a free AI Visibility Snapshot.
      </h2>
      <p class="cta-body">
        5 minutes. No sales call required. See where you stand across
        ChatGPT, Perplexity, Claude, Gemini and Google AI.
      </p>
      <div class="cta-buttons">
        <a href="/visibility-snapshot" class="btn-primary">Get my free Snapshot</a>
        <a href="/conference-aeo" class="btn-outline">See our Sprint</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 40px 22px 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .page-h1 {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 12px;
    line-height: 1.18;
    font-family: 'Inter', sans-serif;
  }

  .page-lede {
    font-size: 13px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 520px;
    margin: 0 auto;
  }

  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── Case cards ─────────────────────────────── */
  .cases-list { display: flex; flex-direction: column; gap: 14px; }

  .case-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 0;
  }

  .cc-meta {
    background: var(--navy);
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cc-eyebrow {
    font-size: 9px;
    color: var(--amber-mid);
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .cc-cat {
    font-size: 10px;
    color: var(--blue-soft);
    line-height: 1.4;
  }

  .cc-body { padding: 18px; }

  .cc-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 7px;
    font-family: 'Inter', sans-serif;
    line-height: 1.25;
  }

  .cc-summary {
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .cc-metrics {
    display: flex;
    gap: 16px;
  }

  .cc-metric { display: flex; flex-direction: column; }

  .cc-num {
    font-size: 18px;
    font-weight: 500;
    color: var(--navy);
    font-family: 'Inter', sans-serif;
    line-height: 1.1;
  }

  .cc-lbl {
    font-size: 9px;
    color: var(--mute-soft);
    margin-top: 1px;
  }

  .cc-footer {
    padding: 18px;
    display: flex;
    align-items: center;
    border-left: 0.5px solid rgba(0, 0, 0, 0.06);
  }

  .cc-link {
    font-size: 11px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .cc-link:hover { color: var(--amber); }

  /* ── Pipeline ───────────────────────────────── */
  .pipe-body {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 500px;
    margin-bottom: 14px;
  }

  .pipe-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .pipe-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 12px 14px;
  }

  .pc-industry {
    font-size: 12px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 3px;
  }

  .pc-service {
    font-size: 10px;
    color: var(--mute-soft);
  }

  /* ── CTA ────────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 34px 22px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 21px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .cta-body {
    font-size: 12px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 440px;
    margin: 0 auto 18px;
  }

  .cta-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-outline {
    background: transparent;
    color: var(--blue-text);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: rgba(255, 255, 255, 0.6); }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .page-h1 { font-size: 26px; }

    .case-card {
      grid-template-columns: 1fr;
    }

    .cc-footer {
      border-left: none;
      border-top: 0.5px solid rgba(0, 0, 0, 0.06);
    }

    .pipe-cards { grid-template-columns: 1fr; }
    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .btn-outline, .cc-link { transition-duration: 0.01ms; }
  }
</style>
