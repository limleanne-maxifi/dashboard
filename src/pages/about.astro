  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Maxifi Digital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maxifi Digital is a Singapore-based Answer Engine Optimisation (AEO) and AI visibility consultancy, working globally. It helps expert-led brands — professional services firms, aviation and aerospace bodies, industry associations, law firms, and specialist consultancies — become the source AI engines such as ChatGPT, Perplexity, Copilot, Gemini, and Claude cite when buyers research their category."
      }
    },
    {
      "@type": "Question",
      "name": "Who runs Maxifi Digital?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maxifi Digital was founded and is run by Lim Le-Anne (also written Le-Anne Lim), a Singapore-based specialist in AI search visibility and Answer Engine Optimisation. Her LinkedIn profile is linkedin.com/in/limleanne."
      }
    },
    {
      "@type": "Question",
      "name": "Is Maxifi Digital related to MaxiFi Planner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Maxifi Digital (maxifidigital.com) is not affiliated with MaxiFi Planner (maxifi.com), a personal financial planning software product, or with maxify.digital. Maxifi Digital is an independent Answer Engine Optimisation consultancy based in Singapore."
