  <!-- ══════════════════════════════════════════
       CONTACT
  ══════════════════════════════════════════ -->
  <section class="section section--cream" id="contact" aria-labelledby="contact-heading">
    <div class="contact-grid">
      <div class="contact-text">
        <p class="s-eyebrow">GET IN TOUCH</p>
        <h2 id="contact-heading" class="section-h2">Start a conversation</h2>
        <p class="ct-body">
          The best first step is a Visibility Snapshot — a free, 5-minute check of
          your current AI citation footprint. Or if you'd rather talk first, email us
          directly.
        </p>
        <div class="contact-links">
          <a href="mailto:hello@maxifidigital.com" class="cl-link">
            hello@maxifidigital.com
          </a>
          <a href="https://lunacal.ai/maxifidigital" target="_blank" rel="noopener noreferrer" class="cl-link">
            Book a consultation →
          </a>
        </div>
      </div>

      <div id="contact-form-wrap">
        <form
          name="contact"
          method="POST"
          action="/thanks"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="contact-form"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="honeypot" aria-hidden="true">
            <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="f-label" for="cf-name">Your name</label>
          <input
            class="f-input"
            type="text"
            id="cf-name"
            name="name"
            placeholder="Jane Smith"
            required
          />

          <label class="f-label" for="cf-org">Organisation</label>
          <input
            class="f-input"
            type="text"
            id="cf-org"
            name="organisation"
            placeholder="Acme Consulting"
          />

          <label class="f-label" for="cf-email">Work email</label>
          <input
            class="f-input"
            type="email"
            id="cf-email"
            name="email"
            placeholder="jane@acmeconsulting.com"
            required
          />

          <label class="f-label" for="cf-message">What would you like to discuss?</label>
          <textarea
            class="f-input f-textarea"
            id="cf-message"
            name="message"
            rows="4"
            placeholder="Tell us about your organisation and what you're hoping to achieve..."
          ></textarea>

          <button type="submit" class="f-btn">Send →</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="about-cta-heading">
    <div class="cta-box">
      <p class="s-eyebrow cta-eyebrow">START HERE</p>
      <h2 id="about-cta-heading" class="cta-title">
        Not sure where to begin? Start with a Snapshot.
      </h2>
      <p class="cta-body">
        Free. 5 minutes. No sales call. See exactly where AI engines stand on your brand.
      </p>
      <a href="https://checkyourvisibility.maxifidigital.com/" target="_blank" rel="noopener noreferrer" class="btn-primary">Get my free Snapshot</a>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const wrap = document.getElementById('contact-form-wrap');
  if (form && wrap) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();

      const showError = () => {
        if (submitBtn) submitBtn.disabled = false;
        let err = form.querySelector<HTMLElement>('.form-error');
        if (!err) {
          err = document.createElement('p');
          err.className = 'form-error';
          err.setAttribute('role', 'alert');
          form.appendChild(err);
        }
        err.innerHTML =
          'Something went wrong sending your message. Please try again, or email us directly at <a href="mailto:hello@maxifidigital.com">hello@maxifidigital.com</a>.';
      };

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (response.ok) {
          wrap.innerHTML =
            '<p class="form-thanks">Thank you — we\'ll be in touch within one business day.</p>';
        } else {
          showError();
        }
      } catch {
        showError();
      }
    });
  }
</script>

<style>
  .honeypot { position: absolute; left: -9999px; }

  .form-thanks {
    font-size: var(--text-small);
    color: var(--navy);
    line-height: 1.55;
    padding: 12px 0;
  }

  .form-error {
    font-size: var(--text-small);
    color: var(--danger);
    line-height: 1.55;
    margin-top: 10px;
  }

  .form-error :global(a) {
    text-decoration: underline;
  }

  /* ── Hero ───────────────────────────────────── */
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 40px var(--gutter) 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: var(--text-micro);
    letter-spacing: var(--track-caps);
    color: var(--amber-mid);
    font-weight: 500;
