---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
  {
    slug: 'what-ai-engines-actually-cite',
    eyebrow: 'AEO · 5 min read',
    title: 'What AI engines actually cite — and what they ignore',
    excerpt:
      'Perplexity, ChatGPT and Google AI Overviews have very different retrieval behaviours. Here\'s what our cross-engine research shows about which content signals actually drive citations.',
    date: '2026-05-10',
  },
  {
    slug: 'schema-markup-for-professional-services',
    eyebrow: 'SCHEMA · 4 min read',
    title: 'Schema markup for professional services: the five types that matter',
    excerpt:
      'Most professional services firms have zero structured data. Here are the five JSON-LD types that deliver the highest citation lift for law firms, consultancies and associations.',
    date: '2026-05-03',
  },
  {
    slug: 'conference-content-aeo-playbook',
    eyebrow: 'PLAYBOOK · 7 min read',
    title: 'The conference content AEO playbook',
    excerpt:
      'Sessions and keynotes are the richest expert content in any industry — and almost none of it is structured for AI retrieval. This is how to change that in 30 days.',
    date: '2026-04-26',
  },
];

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Insights | AEO Research & Playbooks | Maxifi Digital"
  description="AEO research, playbooks and weekly Cited Brief newsletter from Maxifi Digital. Practical answer engine optimisation for expert-led organisations."
  currentPage="/insights"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="page-hero" aria-labelledby="insights-heading">
    <p class="eyebrow">INSIGHTS · NEWSLETTER · RESEARCH</p>
    <h1 id="insights-heading" class="page-h1">
      What we learn, we publish.
    </h1>
    <p class="page-lede">
      AEO research, practical playbooks and the Cited Brief — our weekly
      Friday newsletter on what AI engines are getting wrong and how to fix it.
    </p>
  </section>

  <!-- ══════════════════════════════════════════
       NEWSLETTER CTA
  ══════════════════════════════════════════ -->
  <section class="nl-banner" aria-labelledby="nl-banner-heading">
    <div class="nlb-inner">
      <div class="nlb-text">
        <p class="nlb-eyebrow">THE CITED BRIEF · WEEKLY FRIDAY</p>
        <h2 id="nl-banner-heading" class="nlb-title">One question. One fix. One field example.</h2>
        <p class="nlb-body">4-minute read. Every Friday. Free.</p>
      </div>
      <div id="nlb-form-wrap">
        <form
          name="cited-brief"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="nlb-form"
          class="nlb-form"
        >
          <input type="hidden" name="form-name" value="cited-brief" />
          <input type="hidden" name="source-page" value="insights" />
          <p class="honeypot" aria-hidden="true">
            <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <label class="sr-only" for="nlb-email">Email address</label>
          <input
            class="nlb-input"
            type="email"
            id="nlb-email"
            name="email"
            placeholder="your@work-email.com"
            required
          />
          <button type="submit" class="nlb-btn">Subscribe free</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ARTICLE LIST
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="articles-heading">
    <p class="s-eyebrow">LATEST</p>
    <h2 id="articles-heading" class="section-h2">AEO insights</h2>
    <div class="article-list">
      {articles.map((a) => (
        <article class="article-card" aria-labelledby={`art-${a.slug}`}>
          <div class="ac-meta">
            <span class="ac-eyebrow">{a.eyebrow}</span>
            <time class="ac-date" datetime={a.date}>{formatDate(a.date)}</time>
          </div>
          <h3 id={`art-${a.slug}`} class="ac-title">
            <a href={`/insights/${a.slug}`} class="ac-link">{a.title}</a>
          </h3>
          <p class="ac-excerpt">{a.excerpt}</p>
          <a href={`/insights/${a.slug}`} class="ac-read">Read →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       TOPIC TAGS
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-label="Topics covered">
    <p class="s-eyebrow">TOPICS</p>
    <h2 class="section-h2">What we write about</h2>
    <div class="tags">
      {[
        'AEO fundamentals',
        'Schema markup',
        'Conference content',
        'Professional services',
        'Citation monitoring',
        'Buyer intent',
        'Legal & compliance',
        'Think tanks',
        'ChatGPT retrieval',
        'Perplexity',
        'Google AI Overviews',
        'Content structure',
      ].map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       BOTTOM NL SIGNUP
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="nl-cta-heading">
    <div class="cta-box">
      <p class="s-eyebrow cta-eyebrow">CITED BRIEF</p>
      <h2 id="nl-cta-heading" class="cta-title">Get the weekly Cited Brief</h2>
      <p class="cta-body">
        Every Friday: one buyer question AI is getting wrong, one move to fix it,
        one example from the field.
      </p>
      <a href="#nl-banner-heading" class="btn-primary" onclick="document.getElementById('nlb-email')?.focus();return false;">
        Subscribe free
      </a>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('nlb-form') as HTMLFormElement | null;
  const wrap = document.getElementById('nlb-form-wrap');
  if (form && wrap) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        wrap.innerHTML = '<p class="nlb-thanks">You\'re in. See you Friday.</p>';
      } catch {
        form.submit();
      }
    });
  }
</script>

<style>
  .honeypot { position: absolute; left: -9999px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ── Hero ───────────────────────────────────── */
  .page-hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 40px 22px 36px;
    text-align: center;
  }

  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .page-h1 {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin: 0 auto 12px;
    line-height: 1.18;
    font-family: 'Inter', sans-serif;
  }

  .page-lede {
    font-size: 13px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Newsletter banner ──────────────────────── */
  .nl-banner {
    background: var(--amber-light);
    padding: 20px 22px;
  }

  .nlb-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: center;
  }

  .nlb-eyebrow {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--amber);
    font-weight: 500;
    margin-bottom: 5px;
  }

  .nlb-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--brown-deep);
    font-family: 'Inter', sans-serif;
    margin-bottom: 3px;
  }

  .nlb-body {
    font-size: 11px;
    color: var(--brown-mid);
  }

  .nlb-form {
    display: flex;
    gap: 8px;
  }

  .nlb-input {
    flex: 1;
    border: 0.5px solid rgba(65, 36, 2, 0.2);
    border-radius: 4px;
    padding: 9px 10px;
    font-size: 11px;
    color: var(--brown-deep);
    background: #fff;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.2s ease;
  }

  .nlb-input:focus {
    outline: none;
    border-color: var(--amber);
  }

  .nlb-btn {
    background: var(--navy);
    color: var(--blue-text);
    border: none;
    padding: 9px 14px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .nlb-btn:hover { background: #031F3D; }

  .nlb-thanks {
    font-size: 13px;
    color: var(--brown-deep);
    font-weight: 500;
    padding: 10px 0;
  }

  /* ── Shared ─────────────────────────────────── */
  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--amber-mid);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }
  .section--pt0 { padding-top: 0; }

  /* ── Articles ───────────────────────────────── */
  .article-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .article-card {
    padding: 18px 0;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.08);
  }

  .article-card:last-child { border-bottom: none; }

  .ac-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 5px;
  }

  .ac-eyebrow {
    font-size: 9px;
    color: var(--amber);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ac-date {
    font-size: 10px;
    color: var(--mute-soft);
  }

  .ac-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 6px;
    font-family: 'Inter', sans-serif;
    line-height: 1.25;
  }

  .ac-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ac-link:hover { color: var(--amber); }

  .ac-excerpt {
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 8px;
    max-width: 640px;
  }

  .ac-read {
    font-size: 11px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ac-read:hover { color: var(--amber); }

  /* ── Tags ───────────────────────────────────── */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 3px;
    padding: 5px 10px;
    font-size: 11px;
    color: var(--muted);
  }

  /* ── CTA ────────────────────────────────────── */
  .cta-box {
    background: var(--navy);
    padding: 34px 22px;
    text-align: center;
    color: var(--blue-text);
    border-radius: 8px;
  }

  .cta-eyebrow { color: var(--amber-mid); margin-bottom: 10px; }

  .cta-title {
    font-size: 21px;
    font-weight: 500;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .cta-body {
    font-size: 12px;
    line-height: 1.55;
    color: var(--blue-soft);
    max-width: 400px;
    margin: 0 auto 18px;
  }

  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .page-h1 { font-size: 26px; }
    .nlb-inner { grid-template-columns: 1fr; }
    .nlb-form { flex-direction: column; }
    .cta-title { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary, .nlb-input, .nlb-btn, .ac-link, .ac-read {
      transition-duration: 0.01ms;
    }
  }
</style>
