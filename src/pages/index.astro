  .vs-sample__copy h3 em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }
  .vs-sample__copy p {
    font: 400 16px/1.55 var(--font-sans);
    color: var(--muted);
    margin: 0 0 14px;
  }
  .vs-sample__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 22px 0 0;
  }
  .vs-sample__cell {
    padding: 16px 18px;
    border: 0.5px solid var(--line);
    border-radius: 6px;
    background: var(--cream);
  }
  .vs-n {
    font: 500 12px/1.2 var(--font-mono);
    color: var(--amber);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 8px;
  }
  .vs-sample__cell b {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .vs-sample__cell p {
    font: 400 13px/1.55 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }
  .vs-sample__cta-row {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .vs-sample__meta {
    font: 400 11px/1.4 var(--font-sans);
    color: var(--mute-soft);
  }
  .vs-btn {
    display: inline-block;
    font: 500 12px/1 var(--font-sans);
    text-decoration: none;
    border-radius: 5px;
    transition: background 0.2s ease;
    padding: 10px 16px;
  }
  .vs-btn--primary {
    background: var(--amber);
    color: var(--amber-light);
    border: none;
  }
  .vs-btn--primary:hover { background: #854F0B; }
  /* Mock report */
  .vs-report {
    background: #fff;
    border: 0.5px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 1px 0 rgba(4, 44, 83, 0.04), 0 24px 56px -28px rgba(4, 44, 83, 0.22);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .vs-report__chrome {
    padding: 12px 18px;
    background: var(--navy);
    color: var(--blue-text);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .vs-report__chrome-left {
    color: var(--amber-mid);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .vs-report__chrome-left::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }
  .vs-report__chrome-right { color: var(--blue-mid); }
  .vs-report__body {
    padding: 28px 30px 30px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .vs-report__rows { margin-top: 20px; display: grid; gap: 6px; }
  .vs-report__meta {
    font: 400 11px/1.4 var(--font-sans);
    color: var(--mute-soft);
    margin-bottom: 22px;
  }
  .vs-report__h {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--navy);
    margin-bottom: 22px;
  }
  .vs-report__h em {
    font-style: italic;
    color: var(--amber);
    font-weight: 500;
  }
  .vs-report__score {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    align-items: center;
    padding: 22px;
    background: var(--cream-deep);
    border-radius: 6px;
    margin-bottom: 22px;
  }
  .vs-ring {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: conic-gradient(var(--amber) 0deg 169deg, rgba(4, 44, 83, 0.08) 169deg 360deg);
    display: grid;
    place-items: center;
    position: relative;
  }
  .vs-ring::after {
    content: "";
    position: absolute;
    inset: 9px;
    background: var(--cream-deep);
    border-radius: 50%;
  }
  .vs-ring__v {
    position: relative;
    z-index: 1;
    font: 500 38px/1 var(--font-mono);
    color: var(--navy);
    letter-spacing: -0.02em;
    text-align: center;
  }
  .vs-ring__v small {
    display: block;
    font: 500 10px/1 var(--font-mono);
    color: var(--mute-soft);
    margin-top: 4px;
    letter-spacing: 0.08em;
    text-align: center;
  }
  .vs-report__info-lbl {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute-soft);
    margin-bottom: 8px;
  }
  .vs-report__info h4 {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .vs-report__info p {
    font: 400 12px/1.5 var(--font-sans);
    color: var(--muted);
    margin: 0;
  }
  .vs-band {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown-deep);
    background: rgba(186, 117, 23, 0.10);
    padding: 6px 9px;
    border-radius: 3px;
    margin-top: 12px;
  }
  .vs-report__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 9px 12px;
    background: var(--cream);
    border: 0.5px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .vs-engine { color: var(--navy); }
  .vs-stat { color: var(--amber); font-weight: 500; }
  .vs-ok { color: var(--signal); }
  .vs-lo { color: var(--danger); }

  /* ── System Section (System 3 design) ─────────────────────────── */
  .system-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--amber-mid);
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 24px;
    text-align: left;
  }

  .system-section {
    background: var(--navy);
    color: var(--blue-text);
    padding: 48px 0 32px;
    text-align: left;
  }

  .system-head {
    max-width: 720px;
    margin: 0 0 36px;
    text-align: left;
  }

  .system-title {
    font-size: 32px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 14px;
    line-height: 1.14;
    letter-spacing: -0.022em;
  }

  .system-title em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 500;
  }

  .system-description {
    font-size: 14px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.6;
    max-width: 600px;
  }

  .system-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: stretch;
  }

  .stages {
    display: grid;
    gap: 14px;
    height: 100%;
  }

  .stage {
    background: rgba(255,255,255,0.03);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px 24px;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 22px;
    align-items: start;
  }

  .stage-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--amber-mid);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    padding-top: 4px;
  }

  .stage-title {
    font-size: 17px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .stage-body {
    font-size: 12px;
    font-weight: 400;
    color: var(--blue-soft);
    line-height: 1.55;
  }

  .snap-card {
    background: var(--navy-deep);
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 22px;
    font-family: var(--font-sans);
    font-size: 11px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .snap-toplabel {
    font: 500 9px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber-mid);
    margin-bottom: 14px;
  }

  .snap-hdr {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 12px;
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    margin-bottom: 10px;
    gap: 10px;
  }

  .snap-hdr__left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .snap-title {
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    line-height: 1.2;
  }

  .snap-subtitle {
    font: 400 9px/1.3 var(--font-sans);
    color: var(--blue-mid);
    letter-spacing: 0.03em;
  }

  .snap-score-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
  }

  .snap-score-lbl {
    font: 400 9px/1 var(--font-sans);
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .snap-score {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    color: var(--amber-pale);
    line-height: 1;
  }

  .snap-score em {
    font-style: normal;
    font-size: 11px;
    color: var(--blue-mid);
  }

  .snap-summary {
    font: 400 10px/1 var(--font-sans);
    color: var(--blue-mid);
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }

  .snap-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.06);
    color: var(--blue-soft);
    line-height: 1.5;
  }

  .snap-row:last-child {
    border-bottom: none;
  }

  .snap-value {
    font-weight: 500;
  }

  .snap-value--cited {
    color: var(--amber-pale);
  }

  .snap-value--not {
    color: var(--danger);
  }

  .snap-legend {
    display: flex;
    gap: 14px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 0.5px solid rgba(255,255,255,0.08);
    font-size: 10px;
    font-weight: 400;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    vertical-align: middle;
  }

  .legend-dot--cited {
    background: var(--amber-pale);
  }

  .legend-dot--not {
    background: var(--danger);
  }

  @media (max-width: 960px) {
    .vs-sample__panel { grid-template-columns: 1fr; gap: 28px; }
    .vs-sec-head h2 { white-space: normal; font-size: 32px; }
  }

  /* ── Conference AEO Hero (Turn Events into Authority) ─── */
  .ca-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .ca-section {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--blue-text);
    padding: 32px 0 80px;
  }

  .ca-head {
    max-width: 720px;
    margin-bottom: 24px;
  }

  .ca-actmark {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-mid);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .ca-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber-mid);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .ca-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    flex-shrink: 0;
  }

  .ca-h2 {
    font-family: var(--font-sans);
    font-size: 42px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #fff;
    max-width: 760px;
    margin: 0 0 14px;
  }

  .ca-h2 em {
    font-style: italic;
    color: var(--amber-mid);
    font-weight: 600;
  }

  .ca-lede {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 600px;
    margin: 0;
  }

  .ca-carousel-wrap {
    margin-bottom: 32px;
  }

  .ca-carousel {
    position: relative;
    background: var(--navy);
    border: 0.5px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 32px 72px -32px rgba(0, 0, 0, 0.55),
                0 0 0 1px rgba(186, 117, 23, 0.06);
  }

  .ca-slides {
    position: relative;
    width: 100%;
    aspect-ratio: 7 / 3;
    min-height: 400px;
  }

  .ca-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease;
    padding: 28px 36px 64px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
    color: var(--blue-text);
  }

  .ca-slide.is-on {
    opacity: 1;
    visibility: visible;
  }

  .ca-body {
    position: relative;
    min-height: 0;
  }

  .ca-slide--meta .ca-body {
    display: grid;
    grid-template-rows: auto auto;
    gap: 22px;
    align-content: start;
    padding: 8px 18px 0;
  }

  .ca-slide-h3 {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 760px;
    margin: 0 0 12px;
  }

  .ca-slide-p {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--blue-soft);
    max-width: 720px;
    margin: 0;
  }

  .ca-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    max-width: 720px;
  }

  .ca-met {
    border-right: 0.5px solid rgba(255, 255, 255, 0.1);
    padding-right: 22px;
  }

  .ca-met:nth-child(2) {
    padding-left: 22px;
  }

  .ca-met:last-child {
    border-right: none;
    padding-left: 22px;
    padding-right: 0;
  }

  .ca-v {
    font-family: var(--font-sans);
    font-size: 35px;
    font-weight: 500;
    line-height: 1;
    color: var(--amber-pale);
  }

  .ca-l {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--blue-mid);
    margin-top: 8px;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .ca-slide--shot .ca-body { padding: 0; }

  .ca-shot-wrap {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--navy-deep);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .ca-shot-wrap a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ca-shot-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .ca-slide--video .ca-body {
    padding: 0;
    display: flex;
    align-items: stretch;
  }

  .ca-video-shell {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    border: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .ca-video {
    flex: 1;
    width: 100%;
    display: block;
    object-fit: contain;
    background: #000;
    min-height: 0;
  }

  .ca-caption-bar {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    background: rgba(3, 31, 61, 0.92);
    border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  }

  .ca-caption-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--blue-text);
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ca-caption-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ca-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 0.5px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    color: var(--blue-mid);
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .ca-src b {
    color: var(--blue-text);
    font-weight: 500;
  }

  .ca-cta {
    color: var(--amber-mid);
    text-transform: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ca-cta:hover { color: var(--amber-pale); }

  .ca-nav {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 4;
    pointer-events: none;
  }

  .ca-dot {
    pointer-events: auto;
    width: 28px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s ease, width 0.25s ease;
  }

  .ca-dot:hover { background: rgba(255, 255, 255, 0.5); }

  .ca-dot.is-on {
    background: var(--amber);
    width: 38px;
  }

  .ca-bridge {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .ca-bridge-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-mid);
  }

  .ca-btn {
    display: inline-block;
    padding: 12px 18px;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ca-btn--ghost {
    color: #fff;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    background: transparent;
  }

  .ca-btn--ghost:hover {
    background: var(--navy-soft);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 700px) {
    .ca-section { padding: 24px 0 60px; }
