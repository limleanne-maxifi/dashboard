---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLoop from '../components/HeroLoop.astro';
---

<BaseLayout
  title="Maxifi Digital | AI Visibility for Expert-Led Brands"
  description="Maxifi Digital helps expert-led brands become the answer AI cites. Free AI Visibility Scorecard across ChatGPT, Claude, Gemini, Perplexity and Google AI."
  currentPage="/"
>

  <!-- ══════════════════════════════════════════
       SECTION 2 — HERO
  ══════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-row">

      <div class="hero-left">
        <!-- Did you know section -->
        <div class="did-you-know" id="dyk-stat">
          <p class="dyk-label">#didyouknow</p>
          <p class="dyk-value" id="dyk-value">25% decline in traditional search by 2026</p>
          <p class="dyk-source" id="dyk-source">Gartner</p>
        </div>

        <div class="hero-body">
          <p class="eyebrow">AI VISIBILITY FOR EXPERT-LED BRANDS</p>
          <h1 id="hero-heading" class="hero-h1">
            <span class="hero-h1-lead">Your buyers are no longer only searching Google.</span>
            <span class="hero-h1-tail">They are asking AI:</span>
          </h1>
          <ul class="hero-queries" role="list">
            <li>"Who are the best providers?"</li>
            <li>"Which solution should we shortlist?"</li>
            <li>"Who has credible expertise in this space?"</li>
            <li>"What companies should we compare?"</li>
          </ul>
          <p class="lede">
            If AI cannot understand why your company is worth citing, your competitors
            become easier to recommend. Maxifi Digital turns your expertise, content and
            proof into structured authority assets that AI engines can find, understand
            and cite.
          </p>
          <div class="hero-ctas">
            <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="btn-primary">Get my AI Visibility Snapshot</a>
            <a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener" class="btn-ghost">
              See how it works - Airspace World case study
            </a>
          </div>
        </div>
      </div>

      <HeroLoop />

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 3 — SAMPLE SNAPSHOT (clickable proof)
  ══════════════════════════════════════════ -->
  <section class="sample-snapshot-section" aria-labelledby="sample-snapshot-heading">
    <div class="wrap">
      <div class="sample-intro">
        <p class="s-eyebrow">SEE A REAL ONE</p>
        <h2 id="sample-snapshot-heading" class="section-h2">This is what your AI Visibility Snapshot looks like.</h2>
        <p class="sample-sub">Real client. Real scores. Real fixes. Pick your industry to see both the form and the report.</p>
      </div>
      <div class="sample-shell">
        <div class="sample-tabs" role="tablist">
          <button class="sample-tab active" role="tab" aria-selected="true" data-snap="commercial">Commercial Aviation</button>
          <button class="sample-tab" role="tab" aria-selected="false" data-snap="manufacturing">Aerospace Manufacturing</button>
          <button class="sample-tab" role="tab" aria-selected="false" data-snap="space">Space Exploration</button>
          <button class="sample-tab" role="tab" aria-selected="false" data-snap="mro">MRO</button>
        </div>
        <div class="sample-duo">
          <!-- LEFT: form card -->
          <div class="snap-form-card">
            <div class="snap-form-header">
              <span class="snap-form-label">AI VISIBILITY SNAPSHOT</span>
              <span class="snap-form-sector" id="snap-form-sector">COMMERCIAL AVIATION</span>
            </div>
            <div class="snap-form-body">
              <div class="snap-field">
                <div class="snap-label">YOUR WEBSITE</div>
                <div class="snap-input" id="snap-f-website">yourcompany.com</div>
              </div>
              <div class="snap-field">
                <div class="snap-label" id="snap-f-specialism-label">YOUR AVIATION SPECIALISM</div>
                <div class="snap-input" id="snap-f-specialism">e.g. CNS/ATM, airport ops, MRO</div>
              </div>
              <div class="snap-field">
                <div class="snap-label">A BUYER QUESTION YOU SHOULD WIN</div>
                <div class="snap-input" id="snap-f-question">e.g. Who are the leading CNS/ATM providers in Europe?</div>
              </div>
              <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="snap-submit">Get my AI Visibility Snapshot →</a>
            </div>
          </div>
          <!-- RIGHT: report card -->
          <a href="https://visibilityview.netlify.app/" target="_blank" rel="noopener noreferrer" class="sample-card" aria-label="Open the AI Visibility Snapshot tool">
            <div class="sample-card-header">
              <div class="sample-card-meta">
                <span class="sample-card-tag"><span class="sample-live-dot"></span>Sample Report</span>
                <span class="sample-card-sector" id="snap-sector">COMMERCIAL AVIATION</span>
              </div>
              <span class="sample-card-arrow" aria-hidden="true">→</span>
            </div>
            <div class="sample-card-body">
              <p class="sample-client" id="snap-client">PAN-EUROPEAN ANSP · Q2 2026</p>
              <p class="sample-title" id="snap-title">Citation share at <span class="num">22%</span>.<br/>3 fixes to reach 48% by Q4.</p>
              <div class="sample-stats" id="snap-stats">
                <div class="sample-stat"><div class="sample-stat-num">19<span class="up">↑38%</span></div><div class="sample-stat-label">AI Citations</div></div>
                <div class="sample-stat"><div class="sample-stat-num">2/5</div><div class="sample-stat-label">Engines Citing</div></div>
                <div class="sample-stat"><div class="sample-stat-num">4/12</div><div class="sample-stat-label">Topics Owned</div></div>
              </div>
              <div class="sample-fixes-header">
                <span class="sample-fixes-label">Top 3 Priority Fixes</span>
                <span class="sample-priority">RANKED BY IMPACT</span>
              </div>
              <div id="snap-fixes">
                <div class="sample-fix"><div class="sample-fix-num">1</div><div class="sample-fix-content"><div class="sample-fix-title">CNS/ATM capability comparison page</div><div class="sample-fix-impact">Estimated citation lift: <span class="lift">+19%</span> · 2 weeks</div></div></div>
                <div class="sample-fix"><div class="sample-fix-num">2</div><div class="sample-fix-content"><div class="sample-fix-title">SESAR &amp; ICAO entity schema build</div><div class="sample-fix-impact">Estimated citation lift: <span class="lift">+13%</span> · 1 week</div></div></div>
                <div class="sample-fix"><div class="sample-fix-num">3</div><div class="sample-fix-content"><div class="sample-fix-title">ANSP case study FAQ pages (×6)</div><div class="sample-fix-impact">Estimated citation lift: <span class="lift">+9%</span> · 3 days</div></div></div>
              </div>
              <div class="sample-card-cta">
                <span class="sample-cta-text">View full report →</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  (function() {
    var SNAPS = {
      commercial: {
        sectorLabel: 'COMMERCIAL AVIATION',
        specialismLabel: 'YOUR AVIATION SPECIALISM',
        specialism: 'e.g. CNS/ATM, airport ops, MRO',
        question: 'e.g. Who are the leading CNS/ATM providers in Europe?',
        client: 'PAN-EUROPEAN ANSP · Q2 2026',
        title: 'Citation share at <span class="num">22%</span>.<br/>3 fixes to reach 48% by Q4.',
        stats: [
          { num: '19<span class="up">↑38%</span>', label: 'AI Citations' },
          { num: '2/5', label: 'Engines Citing' },
          { num: '4/12', label: 'Topics Owned' }
        ],
        fixes: [
          { title: 'CNS/ATM capability comparison page', impact: '+19% · 2 weeks' },
          { title: 'SESAR &amp; ICAO entity schema build', impact: '+13% · 1 week' },
          { title: 'ANSP case study FAQ pages (×6)', impact: '+9% · 3 days' }
        ]
      },
      manufacturing: {
        sectorLabel: 'AEROSPACE MANUFACTURING',
        specialismLabel: 'YOUR MANUFACTURING SPECIALISM',
        specialism: 'e.g. aerostructures, avionics, composites',
        question: 'e.g. Which European firms lead in composite airframe manufacturing?',
        client: 'TIER-1 AEROSTRUCTURES OEM · Q1 2026',
        title: 'Citation share at <span class="num">17%</span>.<br/>4 fixes to reach 41% by Q3.',
        stats: [
          { num: '14<span class="up">↑29%</span>', label: 'AI Citations' },
          { num: '2/5', label: 'Engines Citing' },
          { num: '3/11', label: 'Topics Owned' }
        ],
        fixes: [
          { title: 'Composite materials capability hub', impact: '+16% · 3 weeks' },
          { title: 'OEM supply chain FAQ schema', impact: '+11% · 1 week' },
          { title: 'Certification timeline comparison page', impact: '+8% · 2 weeks' }
        ]
      },
      space: {
        sectorLabel: 'SPACE EXPLORATION',
        specialismLabel: 'YOUR SPACE SPECIALISM',
        specialism: 'e.g. satellite integration, launch services, propulsion',
        question: 'e.g. Who are the top smallsat integrators for LEO missions?',
        client: 'EU SMALLSAT INTEGRATOR · Q2 2026',
        title: 'Citation share at <span class="num">11%</span>.<br/>5 fixes to reach 34% by Q4.',
        stats: [
          { num: '9<span class="up">↑44%</span>', label: 'AI Citations' },
          { num: '1/5', label: 'Engines Citing' },
          { num: '2/10', label: 'Topics Owned' }
        ],
        fixes: [
          { title: 'LEO constellation deployment explainer', impact: '+14% · 2 weeks' },
          { title: 'Propulsion systems comparison hub', impact: '+10% · 1 week' },
          { title: 'Mission assurance FAQ pages (×4)', impact: '+7% · 3 days' }
        ]
      },
      mro: {
        sectorLabel: 'MRO',
        specialismLabel: 'YOUR MRO SPECIALISM',
        specialism: 'e.g. line maintenance, heavy checks, avionics repair',
        question: 'e.g. Which MRO providers specialise in A320 heavy checks?',
        client: 'INDEPENDENT MRO PROVIDER · Q1 2026',
        title: 'Citation share at <span class="num">14%</span>.<br/>3 fixes to reach 38% by Q3.',
        stats: [
          { num: '12<span class="up">↑33%</span>', label: 'AI Citations' },
          { num: '2/5', label: 'Engines Citing' },
          { num: '3/9', label: 'Topics Owned' }
        ],
        fixes: [
          { title: 'Heavy check capability comparison page', impact: '+15% · 2 weeks' },
          { title: 'Airworthiness standards FAQ schema', impact: '+10% · 1 week' },
          { title: 'Turn-time benchmark case studies (×3)', impact: '+7% · 2 weeks' }
        ]
      }
    };

    function renderSnap(key) {
      var d = SNAPS[key];
      // form card
      document.getElementById('snap-form-sector').textContent = d.sectorLabel;
      document.getElementById('snap-f-specialism-label').textContent = d.specialismLabel;
      document.getElementById('snap-f-specialism').textContent = d.specialism;
      document.getElementById('snap-f-question').textContent = d.question;
      // report card
      document.getElementById('snap-sector').textContent = d.sectorLabel;
      document.getElementById('snap-client').textContent = d.client;
      document.getElementById('snap-title').innerHTML = d.title;
      var statsEl = document.getElementById('snap-stats');
      statsEl.innerHTML = d.stats.map(function(s) {
        return '<div class="sample-stat"><div class="sample-stat-num">' + s.num + '</div><div class="sample-stat-label">' + s.label + '</div></div>';
      }).join('');
      var fixesEl = document.getElementById('snap-fixes');
      fixesEl.innerHTML = d.fixes.map(function(f, i) {
        return '<div class="sample-fix"><div class="sample-fix-num">' + (i+1) + '</div><div class="sample-fix-content"><div class="sample-fix-title">' + f.title + '</div><div class="sample-fix-impact">Estimated citation lift: <span class="lift">+' + f.impact.split(' · ')[0].replace('+','') + '</span> · ' + f.impact.split(' · ')[1] + '</div></div></div>';
      }).join('');
    }

    document.querySelectorAll('.sample-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.sample-tab').forEach(function(b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        renderSnap(btn.dataset.snap);
      });
    });

    renderSnap('commercial');
  })();
  </script>

<!-- ══════════════════════════════════════════
       SECTION 4 — PROBLEM FRAME
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="problem-heading">
    <p class="s-eyebrow">THE SHIFT</p>
    <h2 id="problem-heading" class="section-h2" style="max-width:500px;">
      Most expert content is invisible to AI — at the exact moment buyers are asking
      better questions.
    </h2>
    <div class="problem-grid">
      <article class="problem-card">
        <p class="pc-num">01</p>
        <h3 class="pc-title">Buyers ask AI first</h3>
        <p class="pc-body">
          67% of B2B buyers prefer a rep-free experience. ChatGPT is the new
          shortlist builder.
        </p>
      </article>
      <article class="problem-card">
        <p class="pc-num">02</p>
        <h3 class="pc-title">AI cites structure</h3>
        <p class="pc-body">
          Retrieval rewards entity-rich, answer-formatted content. Most expert
          content is none of these.
        </p>
      </article>
      <article class="problem-card">
        <p class="pc-num">03</p>
        <h3 class="pc-title">Absence costs trust</h3>
        <p class="pc-body">
          Every uncited answer is a competitor's earned trust moment. Every
          generic citation is yours, lost.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 5 — SEO VS AEO
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="compare-heading">
    <p class="s-eyebrow">CATEGORY</p>
    <h2 id="compare-heading" class="section-h2">SEO got you ranked. AEO gets you cited.</h2>
    <div class="compare">
      <div class="compare-col compare-col--seo">
        <p class="cc-label">SEO</p>
        <ul class="cc-lines" role="list">
          <li class="cc-line">Ranks your page</li>
          <li class="cc-line">Targets keywords</li>
          <li class="cc-line">Optimises for clicks</li>
          <li class="cc-line">Lives on Google</li>
          <li class="cc-line cc-line--last">Output: traffic</li>
        </ul>
      </div>
      <div class="compare-col compare-col--aeo">
        <p class="cc-label">AEO</p>
        <ul class="cc-lines" role="list">
          <li class="cc-line">Cites your answer</li>
          <li class="cc-line">Targets buyer questions</li>
          <li class="cc-line">Optimises for retrieval</li>
          <li class="cc-line">Lives across 5 AI engines</li>
          <li class="cc-line cc-line--last">Output: authority</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 6 — OFFER LADDER
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="offers-heading">
    <p class="s-eyebrow">THE OFFER LADDER</p>
    <h2 id="offers-heading" class="section-h2">Three ways to work with Maxifi.</h2>
    <div class="offers">

      <article class="offer">
        <p class="offer-tag">START HERE</p>
        <h3 class="offer-name">Snapshot</h3>
        <p class="offer-price">Free · 1 page</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>3 highest-leverage fixes</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Where AI cites you today</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Top competitors named</li>
        </ul>
        <a href="/visibility-snapshot" class="offer-cta offer-cta--outline">Get my Snapshot</a>
      </article>

      <article class="offer offer--featured">
        <p class="offer-tag">MOST POPULAR</p>
        <h3 class="offer-name">Sprint</h3>
        <p class="offer-price">From £X · 30 days</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Answer-ready assets shipped</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Schema + Q&amp;A layer built</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Citation lift in 30 days</li>
        </ul>
        <a href="/conference-aeo" class="offer-cta offer-cta--primary">Scope my Sprint</a>
      </article>

      <article class="offer">
        <p class="offer-tag">RECURRING</p>
        <h3 class="offer-name">Engine</h3>
        <p class="offer-price">From £Y / mo</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Quarterly Snapshots</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Content shipped quarterly</li>
        </ul>
        <a href="/visibility-engine" class="offer-cta offer-cta--outline">See the Engine</a>
      </article>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 7 — FEATURED CASE STUDY
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="case-heading">
    <p class="s-eyebrow">FEATURED CASE</p>
    <h2 id="case-heading" class="section-h2">
      How one industry event became an AI-searchable authority system.
    </h2>
    <div class="case">
      <div class="case-text">
        <p class="case-eyebrow">CANSO · AIRSPACE WORLD 2026</p>
        <h3 class="case-title">From PDF graveyard to citation engine.</h3>
        <p class="case-body">
          We turned a 3-day aviation conference into a structured AI Knowledge Hub.
          Sessions, speakers and themes became answer-ready assets that keep earning
          citations long after the room empties.
        </p>
        <dl class="case-metrics">
          <div class="case-metric">
            <dd class="case-num">47</dd>
            <dt class="case-lbl">Q&amp;A pairs</dt>
          </div>
          <div class="case-metric">
            <dd class="case-num">92%</dd>
            <dt class="case-lbl">Schema coverage</dt>
          </div>
          <div class="case-metric">
            <dd class="case-num">3×</dd>
            <dt class="case-lbl">Citation growth</dt>
          </div>
        </dl>
      </div>
      <div class="case-visual" aria-hidden="true">
        <div class="case-preview">
          <div class="cp-line"></div>
          <div class="cp-line cp-line--short"></div>
          <div class="cp-line cp-line--amber"></div>
          <p class="cp-num">78<span class="cp-denom"> / 100</span></p>
          <p class="cp-lbl">AEO VISIBILITY SCORE</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 8 — NEWSLETTER
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="nl-heading">
    <div class="newsletter">
      <div class="nl-grid">
        <div class="nl-text">
          <p class="s-eyebrow nl-eyebrow">NEWSLETTER · WEEKLY</p>
          <h2 id="nl-heading" class="nl-title">The Cited Brief</h2>
          <p class="nl-body">
            One Friday email. One buyer question AI is getting wrong, one move to fix
            it, one example from the field. 4-minute read.
          </p>
        </div>
        <div id="nl-form-wrap">
          <form
            name="cited-brief"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            id="cited-brief-form"
            class="nl-form"
          >
            <input type="hidden" name="form-name" value="cited-brief" />
            <p class="honeypot" aria-hidden="true">
              <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <label class="sr-only" for="nl-email">Email address</label>
            <input
              class="nl-input"
              type="email"
              id="nl-email"
              name="email"
              placeholder="your@work-email.com"
              required
            />
            <label class="sr-only" for="nl-role">Your role</label>
            <input
              class="nl-input"
              type="text"
              id="nl-role"
              name="role"
              placeholder="Role: Head of Marketing"
            />
            <button type="submit" class="nl-btn">Subscribe</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 8b — STATS TRUST STRIP
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="stats-heading">
    <p class="s-eyebrow">THE AEO SHIFT, IN NUMBERS</p>
    <h2 id="stats-heading" class="section-h2">Why this matters now.</h2>
    <div class="stats-strip">
      <article class="stat-card">
        <p class="stat-num">25%</p>
        <p class="stat-label">decline in traditional search engine volume by 2026.</p>
        <p class="stat-source">Gartner · Predicts 2024: How GenAI Will Reshape Marketing</p>
      </article>
      <article class="stat-card">
        <p class="stat-num">~60%</p>
        <p class="stat-label">of Google searches now end without a click — the zero-click trend feeding AI answers.</p>
        <p class="stat-source">SparkToro · 2024 analysis of Similarweb clickstream data</p>
      </article>
      <article class="stat-card">
        <p class="stat-num">1,300%</p>
        <p class="stat-label">YoY growth in AI-driven referral traffic to retail sites (Cyber Monday 2024 vs 2023).</p>
        <p class="stat-source">Adobe Analytics · December 2024</p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 9 — FINAL CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="final-heading">
    <div class="final">
      <h2 id="final-heading" class="final-title">
        Find out what AI says about your business — in 5 minutes.
      </h2>
      <div class="final-ctas">
        <a href="/visibility-snapshot" class="btn-primary">Run my Scorecard</a>
        <a href="/visibility-snapshot" class="btn-ghost">Book a Snapshot</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Did you know — random stat on load
  (function() {
    const stats = [
      {
        value: 'Traditional search engine volume will decline 25% by 2026.',
        source: 'Gartner · Predicts 2024'
      },
      {
        value: 'About 60% of Google searches now end without a click.',
        source: 'SparkToro · 2024'
      },
      {
        value: 'AI-driven referral traffic grew 1,300% year-over-year.',
        source: 'Adobe Analytics · Cyber Monday 2024 vs 2023'
      },
      {
        value: "AI search traffic converts at 14.2% vs Google's 2.8% - roughly 5x more valuable per visit.",
        source: 'Semrush / BrightEdge'
      }
    ];
    const randomStat = stats[Math.floor(Math.random() * stats.length)];
    const valueEl = document.getElementById('dyk-value');
    const sourceEl = document.getElementById('dyk-source');
    if (valueEl) valueEl.textContent = randomStat.value;
    if (sourceEl) sourceEl.textContent = randomStat.source;
  })();

  function bindForm(formId, wrapId, thanks) {
    const form = document.getElementById(formId);
    const wrap = document.getElementById(wrapId);
    if (!form || !wrap) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
