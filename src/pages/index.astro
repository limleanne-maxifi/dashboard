  }
  .vs-sample__panel {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 36px;
    align-items: stretch;
  }
  .vs-sample__lbl {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.14em;
