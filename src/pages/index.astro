---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<BaseLayout
  title="Maxifi Digital | AI Visibility for Expert-Led Brands"
  description="Maxifi Digital helps expert-led brands become the answer AI cites. Free AI Visibility Snapshot across ChatGPT, Claude, Gemini, Perplexity and Copilot."
  currentPage="/"
>

  <!-- ═══════════════════════════════════════════════
       SECTION 1 — HERO
  ═══════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">

      <div class="hero-text">
        <Eyebrow text="AI VISIBILITY · EXPERT-LED BRANDS" />
        <h1 id="hero-heading" class="hero-h1">
          Be the answer<br /><em>AI cites.</em>
        </h1>
        <p class="hero-lede">
          Your buyers are no longer only searching Google. They are asking
          ChatGPT, Claude, Copilot, Gemini and Perplexity who to trust. We turn
          your expertise into structured authority assets that AI engines find,
          understand and cite.
        </p>
        <div class="hero-ctas">
          <Button href="/visibility-snapshot">Check My AI Visibility →</Button>
          <Button href="https://aswhub.maxifidigital.com/" variant="ghost" external>
            See a Live Example →
          </Button>
        </div>
      </div>

      <div class="scorecard-wrap" id="snapshot">
        <div class="scorecard-card">
          <div class="sc-status">
            <span class="pulse-dot" aria-hidden="true"></span>
            Free · 5 minutes · No call required
          </div>
          <p class="sc-title">AI Visibility Snapshot</p>
          <div id="snapshot-form-wrap">
            <form
              name="visibility-snapshot"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              id="snapshot-form"
            >
              <input type="hidden" name="form-name" value="visibility-snapshot" />
              <input type="hidden" name="source-page" value="homepage" />
              <input type="hidden" name="utm_source" value="" />
              <input type="hidden" name="utm_campaign" value="" />
              <p class="honeypot" aria-hidden="true">
                <label>Skip this: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <div class="sc-field">
                <label class="sc-label" for="sc-website">Your website</label>
                <input
                  class="sc-input"
                  type="text"
                  id="sc-website"
                  name="website"
                  placeholder="acmeconsulting.com"
                  required
                />
              </div>
              <div class="sc-field">
                <label class="sc-label" for="sc-category">Your category</label>
                <input
                  class="sc-input"
                  type="text"
                  id="sc-category"
                  name="category"
                  placeholder="Management consulting"
                  required
                />
              </div>
              <div class="sc-field">
                <label class="sc-label" for="sc-question">A question your buyer would ask AI</label>
                <input
                  class="sc-input"
                  type="text"
                  id="sc-question"
                  name="buyer-question"
                  placeholder="Best firm for healthcare M&A"
                  required
                />
              </div>
              <div class="sc-field">
                <label class="sc-label" for="sc-email">Your email</label>
                <input
                  class="sc-input"
                  type="email"
                  id="sc-email"
                  name="email"
                  placeholder="you@company.com"
                  required
                />
              </div>
              <button type="submit" class="sc-submit">Check My AI Visibility →</button>
            </form>
          </div>
          <p class="sc-foot">
            Live across ChatGPT, Claude, Copilot, Gemini, Perplexity. Results in your inbox.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2 — TRUST STRIP
  ═══════════════════════════════════════════════ -->
  <div class="trust" role="region" aria-label="Impact metrics">
    <div class="wrap trust-inner">
      <span class="trust-label">Measured impact</span>
      <ul class="trust-metrics" role="list">
        {[
          '47 Q&A pairs indexed',
          '92% schema coverage',
          '3× citation growth',
          '5 AI engines monitored',
          '4,200 subscribers',
        ].map((metric) => (
          <li class="metric-pill">{metric}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       SECTION 3 — PROBLEM FRAME
  ═══════════════════════════════════════════════ -->
  <section class="sec" aria-labelledby="problem-heading">
    <div class="wrap">
      <Eyebrow text="THE SHIFT" />
      <h2 id="problem-heading" class="sec-h2">
        Most expert content is <em>invisible to AI</em> — at the exact moment
        buyers are asking better questions.
      </h2>
      <div class="problem-grid">
        <article class="p-card">
          <span class="p-num">01</span>
          <h3 class="p-title">Buyers ask AI first</h3>
          <p class="p-body">
            67% of B2B buyers prefer a rep-free experience (Gartner, 2026).
            ChatGPT is the new shortlist builder.
          </p>
        </article>
        <article class="p-card">
          <span class="p-num">02</span>
          <h3 class="p-title">AI cites structure, not depth</h3>
          <p class="p-body">
            Retrieval rewards entity-rich, answer-formatted, schema-tagged
            content. Most expert content is none of these.
          </p>
        </article>
        <article class="p-card">
          <span class="p-num">03</span>
          <h3 class="p-title">Absence costs trust</h3>
          <p class="p-body">
            Every uncited answer is a competitor's earned trust moment. Every
            generic citation is yours, lost.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 4 — SEO VS AEO
  ═══════════════════════════════════════════════ -->
  <section class="sec sec--cream" aria-labelledby="compare-heading">
    <div class="wrap">
      <Eyebrow text="CATEGORY" />
      <h2 id="compare-heading" class="sec-h2">
        SEO got you ranked. <em>AEO gets you cited.</em>
      </h2>
      <div class="compare">
        <div class="cmp cmp--seo">
          <p class="cmp-label">SEO</p>
          <ul class="cmp-list" role="list">
            <li>Ranks your page</li>
            <li>Targets keywords</li>
            <li>Optimises for clicks</li>
            <li>Lives on Google</li>
            <li>Output: traffic</li>
          </ul>
        </div>
        <div class="cmp cmp--aeo">
          <p class="cmp-label">AEO</p>
          <ul class="cmp-list" role="list">
            <li>Cites your answer</li>
            <li>Targets buyer questions</li>
            <li>Optimises for retrieval</li>
            <li>Lives across 5 AI engines</li>
            <li>Output: authority</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 5 — OFFER LADDER
  ═══════════════════════════════════════════════ -->
  <section class="sec" aria-labelledby="offers-heading">
    <div class="wrap">
      <Eyebrow text="THE OFFER LADDER" />
      <h2 id="offers-heading" class="sec-h2">
        Three ways <em>to work with Maxifi.</em>
      </h2>
      <div class="offers">

        <article class="offer">
          <span class="offer-tag">Start here</span>
          <h3 class="offer-name">Snapshot</h3>
          <p class="offer-price">Free · 1-page report</p>
          <ul class="offer-features" role="list">
            <li><span class="check" aria-hidden="true">✓</span>The 3 highest-leverage fixes</li>
            <li><span class="check" aria-hidden="true">✓</span>Where AI cites you today</li>
            <li><span class="check" aria-hidden="true">✓</span>Top competitors named</li>
            <li><span class="check" aria-hidden="true">✓</span>5 buyer questions tested</li>
          </ul>
          <a href="/visibility-snapshot" class="offer-cta offer-cta--outline">Get my Snapshot</a>
        </article>

        <article class="offer offer--featured">
          <span class="offer-badge">Most popular</span>
          <span class="offer-tag">Done with you</span>
          <h3 class="offer-name">Sprint</h3>
          <p class="offer-price">From £X · 30 days</p>
          <ul class="offer-features" role="list">
            <li><span class="check" aria-hidden="true">✓</span>Answer-ready assets shipped</li>
            <li><span class="check" aria-hidden="true">✓</span>Schema + Q&amp;A layer built</li>
            <li><span class="check" aria-hidden="true">✓</span>Citation lift in 30 days</li>
            <li><span class="check" aria-hidden="true">✓</span>Senior strategist embedded</li>
          </ul>
          <a href="/conference-aeo" class="offer-cta offer-cta--primary">Scope my Sprint</a>
        </article>

        <article class="offer">
          <span class="offer-tag">Recurring</span>
          <h3 class="offer-name">Engine</h3>
          <p class="offer-price">From £Y / month</p>
          <ul class="offer-features" role="list">
            <li><span class="check" aria-hidden="true">✓</span>Quarterly Snapshot reports</li>
            <li><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring</li>
            <li><span class="check" aria-hidden="true">✓</span>Content shipped quarterly</li>
            <li><span class="check" aria-hidden="true">✓</span>Monthly strategy review</li>
          </ul>
          <a href="/visibility-engine" class="offer-cta offer-cta--outline">See the Engine</a>
        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 6 — FEATURED CASE STUDY
  ═══════════════════════════════════════════════ -->
  <section class="sec sec--cream" aria-labelledby="case-heading">
    <div class="wrap">
      <Eyebrow text="FEATURED CASE" />
      <h2 id="case-heading" class="sec-h2">
        How one industry event became an <em>AI-searchable authority system.</em>
      </h2>
      <div class="case">
        <div class="case-text">
          <div class="case-eyebrow">
            <span class="pulse-dot pulse-dot--amber" aria-hidden="true"></span>
            CANSO · Airspace World 2026
          </div>
          <h3 class="case-title">
            From PDF graveyard<br />to citation engine.
          </h3>
          <p class="case-body">
            We turned a 3-day aviation conference into a structured AI Knowledge
            Hub. Sessions, speakers and themes became answer-ready assets that
            keep earning citations long after the room empties.
          </p>
          <dl class="case-metrics">
            <div class="case-metric">
              <dd class="case-num">47</dd>
              <dt class="case-lbl">Q&amp;A pairs indexed</dt>
            </div>
            <div class="case-metric">
              <dd class="case-num">92%</dd>
              <dt class="case-lbl">Schema coverage</dt>
            </div>
            <div class="case-metric">
              <dd class="case-num">3×</dd>
              <dt class="case-lbl">Citation growth (90d)</dt>
            </div>
          </dl>
          <div class="case-ctas">
            <a
              href="https://aswhub.maxifidigital.com/"
              target="_blank"
              rel="noopener"
              class="case-cta case-cta--amber"
            >
              View the Live Hub →
            </a>
            <a href="/work/airspace-world-2026" class="case-cta case-cta--ghost">
              Read the case study
            </a>
          </div>
        </div>
        <div class="case-visual" aria-hidden="true">
          <div class="case-preview">
            <p class="cp-eyebrow">AEO Visibility Score</p>
            <div class="cp-bar"></div>
            <div class="cp-bar cp-bar--short"></div>
            <div class="cp-bar cp-bar--amber"></div>
            <p class="cp-score">78<span> / 100</span></p>
            <p class="cp-label">Above sector average</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 7 — CONFERENCE AEO TEASER
  ═══════════════════════════════════════════════ -->
  <section class="sec" aria-labelledby="conf-heading">
    <div class="wrap">
      <Eyebrow text="CONFERENCE AEO" />
      <h2 id="conf-heading" class="sec-h2">
        Your event spend shouldn't <em>disappear with the booth.</em>
      </h2>
      <div class="conf-grid">
        <div class="conf-text">
          <p class="conf-body">
            Most conference content dies 30 days after the closing keynote. PDFs
            go un-indexed. Recordings stay locked behind paywalls. Speaker
            insights vanish from AI memory.
          </p>
          <p class="conf-body">
            We turn conference presence into AI-searchable authority assets —
            speaker pages, session summaries, post-event insights — that keep
            working long after the lanyards come off.
          </p>
          <div class="conf-ctas">
            <Button href="/conference-aeo">Scope my Conference Sprint →</Button>
            <Button href="https://aswhub.maxifidigital.com/" variant="ghost-dark" external>
              See the Live Hub →
            </Button>
          </div>
        </div>
        <div class="conf-card">
          <div class="live-badge">
            <span class="pulse-dot pulse-dot--signal" aria-hidden="true"></span>
            Live now
          </div>
          <p class="conf-card-label">Featured</p>
          <h3 class="conf-card-title">
            Airspace World 2026<br />AI Knowledge Hub
          </h3>
          <p class="conf-card-body">
            Built for CANSO. 8 themed tracks. 47 indexed Q&amp;A pairs.
            3× citation growth in 90 days. Cited by ChatGPT and Perplexity for
            aviation queries.
          </p>
          <div class="engine-pills">
            <span class="engine-pill">ChatGPT</span>
            <span class="engine-pill">Perplexity</span>
            <span class="engine-pill">Claude</span>
            <span class="engine-pill">Gemini</span>
          </div>
          <a
            href="https://aswhub.maxifidigital.com/"
            target="_blank"
            rel="noopener"
            class="conf-card-link"
          >
            aswhub.maxifidigital.com →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 8 — NEWSLETTER
  ═══════════════════════════════════════════════ -->
  <section class="sec" aria-labelledby="nl-heading">
    <div class="wrap">
      <div class="newsletter">
        <div class="nl-grid">
          <div class="nl-text">
            <Eyebrow text="Newsletter · Fridays" />
            <h2 id="nl-heading" class="nl-title">The Cited Brief</h2>
            <p class="nl-body">
              One Friday email. One buyer question AI is getting wrong, one move
              to fix it, one example from the field. 4-minute read.
            </p>
          </div>
          <div id="nl-form-wrap">
            <form
              name="cited-brief"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              id="cited-brief-form"
              class="nl-form"
            >
              <input type="hidden" name="form-name" value="cited-brief" />
              <p class="honeypot" aria-hidden="true">
                <label>Skip this: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>
              <label class="sr-only" for="nl-email">Email address</label>
              <input
                class="nl-input"
                type="email"
                id="nl-email"
                name="email"
                placeholder="your@work-email.com"
                required
              />
              <label class="sr-only" for="nl-role">Your role (optional)</label>
              <input
                class="nl-input"
                type="text"
                id="nl-role"
                name="role"
                placeholder="Role (optional)"
              />
              <button type="submit" class="nl-submit">Subscribe →</button>
              <p class="nl-foot">No spam. No upsells. No recycled LinkedIn posts.</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 9 — FINAL CTA
  ═══════════════════════════════════════════════ -->
  <FinalCTA
    heading="When your buyers ask AI who to trust — <em>be the answer.</em>"
    primaryLabel="Check My AI Visibility →"
    secondaryLabel="See a Live Example →"
    secondaryHref="https://aswhub.maxifidigital.com/"
    secondaryExternal={true}
  />

</BaseLayout>

<script>
  function bindNetlifyForm(
    formId: string,
    wrapId: string,
    thanks: string,
  ) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const wrap = document.getElementById(wrapId);
    if (!form || !wrap) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const encoded = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encoded,
        });
        wrap.innerHTML = `<div class="form-thanks">${thanks}</div>`;
      } catch {
        form.submit();
      }
    });
  }

  bindNetlifyForm(
    'snapshot-form',
    'snapshot-form-wrap',
    "<p>Thanks — we'll check your AI visibility and send results to your inbox within one business day.</p>",
  );

  bindNetlifyForm(
    'cited-brief-form',
    'nl-form-wrap',
    "<p>You're subscribed to The Cited Brief. See you Friday.</p>",
  );
</script>

<style>
  /* ─── Shared ────────────────────────────────── */
  .sec {
    padding: 100px 0;
  }

  .sec--cream {
    background: var(--cream-deep);
  }

  .sec-h2 {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--navy);
    max-width: 780px;
    margin: 16px 0 48px;
  }

  .sec-h2 em {
    font-style: italic;
    color: var(--amber);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .pulse-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  .pulse-dot--amber  { background: var(--amber-mid); }
  .pulse-dot--signal { background: var(--signal); }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  .form-thanks {
    font-size: 15px;
    color: var(--navy);
    line-height: 1.6;
    padding: 16px 0;
  }

  /* ─── Hero ──────────────────────────────────── */
  .hero {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #fff;
    padding: 80px 0 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(239, 159, 39, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }

  .hero-h1 {
    font-family: 'Fraunces', serif;
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 24px 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--amber-mid);
  }

  .hero-lede {
    font-size: 18px;
    line-height: 1.55;
    color: #B5D4F4;
    margin-bottom: 36px;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ─── Scorecard card ────────────────────────── */
  .scorecard-wrap {
    scroll-margin-top: 80px;
  }

  .scorecard-card {
    background: #fff;
    color: var(--navy);
    border-radius: 14px;
    padding: 32px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.4);
  }

  .sc-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 12px;
  }

  .sc-title {
    font-family: 'Fraunces', serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    color: var(--navy);
  }

  .sc-field {
    margin-bottom: 14px;
  }

  .sc-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .sc-input {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid #E5E2D9;
    border-radius: 6px;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    background: var(--cream);
    color: var(--navy);
    transition: border-color 0.2s ease;
  }

  .sc-input:focus {
    outline: none;
    border-color: var(--amber);
  }

  .sc-submit {
    width: 100%;
    background: var(--amber);
    color: var(--amber-light);
    padding: 14px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    margin-top: 8px;
    transition: background 0.2s ease;
  }

  .sc-submit:hover {
    background: #854F0B;
  }

  .sc-foot {
    font-size: 11px;
    color: var(--muted);
    margin-top: 14px;
    line-height: 1.5;
    text-align: center;
  }

  /* ─── Trust strip ───────────────────────────── */
  .trust {
    padding: 40px 0;
    background: var(--cream-deep);
    border-bottom: 1px solid var(--line);
  }

  .trust-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .trust-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }

  .trust-metrics {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
  }

  .metric-pill {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--navy);
    white-space: nowrap;
  }

  /* ─── Problem cards ─────────────────────────── */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
