---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLoop from '../components/HeroLoop.astro';
---

<BaseLayout
  title="Maxifi Digital | AI Visibility for Expert-Led Brands"
  description="Maxifi Digital helps expert-led brands become the answer AI cites. Free AI Visibility Scorecard across ChatGPT, Claude, Gemini, Perplexity and Google AI."
  currentPage="/"
>

  <!-- ══════════════════════════════════════════
       SECTION 2 — HERO
  ══════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-row">

      <div class="hero-left">
        <p class="eyebrow">AI VISIBILITY · EXPERT-LED BRANDS</p>
        <h1 id="hero-heading" class="hero-h1">
          Your expertise may already be strong. The question is whether AI can find it.
        </h1>
        <p class="lede">
          When buyers ask ChatGPT, Perplexity or Google AI about your category, is your
          brand the answer — or someone else's? We build the visibility layer that makes
          expert-led brands the source AI cites.
        </p>
        <div class="hero-ctas">
          <a href="/visibility-snapshot" class="btn-primary">Get my Snapshot</a>
          <a href="https://aswhub.maxifidigital.com/" target="_blank" rel="noopener" class="btn-ghost">
            ASW case study
          </a>
        </div>
      </div>

      <HeroLoop />

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 3 — TRUST STRIP
  ══════════════════════════════════════════ -->
  <div class="trust" role="region" aria-label="Trusted by">
    <span class="trust-label">Trusted by</span>
    <ul class="trust-pills" role="list">
      {['CANSO', 'Aviation bodies', 'Law firms', 'Think tanks', 'Pro services'].map((name) => (
        <li class="logo-pill">{name}</li>
      ))}
    </ul>
  </div>

  <!-- ══════════════════════════════════════════
       SECTION 4 — PROBLEM FRAME
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="problem-heading">
    <p class="s-eyebrow">THE SHIFT</p>
    <h2 id="problem-heading" class="section-h2" style="max-width:500px;">
      Most expert content is invisible to AI — at the exact moment buyers are asking
      better questions.
    </h2>
    <div class="problem-grid">
      <article class="problem-card">
        <p class="pc-num">01</p>
        <h3 class="pc-title">Buyers ask AI first</h3>
        <p class="pc-body">
          67% of B2B buyers prefer a rep-free experience. ChatGPT is the new
          shortlist builder.
        </p>
      </article>
      <article class="problem-card">
        <p class="pc-num">02</p>
        <h3 class="pc-title">AI cites structure</h3>
        <p class="pc-body">
          Retrieval rewards entity-rich, answer-formatted content. Most expert
          content is none of these.
        </p>
      </article>
      <article class="problem-card">
        <p class="pc-num">03</p>
        <h3 class="pc-title">Absence costs trust</h3>
        <p class="pc-body">
          Every uncited answer is a competitor's earned trust moment. Every
          generic citation is yours, lost.
        </p>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 5 — SEO VS AEO
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="compare-heading">
    <p class="s-eyebrow">CATEGORY</p>
    <h2 id="compare-heading" class="section-h2">SEO got you ranked. AEO gets you cited.</h2>
    <div class="compare">
      <div class="compare-col compare-col--seo">
        <p class="cc-label">SEO</p>
        <ul class="cc-lines" role="list">
          <li class="cc-line">Ranks your page</li>
          <li class="cc-line">Targets keywords</li>
          <li class="cc-line">Optimises for clicks</li>
          <li class="cc-line">Lives on Google</li>
          <li class="cc-line cc-line--last">Output: traffic</li>
        </ul>
      </div>
      <div class="compare-col compare-col--aeo">
        <p class="cc-label">AEO</p>
        <ul class="cc-lines" role="list">
          <li class="cc-line">Cites your answer</li>
          <li class="cc-line">Targets buyer questions</li>
          <li class="cc-line">Optimises for retrieval</li>
          <li class="cc-line">Lives across 5 AI engines</li>
          <li class="cc-line cc-line--last">Output: authority</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 6 — OFFER LADDER
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="offers-heading">
    <p class="s-eyebrow">THE OFFER LADDER</p>
    <h2 id="offers-heading" class="section-h2">Three ways to work with Maxifi.</h2>
    <div class="offers">

      <article class="offer">
        <p class="offer-tag">START HERE</p>
        <h3 class="offer-name">Snapshot</h3>
        <p class="offer-price">Free · 1 page</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>3 highest-leverage fixes</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Where AI cites you today</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Top competitors named</li>
        </ul>
        <a href="/visibility-snapshot" class="offer-cta offer-cta--outline">Get my Snapshot</a>
      </article>

      <article class="offer offer--featured">
        <p class="offer-tag">MOST POPULAR</p>
        <h3 class="offer-name">Sprint</h3>
        <p class="offer-price">From £X · 30 days</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Answer-ready assets shipped</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Schema + Q&amp;A layer built</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Citation lift in 30 days</li>
        </ul>
        <a href="/conference-aeo" class="offer-cta offer-cta--primary">Scope my Sprint</a>
      </article>

      <article class="offer">
        <p class="offer-tag">RECURRING</p>
        <h3 class="offer-name">Engine</h3>
        <p class="offer-price">From £Y / mo</p>
        <ul class="offer-lines" role="list">
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Quarterly Snapshots</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Weekly citation monitoring</li>
          <li class="offer-line"><span class="check" aria-hidden="true">✓</span>Content shipped quarterly</li>
        </ul>
        <a href="/visibility-engine" class="offer-cta offer-cta--outline">See the Engine</a>
      </article>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 7 — FEATURED CASE STUDY
  ══════════════════════════════════════════ -->
  <section class="section section--cream" aria-labelledby="case-heading">
    <p class="s-eyebrow">FEATURED CASE</p>
    <h2 id="case-heading" class="section-h2">
      How one industry event became an AI-searchable authority system.
    </h2>
    <div class="case">
      <div class="case-text">
        <p class="case-eyebrow">CANSO · AIRSPACE WORLD 2026</p>
        <h3 class="case-title">From PDF graveyard to citation engine.</h3>
        <p class="case-body">
          We turned a 3-day aviation conference into a structured AI Knowledge Hub.
          Sessions, speakers and themes became answer-ready assets that keep earning
          citations long after the room empties.
        </p>
        <dl class="case-metrics">
          <div class="case-metric">
            <dd class="case-num">47</dd>
            <dt class="case-lbl">Q&amp;A pairs</dt>
          </div>
          <div class="case-metric">
            <dd class="case-num">92%</dd>
            <dt class="case-lbl">Schema coverage</dt>
          </div>
          <div class="case-metric">
            <dd class="case-num">3×</dd>
            <dt class="case-lbl">Citation growth</dt>
          </div>
        </dl>
      </div>
      <div class="case-visual" aria-hidden="true">
        <div class="case-preview">
          <div class="cp-line"></div>
          <div class="cp-line cp-line--short"></div>
          <div class="cp-line cp-line--amber"></div>
          <p class="cp-num">78<span class="cp-denom"> / 100</span></p>
          <p class="cp-lbl">AEO VISIBILITY SCORE</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 8 — NEWSLETTER
  ══════════════════════════════════════════ -->
  <section class="section" aria-labelledby="nl-heading">
    <div class="newsletter">
      <div class="nl-grid">
        <div class="nl-text">
          <p class="s-eyebrow nl-eyebrow">NEWSLETTER · WEEKLY</p>
          <h2 id="nl-heading" class="nl-title">The Cited Brief</h2>
          <p class="nl-body">
            One Friday email. One buyer question AI is getting wrong, one move to fix
            it, one example from the field. 4-minute read.
          </p>
        </div>
        <div id="nl-form-wrap">
          <form
            name="cited-brief"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            id="cited-brief-form"
            class="nl-form"
          >
            <input type="hidden" name="form-name" value="cited-brief" />
            <p class="honeypot" aria-hidden="true">
              <label>Skip: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <label class="sr-only" for="nl-email">Email address</label>
            <input
              class="nl-input"
              type="email"
              id="nl-email"
              name="email"
              placeholder="your@work-email.com"
              required
            />
            <label class="sr-only" for="nl-role">Your role</label>
            <input
              class="nl-input"
              type="text"
              id="nl-role"
              name="role"
              placeholder="Role: Head of Marketing"
            />
            <button type="submit" class="nl-btn">Subscribe</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SECTION 9 — FINAL CTA
  ══════════════════════════════════════════ -->
  <section class="section section--pt0" aria-labelledby="final-heading">
    <div class="final">
      <h2 id="final-heading" class="final-title">
        Find out what AI says about your business — in 5 minutes.
      </h2>
      <div class="final-ctas">
        <a href="/visibility-snapshot" class="btn-primary">Run my Scorecard</a>
        <a href="/visibility-snapshot" class="btn-ghost">Book a Snapshot</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  function bindForm(formId: string, wrapId: string, thanks: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const wrap = document.getElementById(wrapId);
    if (!form || !wrap) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(
        Array.from(new FormData(form)).map(([k, v]) => [k, v.toString()]),
      ).toString();
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        wrap.innerHTML = `<p class="form-thanks">${thanks}</p>`;
      } catch {
        form.submit();
      }
    });
  }

  bindForm(
    'cited-brief-form',
    'nl-form-wrap',
    "You're subscribed. See you Friday.",
  );
</script>

<style>
  /* ── Shared utilities ───────────────────────── */
  .honeypot { position: absolute; left: -9999px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .form-thanks {
    font-size: 12px;
    color: var(--navy);
    line-height: 1.5;
    padding: 10px 0;
  }

  .eyebrow,
  .s-eyebrow {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: #EF9F27;
    font-weight: 500;
    margin-bottom: 10px;
  }

  .section-h2 {
    font-size: 19px;
    font-weight: 600;
    color: var(--navy);
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .section {
    padding: 30px 22px;
    background: var(--cream);
  }

  .section--cream { background: var(--cream-deep); }

  .section--pt0 { padding-top: 0; }

  /* ── Buttons ────────────────────────────────── */
  .btn-primary {
    background: var(--amber);
    color: var(--amber-light);
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s ease;
  }

  .btn-primary:hover { background: #854F0B; }

  .btn-ghost {
    background: transparent;
    color: #E6F1FB;
    padding: 10px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
    border: 0.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s ease;
  }

  .btn-ghost:hover { border-color: rgba(255, 255, 255, 0.6); }

  /* ── Hero ───────────────────────────────────── */
  .hero {
    background: linear-gradient(180deg, #042C53 0%, #031F3D 100%);
    color: #E6F1FB;
    padding: 30px 22px 32px;
  }

  .hero-row {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 18px;
    align-items: start;
  }

  .hero-h1 {
    font-size: 28px;
    line-height: 1.18;
    font-weight: 600;
    color: #fff;
    margin: 0 0 12px;
    max-width: 420px;
    font-family: 'Inter', sans-serif;
  }

  .lede {
    font-size: 12px;
    line-height: 1.55;
    color: #B5D4F4;
    margin-bottom: 18px;
  }

  .hero-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ── Trust strip ────────────────────────────── */
  .trust {
    padding: 14px 22px;
    background: var(--cream-deep);
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    font-size: 10px;
    color: #5F5E5A;
    flex-wrap: wrap;
  }

  .trust-label { opacity: 0.7; }

  .trust-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    justify-content: center;
  }

  .logo-pill {
    background: #fff;
    padding: 5px 10px;
    border-radius: 3px;
    font-weight: 500;
    color: var(--navy);
    font-size: 10px;
  }

  /* ── Problem cards ──────────────────────────── */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .problem-card {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 14px;
  }

  .pc-num {
    font-size: 10px;
    color: #BA7517;
    font-weight: 500;
    margin-bottom: 6px;
    letter-spacing: 0.08em;
  }

  .pc-title {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--navy);
    font-family: 'Inter', sans-serif;
  }

  .pc-body {
    font-size: 11px;
    line-height: 1.5;
    color: #5F5E5A;
  }

  /* ── SEO vs AEO ─────────────────────────────── */
  .compare {
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .compare-col { padding: 18px; }

  .compare-col--seo { background: #042C53; }
  .compare-col--aeo { background: #BA7517; }

  .cc-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 14px;
  }

  .compare-col--seo .cc-label { color: #85B7EB; }
  .compare-col--aeo .cc-label { color: #412402; }

  .cc-lines { list-style: none; }

  .cc-line {
    font-size: 12px;
    padding: 7px 0;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.12);
    line-height: 1.3;
  }

  .cc-line--last { border: none; }

  .compare-col--seo .cc-line { color: #E6F1FB; }

  .compare-col--aeo .cc-line {
    color: #412402;
    border-bottom-color: rgba(0, 0, 0, 0.14);
  }

  /* ── Offer ladder ───────────────────────────── */
  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .offer {
    background: #fff;
    border: 0.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .offer--featured { border: 2px solid #BA7517; }

  .offer-tag {
    font-size: 9px;
    font-weight: 500;
    color: #BA7517;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .offer-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 3px;
    font-family: 'Inter', sans-serif;
  }

  .offer-price {
    font-size: 10px;
    color: #5F5E5A;
    margin-bottom: 12px;
  }

  .offer-lines { list-style: none; flex: 1; }

  .offer-line {
    font-size: 11px;
    color: #444441;
    padding: 3px 0;
    line-height: 1.4;
    display: flex;
    gap: 4px;
  }

  .check {
    color: #1D9E75;
    font-weight: 500;
    flex-shrink: 0;
  }

  .offer-cta {
    display: block;
    text-align: center;
    margin-top: 12px;
    padding: 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .offer-cta--primary {
    background: #BA7517;
    color: #FAEEDA;
  }

  .offer-cta--primary:hover { background: #854F0B; }

  .offer-cta--outline {
    border: 0.5px solid rgba(4, 44, 83, 0.22);
    color: #042C53;
  }

  .offer-cta--outline:hover {
    background: #042C53;
    color: #fff;
  }

  /* ── Case study ─────────────────────────────── */
  .case {
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    background: #042C53;
  }

  .case-text {
    padding: 22px;
    color: #E6F1FB;
  }

  .case-eyebrow {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: #EF9F27;
    margin-bottom: 8px;
    font-weight: 500;
  }

  .case-title {
    font-size: 17px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 10px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .case-body {
    font-size: 11px;
    line-height: 1.55;
    color: #B5D4F4;
    margin-bottom: 14px;
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .case-metric { display: flex; flex-direction: column; }

  .case-num {
    font-size: 18px;
    font-weight: 500;
    color: #FAC775;
    line-height: 1.1;
  }

  .case-lbl {
    font-size: 9px;
    color: #B5D4F4;
    margin-top: 2px;
  }

  .case-visual {
    background: #0C447C;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-preview {
    background: #fff;
    padding: 14px;
    border-radius: 6px;
    width: 100%;
  }

  .cp-line {
    height: 4px;
    background: #D3D1C7;
    border-radius: 2px;
    margin-bottom: 5px;
    width: 100%;
  }

  .cp-line--short { width: 50%; }
  .cp-line--amber { background: #FAC775; width: 75%; }

  .cp-num {
    font-size: 22px;
    font-weight: 500;
    color: #042C53;
    margin: 10px 0 2px;
  }

  .cp-denom {
    font-size: 11px;
    color: #888;
    font-weight: 400;
  }

  .cp-lbl {
    font-size: 9px;
    color: #5F5E5A;
    letter-spacing: 0.05em;
  }

  /* ── Newsletter ─────────────────────────────── */
  .newsletter {
    background: #FAEEDA;
    padding: 24px;
    border-radius: 8px;
  }

  .nl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: center;
  }

  .nl-eyebrow { color: #BA7517; }

  .nl-title {
    font-size: 17px;
    font-weight: 600;
    color: #412402;
    margin-bottom: 6px;
    font-family: 'Inter', sans-serif;
  }

  .nl-body {
    font-size: 11px;
    line-height: 1.55;
    color: #633806;
  }

  .nl-form {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .nl-input {
    background: #fff;
    border: 0.5px solid rgba(65, 36, 2, 0.2);
    padding: 8px 10px;
    border-radius: 4px;
    font-size: 11px;
    color: #412402;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.2s ease;
  }

  .nl-input:focus {
    outline: none;
    border-color: #BA7517;
  }

  .nl-btn {
    background: #042C53;
    color: #E6F1FB;
    border: none;
    padding: 9px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background 0.2s ease;
  }

  .nl-btn:hover { background: #031F3D; }

  /* ── Final CTA ──────────────────────────────── */
  .final {
    background: #042C53;
    padding: 34px 22px;
    text-align: center;
    color: #E6F1FB;
    border-radius: 8px;
  }

  .final-title {
    font-size: 21px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 18px;
    line-height: 1.25;
    font-family: 'Inter', sans-serif;
  }

  .final-ctas {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

